<Window x:Class="Cantio.Views.ProjectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Cantio.Views"
        Title="Cantio — Projekcja"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{Binding BackgroundBrush}"
        AllowsTransparency="False">
    <WindowChrome.WindowChrome>
        <WindowChrome ResizeBorderThickness="0"
                      CaptionHeight="0"
                      GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <local:ProjectionView DataContext="{Binding}"/>

        <!-- Ekran parowania (tryb serwerowy, dopóki nikt nie jest sparowany).
             Warstwa WEWNĄTRZ okna projekcji — osobne okno biłoby się o Topmost. -->
        <Grid Background="#0f1117"
              Visibility="{Binding ShowPairing, Converter={StaticResource BoolToVis}}">
            <Viewbox Stretch="Uniform" Margin="60" MaxWidth="1400">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                    <!-- Kod QR -->
                    <Border Background="#0f1117" BorderBrush="#c9a84c" BorderThickness="3"
                            CornerRadius="16" Padding="14" VerticalAlignment="Center">
                        <Image Source="{Binding PairingQr}" Width="360" Height="360"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    </Border>

                    <!-- Instrukcja + PIN + adresy -->
                    <StackPanel Margin="56,0,0,0" VerticalAlignment="Center" MaxWidth="620">
                        <TextBlock Text="Cantio"
                                   FontFamily="{StaticResource HeaderFont}"
                                   FontSize="64" Foreground="#c9a84c" Margin="0,0,0,4"/>
                        <TextBlock Text="{DynamicResource Pairing.Title}"
                                   FontFamily="{StaticResource HeaderFont}"
                                   FontSize="34" Foreground="#e8eaf0"
                                   TextWrapping="Wrap" Margin="0,0,0,24"/>

                        <TextBlock Text="{DynamicResource Pairing.Step1}"
                                   FontSize="22" Foreground="#959fb9"
                                   TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock Text="{DynamicResource Pairing.Step2}"
                                   FontSize="22" Foreground="#959fb9"
                                   TextWrapping="Wrap" Margin="0,0,0,20"/>

                        <!-- Adresy: WSZYSTKIE interfejsy, bez zgadywania jednego -->
                        <ItemsControl ItemsSource="{Binding PairingAddresses}" Margin="0,0,0,20">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="30" Foreground="#e8eaf0"
                                               FontFamily="Consolas" Margin="0,0,0,4"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Pairing.Pin}"
                                       FontSize="30" Foreground="#959fb9"
                                       VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <Border Background="#161b25" BorderBrush="#c9a84c" BorderThickness="2"
                                    CornerRadius="12" Padding="24,6">
                                <TextBlock Text="{Binding PairingPin}"
                                           FontSize="72" FontWeight="Bold" Foreground="#c9a84c"
                                           FontFamily="Consolas"/>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="{DynamicResource Pairing.Footer}"
                                   FontSize="18" Foreground="#5d6784"
                                   TextWrapping="Wrap" Margin="0,26,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Viewbox>
        </Grid>
    </Grid>
</Window>
