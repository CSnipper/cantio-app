<UserControl x:Class="Cantio.Views.RemoteControlTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0f1117">
    <UserControl.Resources>
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background"      Value="#1e2535"/>
            <Setter Property="Foreground"      Value="#e8eaf0"/>
            <Setter Property="BorderBrush"     Value="#2a3347"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="8,6"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="CaretBrush"      Value="#c9a84c"/>
            <Setter Property="SelectionBrush"  Value="#c9a84c"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#c9a84c"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#3a4a65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GoldBtn" TargetType="Button">
            <Setter Property="Background" Value="#c9a84c"/>
            <Setter Property="Foreground" Value="#0f1117"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="{StaticResource HeaderFont}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#e8c97a"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="OutlineBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#9aa3b8"/>
            <Setter Property="BorderBrush" Value="#2a3347"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="{StaticResource HeaderFont}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="16,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#c9a84c"/>
                                <Setter Property="Foreground" Value="#c9a84c"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28" MaxWidth="440">

            <!-- Header -->
            <TextBlock Text="Pilot mobilny"
                       Foreground="#c9a84c"
                       FontFamily="{StaticResource HeaderFont}"
                       FontSize="22" Margin="0,0,0,6"/>
            <TextBlock Text="Otwórz adres w przeglądarce telefonu, żeby sterować slajdami."
                       Foreground="#959fb9"
                       FontSize="13" TextWrapping="Wrap" Margin="0,0,0,24"/>

            <!-- ─── Hotspot WiFi ──────────────────────────────── -->
            <TextBlock Text="Hotspot WiFi"
                       Foreground="#c9a84c"
                       FontFamily="{StaticResource HeaderFont}"
                       FontSize="16" Margin="0,0,0,8"/>
            <TextBlock Text="Włącz hotspot w Ustawieniach Windows, a następnie uruchom pilota poniżej."
                       Foreground="#959fb9" FontSize="12"
                       TextWrapping="Wrap" Margin="0,0,0,12"/>

            <Button Command="{Binding OpenHotspotSettingsCommand}"
                    Style="{StaticResource OutlineBtn}"
                    Height="36" FontSize="13" Margin="0,0,0,20"
                    HorizontalAlignment="Left" Padding="20,0"
                    Content="Ustawienia hotspota →"/>

            <Separator Background="#1e2535" Margin="0,0,0,20"/>

            <!-- Port -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <TextBlock Text="Port:" Foreground="#e8eaf0"
                           FontSize="14" VerticalAlignment="Center" Width="60"/>
                <TextBox Width="90"
                         Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                         Padding="6,4" FontSize="14">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource DarkTextBox}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </StackPanel>

            <!-- Toggle button -->
            <Button Command="{Binding ToggleServerCommand}"
                    Height="44" FontSize="14" Margin="0,0,0,24"
                    HorizontalAlignment="Left" Padding="24,0">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource GoldBtn}">
                        <Setter Property="Content" Value="Uruchom pilota"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                <Setter Property="Content" Value="Zatrzymaj pilota"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- URL row (visible when running) -->
            <StackPanel Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"
                        Margin="0,0,0,20">
                <TextBlock Text="Adres do otwarcia na telefonie:"
                           Foreground="#959fb9" FontSize="12" Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding LocalUrl}"
                               Foreground="#c9a84c" FontSize="16" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Content="Kopiuj" Padding="10,4" FontSize="12"
                            Style="{StaticResource OutlineBtn}"
                            Click="CopyUrl_Click"/>
                </StackPanel>
            </StackPanel>

            <!-- QR code (visible when running) -->
            <Image Source="{Binding QrCode}"
                   Width="200" Height="200"
                   HorizontalAlignment="Left"
                   RenderOptions.BitmapScalingMode="NearestNeighbor"
                   Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"
                   Margin="0,0,0,12"/>

            <TextBlock Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"
                       Text="Zeskanuj kod QR lub wpisz adres w przeglądarce telefonu."
                       Foreground="#959fb9" FontSize="12" TextWrapping="Wrap"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
