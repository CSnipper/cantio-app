<Window x:Class="Cantio.Views.CategoryEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:Cantio.Helpers"
        Title="{DynamicResource CategoryEditor.Title}"
        Width="520" Height="560"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.BgApp}"
        Foreground="{DynamicResource Brush.TextMain}"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <helpers:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.FocusRing}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Przyciski wiersza 40x40: obrys BorderStrong, tekst TextMain (usuwanie też — bez czerwieni) -->
        <Style x:Key="RowBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMain}"/>
        </Style>

        <!-- Wiersz 48 px; zaznaczenie = akcent; pozycja wirtualna („Bez kategorii") ukryta -->
        <Style x:Key="EditorRow" TargetType="ListBoxItem">
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMain}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="3,0,0,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Brush.BgSelected}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsVirtual}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header + dodawanie -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.BgPanel}" BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,0,0,1" Padding="20,16">
            <StackPanel>
                <TextBlock Text="{DynamicResource CategoryEditor.Title}"
                           FontFamily="{StaticResource HeaderFont}"
                           FontSize="22" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Accent}" Margin="0,0,0,12"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{DynamicResource Brush.BgPanelHover}"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                        <TextBox x:Name="NameBox"
                                 Text="{Binding NewCategoryName, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource Brush.TextMain}"
                                 CaretBrush="{DynamicResource Brush.TextMain}"
                                 FontSize="16" FontFamily="{StaticResource BodyFont}"
                                 Padding="10,0" Height="44" VerticalContentAlignment="Center">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding AddCategoryCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                    </Border>
                    <Button Grid.Column="2" Content="{DynamicResource Btn.AddShort}"
                            Style="{StaticResource ActionBtn}"
                            Background="{DynamicResource Brush.Accent}" BorderBrush="{DynamicResource Brush.Accent}"
                            Foreground="{DynamicResource Brush.AccentText}" FontWeight="Bold"
                            Padding="24,0"
                            Command="{Binding AddCategoryCommand}"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Lista kategorii -->
        <ListBox Grid.Row="1" x:Name="CategoryList"
                 ItemsSource="{Binding CategoryItems}"
                 SelectedItem="{Binding SelectedCategoryItem}"
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.CanContentScroll="False"
                 ItemContainerStyle="{StaticResource EditorRow}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid MinHeight="48">
                        <!-- Normalny widok: akcje tylko na zaznaczonym wierszu -->
                        <Grid Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="18"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected,
                                                RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Button Content="▲" Style="{StaticResource RowBtn}"
                                        IsEnabled="{Binding CanMoveUp}"
                                        Command="{Binding DataContext.MoveCategoryUpCommand,
                                            RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="▼" Style="{StaticResource RowBtn}"
                                        IsEnabled="{Binding CanMoveDown}"
                                        Command="{Binding DataContext.MoveCategoryDownCommand,
                                            RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="✎" Style="{StaticResource RowBtn}"
                                        Command="{Binding DataContext.StartEditCategoryCommand,
                                            RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="×" Style="{StaticResource RowBtn}"
                                        Command="{Binding DataContext.DeleteCategoryCommand,
                                            RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </Grid>
                        <!-- Zmiana nazwy w miejscu — ten sam mechanizm (IsEditing/EditName), co dotąd na liście głównej -->
                        <Grid Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                     Background="{DynamicResource Brush.BgPanelHover}"
                                     Foreground="{DynamicResource Brush.TextMain}"
                                     CaretBrush="{DynamicResource Brush.TextMain}"
                                     BorderBrush="{DynamicResource Brush.Border}"
                                     FontSize="16" Height="40" Padding="6,0"
                                     VerticalContentAlignment="Center">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return"
                                                Command="{Binding DataContext.SaveCategoryCommand,
                                                    RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                            <Button Grid.Column="1" Content="✓" Style="{StaticResource RowBtn}"
                                    Command="{Binding DataContext.SaveCategoryCommand,
                                        RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}"/>
                            <Button Grid.Column="2" Content="×" Style="{StaticResource RowBtn}"
                                    Command="{Binding DataContext.CancelEditCategoryCommand,
                                        RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}"/>
                        </Grid>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Dolny pasek -->
        <Border Grid.Row="2" Background="{DynamicResource Brush.BgPanel}" BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,1,0,0" Padding="20,14">
            <Button Content="{DynamicResource Btn.Close}"
                    Style="{StaticResource ActionBtn}"
                    HorizontalAlignment="Right"
                    Background="Transparent" BorderBrush="{DynamicResource Brush.BorderStrong}"
                    Foreground="{DynamicResource Brush.TextMain}" Padding="24,0"
                    Click="Close_Click"/>
        </Border>
    </Grid>
</Window>
