<Window x:Class="Cantio.Views.AccessibleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="{DynamicResource Acc.WindowTitle}"
        Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="Black" Foreground="White"
        FontSize="22"
        AutomationProperties.Name="{DynamicResource Acc.WindowTitle}">

    <!-- Pulpit dla operatora niewidomego: obsługa WYŁĄCZNIE klawiaturą, wszystko czyta NVDA
         przez UI Automation. Wygląd (duży kontrast, duża czcionka) jest dla osoby słabowidzącej
         i dla widzącego pomocnika przy pierwszym uruchomieniu. -->

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="{Binding SetlistCaption}" FontWeight="Bold" TextWrapping="Wrap"
                       Focusable="False" AutomationProperties.Name="{Binding SetlistCaption}"/>
            <TextBlock Text="{Binding SongCaption}" TextWrapping="Wrap" Foreground="#FFD37A"
                       Focusable="False" AutomationProperties.Name="{Binding SongCaption}"/>
            <!-- Kursor ZESTAWU (Alt + strzałki). Dla niewidomego mówi go live region; ten podpis
                 jest dla widzącego pomocnika i dla zrzutu ekranu w zgłoszeniu — bez niego nie da
                 się z boku zobaczyć, na czym zadziała Delete. -->
            <TextBlock Text="{Binding SetlistCursorCaption}" TextWrapping="Wrap" Foreground="#8FD3FF"
                       Focusable="False" AutomationProperties.Name="{Binding SetlistCursorCaption}"/>
            <!-- Licencja. Nazwisko właściciela JEST tu zabezpieczeniem (nikt nie chce, żeby cudzy
                 komputer ogłaszał jego nazwisko), więc musi być widoczne i słyszalne bez szukania. -->
            <TextBlock Text="{Binding LicenseCaption}" TextWrapping="Wrap" Foreground="#B8B8B8"
                       FontSize="16" Margin="0,4,0,0"
                       Focusable="False" AutomationProperties.Name="{Binding LicenseCaption}"/>
        </StackPanel>

        <TextBlock Grid.Row="1" Text="{Binding ProjectionCaption}" TextWrapping="Wrap"
                   Foreground="#9FE07A" Margin="0,0,0,8" Focusable="False"/>

        <!-- Lista czytania. Fokus na pozycji = czytnik ekranu odczytuje jej AutomationProperties.Name
             (pełna treść slajdu). Zmiana zaznaczenia NIE rusza projekcji. -->
        <ListBox Grid.Row="2" x:Name="ReadingList"
                 ItemsSource="{Binding ReadingSlides}"
                 SelectedIndex="{Binding ReadingIndex, Mode=TwoWay}"
                 Background="#101010" Foreground="White" BorderBrush="#404040"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 AutomationProperties.Name="{DynamicResource Acc.ListName}">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="AutomationProperties.Name" Value="{Binding Spoken}"/>
                    <Setter Property="Padding" Value="8,6"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Display}" TextWrapping="Wrap"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Wyszukiwarka pieśni (Ctrl+F / F3). Cały panel istnieje tylko w trybie wyszukiwania —
             ukryty jest Collapsed, więc drzewo UI Automation nie ma w sobie pola tekstowego,
             po którym czytnik ekranu mógłby zawędrować tam, gdzie nic nie działa. -->
        <StackPanel Grid.Row="3" Margin="0,8,0,0"
                    Visibility="{Binding IsSearchOpen, Converter={StaticResource BoolToVis}}">
            <TextBox x:Name="SearchBox" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                     Background="#101010" Foreground="White" CaretBrush="White" BorderBrush="#7AB8FF"
                     BorderThickness="2" Padding="8,6"
                     AutomationProperties.Name="{DynamicResource Acc.SearchBoxName}"/>
            <TextBlock Text="{Binding SearchCaption}" Foreground="#7AB8FF" Margin="0,4,0,0"
                       TextWrapping="Wrap" Focusable="False"/>
            <ListBox x:Name="SearchList" MaxHeight="220" Margin="0,4,0,0"
                     ItemsSource="{Binding SearchResults}"
                     SelectedIndex="{Binding SearchIndex, Mode=TwoWay}"
                     Background="#101010" Foreground="White" BorderBrush="#404040"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="{DynamicResource Acc.SearchListName}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="AutomationProperties.Name" Value="{Binding Spoken}"/>
                        <Setter Property="Padding" Value="8,4"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Display}" TextWrapping="Wrap"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>

        <!-- Panel ZAPISU zestawu (Ctrl+S). Jak wyszukiwarka: ukryty jest Collapsed, więc czytnik
             ekranu nie zawędruje do pola, które w tej chwili do niczego nie służy. -->
        <StackPanel Grid.Row="4" Margin="0,8,0,0"
                    Visibility="{Binding IsSavePanelOpen, Converter={StaticResource BoolToVis}}">
            <TextBox x:Name="SaveBox" Text="{Binding SetlistNameInput, UpdateSourceTrigger=PropertyChanged}"
                     Background="#101010" Foreground="White" CaretBrush="White" BorderBrush="#FFD37A"
                     BorderThickness="2" Padding="8,6"
                     AutomationProperties.Name="{DynamicResource Acc.SaveBoxName}"/>
        </StackPanel>

        <!-- Panel OTWIERANIA zestawu (Ctrl+O). -->
        <StackPanel Grid.Row="5" Margin="0,8,0,0"
                    Visibility="{Binding IsPickerOpen, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding PickerCaption}" Foreground="#FFD37A" TextWrapping="Wrap"
                       Focusable="False"/>
            <!-- Pole FILTRA. Organista ma kilkaset zapisanych zestawów — bez filtra lista jest
                 ze słuchu nie do przejścia. Filtruje po każdym znaku; ogłaszana jest sama LICZBA
                 trafień, więc pisanie nie tonie w komunikatach. -->
            <TextBox x:Name="FilterBox" Margin="0,4,0,0"
                     Text="{Binding PickerFilter, UpdateSourceTrigger=PropertyChanged}"
                     Background="#101010" Foreground="White" CaretBrush="White" BorderBrush="#FFD37A"
                     BorderThickness="2" Padding="8,6"
                     AutomationProperties.Name="{DynamicResource Acc.FilterBoxName}"/>
            <ListBox x:Name="PickerList" MaxHeight="220" Margin="0,4,0,0"
                     ItemsSource="{Binding SavedSetlists}"
                     SelectedIndex="{Binding PickerIndex, Mode=TwoWay}"
                     Background="#101010" Foreground="White" BorderBrush="#404040"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="{DynamicResource Acc.PickerListName}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="AutomationProperties.Name" Value="{Binding Spoken}"/>
                        <Setter Property="Padding" Value="8,4"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Display}" TextWrapping="Wrap"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>

        <!-- Panel LICENCJI (F9). Pole na klucz z maila — wklejanie Ctrl+V działa, bo pulpit nie
             przechwytuje niczego, czego pole tekstowe używa (zob. AccessibleKeys). -->
        <StackPanel Grid.Row="6" Margin="0,8,0,0"
                    Visibility="{Binding IsLicensePanelOpen, Converter={StaticResource BoolToVis}}">
            <TextBox x:Name="LicenseBox" Margin="0,4,0,0"
                     Text="{Binding LicenseKeyInput, UpdateSourceTrigger=PropertyChanged}"
                     Background="#101010" Foreground="White" CaretBrush="White" BorderBrush="#9FE07A"
                     BorderThickness="2" Padding="8,6" TextWrapping="Wrap" MaxLines="4"
                     AutomationProperties.Name="{DynamicResource Acc.LicenseBoxName}"/>
        </StackPanel>

        <!-- Live region: WPF podnosi zdarzenie LiveRegionChanged (kod za oknem), NVDA czyta tekst
             bez przenoszenia fokusu. Widoczny też na ekranie — pomocnik widzi to samo, co słychać. -->
        <Border Grid.Row="7" Margin="0,8,0,0" Padding="8" Background="#181818" BorderBrush="#404040" BorderThickness="1">
            <!-- UWAGA: żadnego AutomationProperties.Name na tym elemencie. Czytnik ekranu ogłasza
                 NAZWĘ live region, a nazwą TextBlocka jest domyślnie jego Text — wpisanie tu
                 etykiety („Komunikaty") sprawiłoby, że NVDA po każdej zmianie mówiłby tę etykietę
                 zamiast komunikatu. -->
            <TextBlock x:Name="LiveRegion" Text="{Binding LastAnnouncement}" TextWrapping="Wrap"
                       Focusable="False"
                       AutomationProperties.LiveSetting="Assertive"/>
        </Border>
    </Grid>
</Window>
