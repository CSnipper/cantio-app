<Window x:Class="Cantio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:Cantio.Helpers"
        xmlns:views="clr-namespace:Cantio.Views"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Cantio" Height="720" Width="1280"
        MinHeight="600" MinWidth="1000"
        WindowStartupLocation="Manual"
        Background="#0f1117"
        FontFamily="{StaticResource BodyFont}"
        Icon="cantio.ico">

    <Window.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <helpers:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
        <helpers:InverseBoolConverter x:Key="InverseBool"/>
        <helpers:EnumToBoolConverter x:Key="EnumBool"/>
        <helpers:DoubleToThicknessConverter x:Key="DoubleToThickness"/>
        <helpers:IsEqualConverter x:Key="IsEqual"/>
        <helpers:StripTagsConverter x:Key="StripTags"/>
        <helpers:WidthToHeightConverter x:Key="WidthToHeight"/>
        <FontFamily x:Key="HeaderFont">/Assets/Fonts/#Grenze</FontFamily>
        
        <!-- â”€â”€ Ciemny ComboBox â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
        <ControlTemplate x:Key="DarkComboToggle" TargetType="ToggleButton">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
                <Grid>
                    <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                    <Path Data="M0,0 L4,4 L8,0" x:Name="Arrow"
                          Stroke="#959fb9" StrokeThickness="1.5"
                          HorizontalAlignment="Right" VerticalAlignment="Center"
                          Margin="0,0,12,0"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="#3a4a65"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="#c9a84c"/>
                    <Setter TargetName="Arrow" Property="Stroke" Value="#c9a84c"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="DarkCombo" TargetType="ComboBox">
            <Setter Property="Background" Value="#1e2535"/>
            <Setter Property="Foreground" Value="#e8eaf0"/>
            <Setter Property="BorderBrush" Value="#2a3347"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Template="{StaticResource DarkComboToggle}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Padding="{TemplateBinding Padding}"
                                          Focusable="False" ClickMode="Press"/>
                            <ContentPresenter x:Name="ContentSite"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False"/>
                            <TextBox x:Name="PART_EditableTextBox"
                                     Margin="{TemplateBinding Padding}"
                                     Padding="0"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{TemplateBinding Foreground}"
                                     FontSize="{TemplateBinding FontSize}"
                                     VerticalAlignment="Center"
                                     Focusable="True"
                                     Visibility="Hidden"/>
                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=ToggleButton}"
                                   MinWidth="{Binding ActualWidth, ElementName=ToggleButton}"
                                   StaysOpen="False">
                                <Border Background="#1e2535" BorderBrush="#2a3347" BorderThickness="1" Margin="0,2,0,0">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="200">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#e8eaf0"/>
                        <Setter Property="Padding" Value="10,7"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#252d3d"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#2a3347"/>
                                <Setter Property="Foreground" Value="#c9a84c"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- â”€â”€ Ciemny TextBox â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background"      Value="#1e2535"/>
            <Setter Property="Foreground"      Value="#e8eaf0"/>
            <Setter Property="BorderBrush"     Value="#2a3347"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="8,6"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="CaretBrush"      Value="#c9a84c"/>
            <Setter Property="SelectionBrush"  Value="#c9a84c"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                       >
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#c9a84c"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#3a4a65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- â”€â”€ Ciemny Slider â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
        <Style x:Key="DarkSlider" TargetType="Slider">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*" MinHeight="18"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Track x:Name="PART_Track" Grid.Row="1">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton>
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" Background="#c9a84c"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton>
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" Background="#2a3347"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="14" Height="14"
                                                 Fill="#c9a84c" Stroke="#0f1117" StrokeThickness="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- â”€â”€ Ciemny CheckBox â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
        <Style x:Key="DarkCheck" TargetType="CheckBox">
            <Setter Property="Foreground"  Value="#e8eaf0"/>
            <Setter Property="FontSize"    Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="Box" Width="16" Height="16"
                            Background="#1e2535" BorderBrush="#2a3347" BorderThickness="1"
                            Margin="0,0,8,0">
                                <Path x:Name="Check" Data="M2,8 L6,12 L14,4"
                              Stroke="#c9a84c" StrokeThickness="2"
                              Visibility="Collapsed"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Box"   Property="BorderBrush" Value="#c9a84c"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#3a4a65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- â”€â”€ Ciemny RadioButton â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
        <Style x:Key="DarkRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#e8eaf0"/>
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="Box" Width="16" Height="16"
                            Background="#1e2535" BorderBrush="#2a3347" BorderThickness="1"
                            Margin="0,0,8,0">
                                <Ellipse x:Name="Dot" Width="8" Height="8"
                                 Fill="#c9a84c" Visibility="Collapsed"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#c9a84c"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- â”€â”€ ToggleButton (wyrównanie tekstu) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
        <Style x:Key="AlignBtn" TargetType="ToggleButton">
            <Setter Property="Background"      Value="#1e2535"/>
            <Setter Property="Foreground"      Value="#959fb9"/>
            <Setter Property="BorderBrush"     Value="#2a3347"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width"  Value="36"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                       >
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background"  Value="#2a3347"/>
                                <Setter Property="BorderBrush" Value="#c9a84c"/>
                                <Setter Property="Foreground"  Value="#c9a84c"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#3a4a65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- â”€â”€ Zakładka ustawień (Czcionka/Kolor/itd.) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
        <Style x:Key="SettingsTab" TargetType="RadioButton">
            <Setter Property="Background"  Value="Transparent"/>
            <Setter Property="Foreground"  Value="#959fb9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"     Value="8,4"/>
            <Setter Property="FontFamily"  Value="{StaticResource HeaderFont}"/>
            <Setter Property="FontSize"    Value="20"/>
            <Setter Property="FontWeight"  Value="Light"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                        BorderBrush="Transparent" BorderThickness="0,0,0,2"
                        Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#c9a84c"/>
                                <Setter Property="Foreground" Value="#c9a84c"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#9aa3b8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>



        <!-- â”€â”€ SCROLLBAR â”€â”€ -->
        <Style x:Key="SlimScrollViewer" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Hidden"/>
        </Style>

        <!-- â”€â”€ TAB BUTTON â”€â”€ -->
        <Style x:Key="TabBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1,0,0,1"/>
            <Setter Property="BorderBrush" Value="#9aa3b8"/>
            <Setter Property="Foreground" Value="#959fb9"/>
            <Setter Property="FontFamily" Value="{StaticResource HeaderFont}"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="Regular"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#08ffffff"/>
                                <Setter Property="Foreground" Value="#9aa3b8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TabBtnActive" TargetType="Button" BasedOn="{StaticResource TabBtn}">
            <Setter Property="BorderBrush" Value="#c9a84c"/>
            <Setter Property="Foreground" Value="#c9a84c"/>
            <Setter Property="Background" Value="#0Dc9a84c"/>
            <Setter Property="BorderThickness" Value="1,0,0,3"/>
        </Style>

        <!-- â”€â”€ OUTLINE BUTTON â”€â”€ -->
        <Style x:Key="OutlineBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#9aa3b8"/>
            <Setter Property="BorderBrush" Value="#2a3347"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="{StaticResource HeaderFont}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="16,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#c9a84c"/>
                                <Setter Property="Foreground" Value="#c9a84c"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- â”€â”€ RED BUTTON â”€â”€ -->
        <Style x:Key="RedBtn" TargetType="Button" BasedOn="{StaticResource OutlineBtn}">
            <Setter Property="Foreground" Value="#d44a4a"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#18d44a4a"/>
                                <Setter Property="BorderBrush" Value="#d44a4a"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- â”€â”€ SMALL ICON BUTTON â”€â”€ -->
        <Style x:Key="SmallIconBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#959fb9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2a3347"/>
                                <Setter Property="Foreground" Value="#e8eaf0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- â”€â”€ GOLD BUTTON â”€â”€ -->
        <Style x:Key="GoldBtn" TargetType="Button">
            <Setter Property="Background" Value="#c9a84c"/>
            <Setter Property="Foreground" Value="#0f1117"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="{StaticResource HeaderFont}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#e8c97a"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- â”€â”€ PIN BUTTON â”€â”€ -->
        <Style x:Key="PinBtn" TargetType="ToggleButton">
            <Setter Property="Background" Value="#1e2535"/>
            <Setter Property="Foreground" Value="#9aa3b8"/>
            <Setter Property="BorderBrush" Value="#2a3347"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="{StaticResource HeaderFont}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#c9a84c"/>
                                <Setter Property="Foreground" Value="#c9a84c"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="#1a2540"/>
                                <Setter Property="BorderBrush" Value="#c9a84c"/>
                                <Setter Property="Foreground" Value="#e8c97a"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- â”€â”€ NAV BUTTON â”€â”€ -->
        <Style x:Key="NavBtn" TargetType="Button">
            <Setter Property="Background" Value="#1e2535"/>
            <Setter Property="Foreground" Value="#e8eaf0"/>
            <Setter Property="BorderBrush" Value="#2a3347"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                       >
                            <TextBlock Text="{TemplateBinding Content}"
                               FontSize="{TemplateBinding FontSize}"
                               Foreground="{TemplateBinding Foreground}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#252d3d"/>
                                <Setter Property="BorderBrush" Value="#4a7fd4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- â”€â”€ SEARCH BOX â”€â”€ -->
        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="Background" Value="#1e2535"/>
            <Setter Property="Foreground" Value="#e8eaf0"/>
            <Setter Property="CaretBrush" Value="#c9a84c"/>
            <Setter Property="BorderBrush" Value="#2a3347"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="32,8,10,8"/>
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#4a7fd4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- â”€â”€ SHARED LIST ITEM â”€â”€ -->
        <Style x:Key="DarkListItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="#9aa3b8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="3,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1e2535"/>
                                <Setter Property="Foreground" Value="#e8eaf0"/>
                                <Setter Property="BorderBrush" Value="#2a3347"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#1a2540"/>
                                <Setter Property="BorderBrush" Value="#c9a84c"/>
                                <Setter Property="Foreground" Value="#e8eaf0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkListItemGold" TargetType="ListBoxItem" BasedOn="{StaticResource DarkListItem}">
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="#e8c97a"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- â•â•â•â•â•â•â•â•â•â• TOP BAR â•â•â•â•â•â•â•â•â•â• -->
        <Border Grid.Row="0" Background="#161b25" BorderBrush="#2a3347" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                    <Image Source="cantio.ico" Width="32" Height="32" Margin="0,0,10,0"/>
                    <TextBlock Text="Cantio"
                               FontFamily="{StaticResource HeaderFont}"
                               FontSize="40" FontWeight="Bold" Foreground="#c9a84c"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" x:Name="TabBar" HorizontalAlignment="right">
                    <Button x:Name="TabShow" Style="{StaticResource TabBtnActive}" Height="56" Click="TabShow_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="20" VerticalAlignment="Center" Margin="0,2,8,0"/>
                            <TextBlock Text="{DynamicResource Tab.Show}" FontFamily="{StaticResource HeaderFont}" FontSize="26" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="TabTemplate" Style="{StaticResource TabBtn}" Height="56" Click="TabTemplate_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="20" VerticalAlignment="Center" Margin="0,2,8,0"/>
                            <TextBlock Text="{DynamicResource Tab.Settings}" FontFamily="{StaticResource HeaderFont}" FontSize="26" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="TabImport" Style="{StaticResource TabBtn}" Height="56" Click="TabImport_Click" BorderThickness="1,0,1,1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="20" VerticalAlignment="Center" Margin="0,2,8,0"/>
                            <TextBlock Text="{DynamicResource Tab.Import}" FontFamily="{StaticResource HeaderFont}" FontSize="26" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="TabAbout" Style="{StaticResource TabBtn}" Height="56" Click="TabAbout_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="20" VerticalAlignment="Center" Margin="0,2,8,0"/>
                            <TextBlock Text="{DynamicResource Tab.About}" FontFamily="{StaticResource HeaderFont}" FontSize="26" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="TabSupport" Style="{StaticResource TabBtn}" Height="56" Click="TabSupport_Click" BorderThickness="1,0,1,1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#x2615;" FontFamily="Segoe UI" FontSize="20" VerticalAlignment="Center" Margin="0,2,8,0"/>
                            <TextBlock Text="{DynamicResource Tab.Support}" FontFamily="{StaticResource HeaderFont}" FontSize="26" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- â•â•â•â•â•â•â•â•â•â• CONTENT â•â•â•â•â•â•â•â•â•â• -->
        <Grid Grid.Row="1">

            <!-- â”€â”€ TAB: WYĹšWIETLANIE â”€â”€ -->
            <Grid x:Name="PaneShow" Visibility="Visible">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="400"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="380"/>
                    </Grid.ColumnDefinitions>

                    <!-- Col 0: ZWROTKI (slides list, full height) -->
                    <Grid Grid.Column="0" Background="#0f1117">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Nagłówek: ZWROTKI + tytuł pieśni -->
                        <Border Grid.Row="0" Background="#161b25" BorderBrush="#2a3347"
                                BorderThickness="0,0,1,1" Padding="14,11,14,8">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{DynamicResource Section.Verses}"
                                               FontFamily="{StaticResource HeaderFont}"
                                               FontSize="20" FontWeight="Light"
                                               Foreground="#c9a84c" Margin="0,0,16,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedSong.Title}"
                                               Foreground="#e8eaf0" FontSize="20" FontWeight="Light"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                                <TextBlock Text="Klawisze 1–0: przejdź do zwrotki  ·  przy >10: 1 lub 2 + drugi klawisz"
                                           Foreground="#8895bb" FontSize="14" Margin="4,10,4,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Lista slajdów -->
                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding SlideList}"
                                 SelectedIndex="{Binding CurrentSlideIndex}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ItemContainerStyle="{StaticResource DarkListItem}"
                                 KeyboardNavigation.DirectionalNavigation="None"
                                 Focusable="False"
                                 helpers:ListBoxAutoScrollBehavior.IsEnabled="True">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid MinHeight="64">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding DataContext.IsPsalmMode,
                                                                RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                Value="True"/>
                                                            <Condition Binding="{Binding IsChorusSlide}" Value="False"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Opacity" Value="0.35"/>
                                                    </MultiDataTrigger>
                                                    <DataTrigger Binding="{Binding IsPreviewOnlySlide}" Value="True">
                                                        <Setter Property="Opacity" Value="0.35"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#1e2535"
                                                BorderBrush="#2a3347" BorderThickness="0,0,1,0">
                                            <TextBlock Text="{Binding Label}"
                                                       FontFamily="{StaticResource BodyFont}"
                                                       FontSize="20"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#c9a84c"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPrivateSlide}" Value="True">
                                                                <Setter Property="Foreground" Value="#4aad6f"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <!-- Tekst zwrotki (ukryty dla obrazków) -->
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Text, Converter={StaticResource StripTags}}"
                                                   FontSize="20" LineHeight="24"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"
                                                   Margin="14,12,12,12">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsImageSlide}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <!-- Nazwa pliku obrazka (widoczna tylko dla IsImageSlide) -->
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding ImagePath, Converter={StaticResource FileName}}"
                                                   FontSize="18" LineHeight="22"
                                                   FontStyle="Italic" Foreground="#888"
                                                   VerticalAlignment="Center"
                                                   Margin="14,12,12,12">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsImageSlide}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <!-- Złoty lewy pasek = slajd aktualnie na projektorze -->
                                        <Border Grid.Column="0" Grid.ColumnSpan="2"
                                                BorderThickness="3,0,0,0" IsHitTestVisible="False">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Value="True">
                                                            <DataTrigger.Binding>
                                                                <MultiBinding Converter="{StaticResource IsEqual}">
                                                                    <Binding/>
                                                                    <Binding Path="DataContext.ProjectedSlide"
                                                                             RelativeSource="{RelativeSource AncestorType=ListBox}"/>
                                                                </MultiBinding>
                                                            </DataTrigger.Binding>
                                                            <Setter Property="BorderBrush" Value="#c9a84c"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <!-- Row 2: Kontrolki — LIVE | Tytuł+POKAĹ» | ◀ | ▶ -->
                        <Border Grid.Row="2" Background="#161b25" BorderBrush="#2a3347" BorderThickness="0,1,0,0" Padding="0,0,5,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="5"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="5"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- POKAŻ / WYGAŚ button -->
                                <Grid Grid.Column="1" Margin="0,8">
                                    <Button Command="{Binding ToggleBlankCommand}" Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#252d3d"/>
                                                <Setter Property="Foreground" Value="#9aa3b8"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="FontFamily" Value="{StaticResource HeaderFont}"/>
                                                <Setter Property="FontSize" Value="30"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#2a3347"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ScreenBlanked}" Value="True">
                                                        <Setter Property="Background" Value="#1e2535"/>
                                                        <Setter Property="Foreground" Value="#c9a84c"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <TextBlock VerticalAlignment="Center" TextAlignment="Center" Padding="6">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{DynamicResource Btn.Blank}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ScreenBlanked}" Value="True">
                                                            <Setter Property="Text" Value="{DynamicResource Btn.ShowText}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Button>
                                </Grid>

                                <!-- ◀ Poprzedni slajd -->
                                <Button Grid.Column="3" Content="◀"
                                        Style="{StaticResource NavBtn}"
                                        FontSize="40" Width="108" Height="108"
                                        Command="{Binding PrevSlideCommand}"/>

                                <!-- ▶ Następny slajd -->
                                <Button Grid.Column="5" Content="▶"
                                        Style="{StaticResource NavBtn}"
                                        FontSize="40" Width="108" Height="108"
                                        Command="{Binding NextSlideCommand}"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Col 1: ŚRODKOWA (Kat+Pieśni top, podglÄ…d middle, kontrolki bottom) -->
                    <Grid Grid.Column="1" Background="#0f1117">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>      <!-- Row 0: Kategorie + Pieśni -->
                            <RowDefinition Height="Auto"/>   <!-- Row 1: PodglÄ…d 16:9 -->
                        </Grid.RowDefinitions>

                        <!-- Song Edit Mode overlay — covers entire Col 1 -->
                        <Grid Grid.RowSpan="2" Panel.ZIndex="10" Background="#0f1117"
                              Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Nagłówek: Wróć -->
                            <Border Grid.Row="0" Background="#161b25" BorderBrush="#2a3347"
                                    BorderThickness="0,0,0,1" Padding="8,6">
                                <Button Content="{DynamicResource Btn.Back}" Style="{StaticResource GoldBtn}"
                                        HorizontalAlignment="Left" Padding="12,6"
                                        Command="{Binding BackFromEditCommand}"/>
                            </Border>

                            <!-- Metadane pieśni -->
                            <Border Grid.Row="1" BorderBrush="#2a3347" BorderThickness="0,0,0,1" Padding="10,8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <!-- Tytuł -->
                                    <TextBox Grid.Row="0" Style="{StaticResource DarkTextBox}"
                                             Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="16" Height="36" Margin="0,0,0,6" Padding="4"
                                             Tag="TYTUŁ"/>
                                    <!-- Nr + Kategoria -->
                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Style="{StaticResource DarkTextBox}"
                                                 Text="{Binding EditNumber, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="14" Height="34" Margin="0,0,6,0" Padding="4"
                                                 Tag="NR"/>
                                        <ComboBox Grid.Column="1" Style="{StaticResource DarkCombo}"
                                                  ItemsSource="{Binding Categories}"
                                                  SelectedItem="{Binding EditCategory}"
                                                  FontSize="14" Height="34">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Lista zwrotek -->
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="8,4">
                                    <!-- Zwrotki -->
                                    <ItemsControl ItemsSource="{Binding EditingVerses}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding Label}"
                                                                   FontSize="16" Foreground="#c9a84c"
                                                                   Margin="0,0,0,2" FontWeight="SemiBold"/>
                                                        <!-- TextBox — ukryty dla zwrotek typu "img" -->
                                                        <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                                                 AcceptsReturn="True" TextWrapping="Wrap"
                                                                 MinHeight="50" FontSize="18" Padding="6,5"
                                                                 PreviewKeyDown="VerseTextBox_PreviewKeyDown"
                                                                 PreviewMouseLeftButtonDown="VerseTextBox_PreviewMouseLeftButtonDown">
                                                            <TextBox.Style>
                                                                <Style TargetType="TextBox" BasedOn="{StaticResource DarkTextBox}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Type}" Value="img">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBox.Style>
                                                        </TextBox>
                                                        <!-- Panel obrazka — widoczny tylko dla Type="img" -->
                                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                            <StackPanel.Style>
                                                                <Style TargetType="StackPanel">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Type}" Value="img">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </StackPanel.Style>
                                                            <TextBlock Text="{Binding ImageFileName}"
                                                                       FontSize="16" Foreground="#9aa3b8"
                                                                       FontStyle="Italic"
                                                                       VerticalAlignment="Center"
                                                                       Margin="0,0,8,0"/>
                                                            <Button Content="📁" Width="36" Height="36"
                                                                    Style="{StaticResource SmallIconBtn}"
                                                                    Command="{Binding BrowseImageCommand}"
                                                                    ToolTip="Wybierz plik obrazka"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="4,16,0,0">
                                                        <!-- Zmień typ zwrotki (v → c → b → v), ukryty dla obrazków -->
                                                        <Button Width="28" Height="28" Margin="0,0,0,6"
                                                                Command="{Binding CycleTypeCommand}"
                                                                ToolTip="Zmień typ: Zwrotka / Refren / Bridge">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource SmallIconBtn}">
                                                                    <Setter Property="Foreground" Value="#9aa3b8"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Type}" Value="c">
                                                                            <Setter Property="Foreground" Value="#c9a84c"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Type}" Value="b">
                                                                            <Setter Property="Foreground" Value="#7a9abf"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Type}" Value="p">
                                                                            <Setter Property="Foreground" Value="#4aad6f"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Type}" Value="img">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                            <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="Bold"/>
                                                        </Button>
                                                        <Button Content="🔼" Width="28" Height="28" Margin="0,0,0,2"
                                                                Style="{StaticResource SmallIconBtn}"
                                                                Command="{Binding DataContext.MoveEditorVerseUpCommand,
                                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"/>
                                                        <Button Content="🔽" Width="28" Height="28" Margin="0,0,0,2"
                                                                Style="{StaticResource SmallIconBtn}"
                                                                Command="{Binding DataContext.MoveEditorVerseDownCommand,
                                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"/>
                                                        <Button Content="✕" Width="28" Height="28"
                                                                Style="{StaticResource SmallIconBtn}"
                                                                Foreground="#d44a4a"
                                                                Command="{Binding DataContext.RemoveVerseFromEditorCommand,
                                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Dodaj zwrotkę + Edytuj całość -->
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                                        <Button Content="{DynamicResource VerseType.Verse}" Style="{StaticResource OutlineBtn}"
                                                Margin="0,0,4,0" Padding="8,5"
                                                Command="{Binding AddVerseToEditorCommand}"
                                                CommandParameter="v"/>
                                        <Button Content="{DynamicResource VerseType.Chorus}" Style="{StaticResource OutlineBtn}"
                                                Margin="0,0,4,0" Padding="8,5"
                                                Command="{Binding AddVerseToEditorCommand}"
                                                CommandParameter="c"/>
                                        <Button Content="{DynamicResource VerseType.Bridge}" Style="{StaticResource OutlineBtn}"
                                                Margin="0,0,4,0" Padding="8,5"
                                                Command="{Binding AddVerseToEditorCommand}"
                                                CommandParameter="b"/>
                                        <Button Content="{DynamicResource VerseType.Private}" Style="{StaticResource OutlineBtn}"
                                                Margin="0,0,4,0" Padding="8,5"
                                                Command="{Binding AddVerseToEditorCommand}"
                                                CommandParameter="p"/>
                                        <Button Content="{DynamicResource VerseType.Image}" Style="{StaticResource OutlineBtn}"
                                                Padding="8,5"
                                                Command="{Binding AddVerseToEditorCommand}"
                                                CommandParameter="img"/>
                                    </StackPanel>
                                    <Button Content="{DynamicResource VerseType.EditAll}" Style="{StaticResource OutlineBtn}"
                                            HorizontalAlignment="Left" Padding="10,6" Margin="0,0,0,4"
                                            Command="{Binding OpenPasteTextEditorCommand}"/>

                                    <!-- Kolejność odtwarzania -->
                                    <Border Margin="0,8,0,4" Padding="8,6" Background="#181b24"
                                            CornerRadius="4" BorderBrush="#2a3347" BorderThickness="1">
                                        <StackPanel>
                                            <!-- Nagłówek -->
                                            <Grid Margin="0,0,0,6">
                                                <TextBlock Text="{DynamicResource Editor.PlayOrder}"
                                                           FontSize="11" FontWeight="Bold" Foreground="#c9a84c"
                                                           VerticalAlignment="Center"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Button Content="{DynamicResource Editor.PlayOrder.Rebuild}"
                                                            Style="{StaticResource OutlineBtn}"
                                                            Padding="6,3" FontSize="11" Margin="0,0,4,0"
                                                            Command="{Binding RebuildPlayOrderAutoCommand}"/>
                                                    <Button Content="{DynamicResource Editor.PlayOrder.Clear}"
                                                            Style="{StaticResource OutlineBtn}"
                                                            Padding="6,3" FontSize="11"
                                                            Command="{Binding ClearPlayOrderCommand}"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Lista kolejności -->
                                            <ItemsControl x:Name="PlayOrderList" ItemsSource="{Binding EditPlayOrder}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,1">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="28"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                                       FontFamily="{StaticResource BodyFont}" FontSize="13"
                                                                       FontWeight="Bold" Foreground="#c9a84c"
                                                                       VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding Verse.Text}"
                                                                       FontSize="12" Foreground="#8a8e9e"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center"/>
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                                <Button Width="22" Height="22" Content="↑"
                                                                        Style="{StaticResource SmallIconBtn}"
                                                                        Command="{Binding DataContext.MovePlayOrderUpCommand,
                                                                            RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}"/>
                                                                <Button Width="22" Height="22" Content="↓"
                                                                        Style="{StaticResource SmallIconBtn}"
                                                                        Command="{Binding DataContext.MovePlayOrderDownCommand,
                                                                            RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}"/>
                                                                <Button Width="22" Height="22" Content="✕"
                                                                        Style="{StaticResource SmallIconBtn}"
                                                                        Foreground="#c04040"
                                                                        Command="{Binding DataContext.RemoveFromPlayOrderCommand,
                                                                            RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Dodaj do kolejności -->
                                            <Grid Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ComboBox Grid.Column="0" Style="{StaticResource DarkCombo}"
                                                          ItemsSource="{Binding EditingVerses}"
                                                          SelectedItem="{Binding SelectedPlayOrderAddVerse}"
                                                          Height="28" FontSize="12" Margin="0,0,4,0">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Label}" FontWeight="Bold"
                                                                           Foreground="#c9a84c" Margin="0,0,6,0"/>
                                                                <TextBlock Text="{Binding Text}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           MaxWidth="180"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <Button Grid.Column="1" Content="{DynamicResource Editor.PlayOrder.Add}"
                                                        Style="{StaticResource GoldBtn}"
                                                        Height="28" Padding="8,0"
                                                        Command="{Binding AddVerseToPlayOrderCommand}"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Zapisz / Usuń -->
                            <Border Grid.Row="3" Background="#161b25" BorderBrush="#2a3347"
                                    BorderThickness="0,1,0,0" Padding="8,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="{DynamicResource Btn.SaveSong}"
                                            Style="{StaticResource GoldBtn}" Margin="0,0,8,0"
                                            Command="{Binding SaveEditedSongCommand}"/>
                                    <Button Grid.Column="1" Content="{DynamicResource Btn.Delete}"
                                            Style="{StaticResource RedBtn}" Padding="12,0"
                                            Command="{Binding DeleteEditedSongCommand}"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Row 0: Kategorie (left) + Pieśni (right) -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <!-- KATEGORIE -->
                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="#161b25" BorderBrush="#2a3347"
                                        BorderThickness="0,0,1,1" Padding="10,3">
                                    <Grid>
                                        <TextBlock Text="{DynamicResource Section.Categories}"
                                                   FontFamily="{StaticResource HeaderFont}"
                                                   FontSize="20" FontWeight="Light" Foreground="#c9a84c"
                                                   VerticalAlignment="Center"/>
                                        <Button Content="{DynamicResource Btn.AddCategory}"
                                                Style="{StaticResource GoldBtn}"
                                                HorizontalAlignment="Right" Padding="8,4"
                                                Command="{Binding AddNewCategoryInlineCommand}"/>
                                    </Grid>
                                </Border>
                                <Border Grid.Row="1" BorderBrush="#2a3347" BorderThickness="0,0,1,0">
                                    <ListBox x:Name="CategoryListBox"
                                             ItemsSource="{Binding CategoryItems}"
                                             SelectedItem="{Binding SelectedCategoryItem}"
                                             Background="Transparent" BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                             ItemContainerStyle="{StaticResource DarkListItemGold}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid MinHeight="50">
                                                    <!-- Normalny widok -->
                                                    <Grid Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVis}}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="32"/>
                                                            <ColumnDefinition Width="32"/>
                                                            <ColumnDefinition Width="32"/>
                                                            <ColumnDefinition Width="32"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Padding="5,0,0,0" FontSize="18"
                                                                   VerticalAlignment="Center"/>
                                                        <Button Grid.Column="1" Content="▲"
                                                                Style="{StaticResource SmallIconBtn}"
                                                                Width="32" Height="50"
                                                                IsEnabled="{Binding CanMoveUp}"
                                                                Command="{Binding DataContext.MoveCategoryUpCommand,
                                                                    RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                CommandParameter="{Binding}"/>
                                                        <Button Grid.Column="2" Content="▼"
                                                                Style="{StaticResource SmallIconBtn}"
                                                                Width="32" Height="50"
                                                                IsEnabled="{Binding CanMoveDown}"
                                                                Command="{Binding DataContext.MoveCategoryDownCommand,
                                                                    RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                CommandParameter="{Binding}"/>
                                                        <Button Grid.Column="3" Content="✎"
                                                                Style="{StaticResource SmallIconBtn}"
                                                                Width="32" Height="50"
                                                                Command="{Binding DataContext.StartEditCategoryCommand,
                                                                    RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                CommandParameter="{Binding}"/>
                                                        <Button Grid.Column="4" Content="✕"
                                                                Style="{StaticResource SmallIconBtn}"
                                                                Width="32" Height="50" Foreground="#d44a4a"
                                                                Command="{Binding DataContext.DeleteCategoryCommand,
                                                                    RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                CommandParameter="{Binding}"/>
                                                    </Grid>
                                                    <!-- Tryb edycji -->
                                                    <Grid Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="36"/>
                                                            <ColumnDefinition Width="36"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Grid.Column="0"
                                                                 Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                                                 Style="{StaticResource DarkTextBox}"
                                                                 FontSize="16" Height="36" Margin="4,7" Padding="4">
                                                            <TextBox.InputBindings>
                                                                <KeyBinding Key="Return"
                                                                            Command="{Binding DataContext.SaveCategoryCommand,
                                                                                RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                            CommandParameter="{Binding}"/>
                                                            </TextBox.InputBindings>
                                                        </TextBox>
                                                        <Button Grid.Column="1" Content="✓"
                                                                Style="{StaticResource SmallIconBtn}"
                                                                Width="36" Height="50" Foreground="#6db76d"
                                                                Command="{Binding DataContext.SaveCategoryCommand,
                                                                    RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                CommandParameter="{Binding}"/>
                                                        <Button Grid.Column="2" Content="✕"
                                                                Style="{StaticResource SmallIconBtn}"
                                                                Width="36" Height="50"
                                                                Command="{Binding DataContext.CancelEditCategoryCommand,
                                                                    RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                CommandParameter="{Binding}"/>
                                                    </Grid>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </Grid>

                            <!-- PIEĹšNI -->
                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="#161b25" BorderBrush="#2a3347"
                                        BorderThickness="0,0,1,1" Padding="10,3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource Section.Songs}"
                                                   FontFamily="{StaticResource HeaderFont}"
                                                   FontSize="20" FontWeight="Light" Foreground="#c9a84c"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedCategory.Name}" Foreground="#9aa3b8"
                                                   FontSize="14" Margin="10,7" VerticalAlignment="Center"
                                                   HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
                                        <Button Grid.Column="2" Content="{DynamicResource Btn.NewSong}"
                                                Style="{StaticResource GoldBtn}"
                                                Padding="8,4" Command="{Binding NewSongCommand}"/>
                                    </Grid>
                                </Border>
                                <Border Grid.Row="1" Background="#161b25">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="🔍" Foreground="#959fb9" FontSize="20"
                                                   IsHitTestVisible="False" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBox Grid.Column="1" x:Name="SearchBoxShow"
                                                 Style="{StaticResource SearchBox}"
                                                 Padding="4"
                                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                 PreviewKeyDown="SearchBoxShow_PreviewKeyDown"/>
                                        <TextBlock Grid.Column="1" Text="{DynamicResource Placeholder.SearchSongs}" Foreground="#959fb9" FontSize="16"
                                                   IsHitTestVisible="False" VerticalAlignment="Center" Margin="8,0,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsFocused, ElementName=SearchBoxShow}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                                <Border Grid.Row="2" BorderBrush="#2a3347" BorderThickness="0,0,1,0">
                                    <ListBox x:Name="SongListShow"
                                             ItemsSource="{Binding Songs}"
                                             SelectedItem="{Binding SelectedSong}"
                                             Background="Transparent" BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ItemContainerStyle="{StaticResource DarkListItem}">
                                        <ListBox.InputBindings>
                                            <MouseBinding MouseAction="LeftDoubleClick"
                                                          Command="{Binding DisplaySongCommand}"
                                                          CommandParameter="{Binding SelectedSong}"/>
                                        </ListBox.InputBindings>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="36"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="32"/>
                                                        <ColumnDefinition Width="38"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0"
                                                            Command="{Binding DataContext.DisplaySongCommand,
                                                                RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                            CommandParameter="{Binding}"
                                                            Background="Transparent" BorderThickness="0"
                                                            Foreground="#959fb9" Cursor="Hand"
                                                            VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="Transparent">
                                                                    <TextBlock Text="👁" FontSize="14"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"
                                                                               Foreground="{TemplateBinding Foreground}"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Foreground" Value="#c9a84c"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                    <TextBlock Grid.Column="1" Text="{Binding Title}"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                               Margin="0,12,0,12" TextWrapping="Wrap" FontSize="18"/>
                                                    <Button Grid.Column="2"
                                                            Command="{Binding DataContext.EditSongCommand,
                                                                RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                            CommandParameter="{Binding}"
                                                            VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="Transparent" Padding="2">
                                                                    <TextBlock Text="✎" FontSize="18">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Foreground" Value="Transparent"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsMouseOver,
                                                                                        RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                                                        Value="True">
                                                                                        <Setter Property="Foreground" Value="#c9a84c"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                    <Button Grid.Column="3" Content="+"
                                                            Width="40" Height="40"
                                                            Background="#343f58" BorderBrush="#2a3347"
                                                            BorderThickness="0" Foreground="#959fb9"
                                                            Cursor="Hand"
                                                            Command="{Binding DataContext.AddToSetlistCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                            CommandParameter="{Binding}" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}"
                                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                                        BorderThickness="{TemplateBinding BorderThickness}">
                                                                    <TextBlock Text="+"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"
                                                                               Margin="0,0,0,4"
                                                                               FontSize="30" FontWeight="Light"
                                                                               Foreground="{TemplateBinding Foreground}"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="#c9a84c"/>
                                                                        <Setter Property="BorderBrush" Value="#c9a84c"/>
                                                                        <Setter Property="Foreground" Value="#0f1117"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- Row 1: PodglÄ…d 16:9 + Przypięte -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="160" MinWidth="120" MaxWidth="200"/>
                            </Grid.ColumnDefinitions>

                            <!-- Podgląd 16:9 + belka statusu -->
                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Belka "Trwa projekcja" -->
                                <Border Grid.Row="0" Padding="2"
                                        Background="#d44a4a15"
                                        BorderBrush="#2a3347" BorderThickness="0,1,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Opacity" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ScreenBlanked}" Value="True">
                                                    <Setter Property="Opacity" Value="0.22"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Ellipse Width="10" Height="10" Fill="#d44a4a" Margin="0,4,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource Live.Label}"
                                                   FontFamily="{StaticResource HeaderFont}"
                                                   FontSize="22" FontWeight="SemiBold"
                                                   Foreground="#d44a4a" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Podgląd 16:9 -->
                                <Border Grid.Row="1"
                                        Background="{Binding Projection.BackgroundBrush}"
                                        BorderBrush="#2a3347" BorderThickness="0,1,0,1"
                                        ClipToBounds="True"
                                        Height="{Binding ActualWidth, RelativeSource={RelativeSource Self},
                                                 Converter={StaticResource WidthToHeight}}">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000" ShadowDepth="0" BlurRadius="16" Opacity=".6"/>
                                    </Border.Effect>
                                    <Viewbox Stretch="Uniform">
                                        <views:ProjectionView DataContext="{Binding Projection}"
                                                              IsPreviewMode="True"
                                                              Width="{Binding DataContext.ProjectionScreenWidth,
                                                                      RelativeSource={RelativeSource AncestorType={x:Type Viewbox}}}"
                                                              Height="{Binding DataContext.ProjectionScreenHeight,
                                                                       RelativeSource={RelativeSource AncestorType={x:Type Viewbox}}}"/>
                                    </Viewbox>
                                </Border>
                            </Grid>

                            <!-- Przypięte zestawy -->
                            <Border Grid.Column="1" Background="#0d1018"
                                    BorderBrush="#2a3347" BorderThickness="1,1,0,1" Padding="6,8">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" HorizontalAlignment="Center"
                                               Text="{DynamicResource Section.Pinned}"
                                               FontFamily="{StaticResource HeaderFont}" FontWeight="Light"
                                               FontSize="20" Foreground="#c9a84c" Margin="0,0,0,6"/>
                                    <Button DockPanel.Dock="Bottom"
                                            Content="📌 Przypnij tydzień"
                                            Margin="0,8,0,0" Padding="6,5"
                                            Command="{Binding PinNextWeekCommand}"
                                            Style="{StaticResource OutlineBtn}"/>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding PinnedSetlists}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Button Grid.Column="0" Content="{Binding Name}"
                                                                Command="{Binding DataContext.LoadPinnedSetlistCommand,
                                                                    RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource OutlineBtn}"/>
                                                        <Button Grid.Column="1" Content="✕"
                                                                Margin="3,0,0,0" Padding="5,0"
                                                                FontSize="11"
                                                                ToolTip="{DynamicResource Pinned.Unpin}"
                                                                Command="{Binding DataContext.UnpinSetlistCommand,
                                                                    RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource OutlineBtn}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- Col 2: ZESTAW -->
                    <Grid Grid.Column="2" Background="#0f1117" ClipToBounds="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="#161b25" BorderBrush="#2a3347"
                                    BorderThickness="1,0,0,1" Padding="12,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{DynamicResource Section.CurrentSet}"
                                               FontFamily="{StaticResource HeaderFont}"
                                               FontSize="20" FontWeight="Light"
                                               Foreground="#c9a84c" Margin="0,0,10,0"
                                               VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" Background="#252d3d" Padding="8,2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SetlistItems.Count}" Foreground="#9aa3b8" FontSize="10"/>
                                    </Border>
                                    <Button Grid.Column="3" x:Name="BtnOpenSetlist"
                                            Content="{DynamicResource Btn.OpenSet}"
                                            Command="{Binding OpenSetlistSearchCommand}"
                                            Background="#252d3d" BorderThickness="0"
                                            Foreground="#9aa3b8" FontSize="13" Cursor="Hand"
                                            Padding="10,5" VerticalAlignment="Center">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#c9a84c"/>
                                                        <Setter Property="Foreground" Value="#0f1117"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Popup wyszukiwania zestawów -->
                            <Popup Grid.Row="0"
                                   x:Name="SetlistSearchPopup"
                                   IsOpen="{Binding IsSetlistSearchOpen, Mode=TwoWay}"
                                   PlacementTarget="{Binding ElementName=BtnOpenSetlist}"
                                   Placement="Bottom"
                                   StaysOpen="False"
                                   AllowsTransparency="True"
                                   Opened="SetlistSearchPopup_Opened">
                                <Border Background="#1e2535" BorderBrush="#2a3347" BorderThickness="1"
                                        Width="340" MaxHeight="400">
                                    <Grid Margin="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBox Grid.Row="0"
                                                 x:Name="SetlistSearchBox"
                                                 Style="{StaticResource DarkTextBox}"
                                                 Text="{Binding SetlistSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="15" Padding="8,6" Margin="0,0,0,6"/>
                                        <ListBox Grid.Row="1"
                                                 ItemsSource="{Binding FilteredSetlists}"
                                                 Background="Transparent" BorderThickness="0"
                                                 MaxHeight="340"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ItemContainerStyle="{StaticResource DarkListItem}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="4,4,4,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontSize="15" Foreground="#e8eaf0"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding Group}"
                                                                       FontSize="11" Foreground="#959fb9"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Content="{DynamicResource Btn.Open}"
                                                                Margin="0,0,4,0" Padding="8,4"
                                                                Background="#252d3d" BorderThickness="0"
                                                                Foreground="#9aa3b8" FontSize="12" Cursor="Hand"
                                                                Command="{Binding DataContext.LoadSetlistFromSearchCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                CommandParameter="{Binding}">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Background" Value="#c9a84c"/>
                                                                            <Setter Property="Foreground" Value="#0f1117"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                        <Button Grid.Column="2" Content="{DynamicResource Btn.Append}"
                                                                Padding="8,4" Margin="0,0,4,0"
                                                                Background="#252d3d" BorderThickness="0"
                                                                Foreground="#9aa3b8" FontSize="12" Cursor="Hand"
                                                                Command="{Binding DataContext.AppendSetlistFromSearchCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                CommandParameter="{Binding}">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Background" Value="#3a6ea8"/>
                                                                            <Setter Property="Foreground" Value="#ffffff"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                        <Button Grid.Column="3" Content="✕"
                                                                Padding="8,4"
                                                                Background="#252d3d" BorderThickness="0"
                                                                Foreground="#e05a5a" FontSize="12" Cursor="Hand"
                                                                ToolTip="Usuń zestaw"
                                                                Command="{Binding DataContext.DeleteSetlistFromSearchCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                CommandParameter="{Binding}">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Background" Value="#7a2020"/>
                                                                            <Setter Property="Foreground" Value="#ffffff"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                        <Button Grid.Column="4" Content="📌"
                                                                Padding="8,4" Margin="4,0,0,0"
                                                                Background="#252d3d" BorderThickness="0"
                                                                Foreground="#c9a84c" FontSize="12" Cursor="Hand"
                                                                ToolTip="Przypnij zestaw"
                                                                Command="{Binding DataContext.PinSetlistFromSearchCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                CommandParameter="{Binding}">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Background" Value="#c9a84c"/>
                                                                            <Setter Property="Foreground" Value="#0f1117"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </Border>
                            </Popup>

                            <Border Grid.Row="1" BorderBrush="#2a3347" BorderThickness="1,0,0,0">
                                <ListBox x:Name="SetlistListBox"
                                         ItemsSource="{Binding SetlistItems}"
                                         SelectedItem="{Binding SelectedSetlistItem}"
                                         Background="Transparent" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ItemContainerStyle="{StaticResource DarkListItemGold}">
                                    <ListBox.InputBindings>
                                        <MouseBinding MouseAction="LeftDoubleClick"
                                                      Command="{Binding DisplaySetlistItemCommand}"
                                                      CommandParameter="{Binding SelectedSetlistItem}"/>
                                    </ListBox.InputBindings>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid AllowDrop="True"
                                                  MouseMove="SetlistItem_MouseMove"
                                                  Drop="SetlistItem_Drop">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="36"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="34"/>
                                                    <ColumnDefinition Width="30"/>
                                                    <ColumnDefinition Width="30"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Button Grid.Column="0"
                                                        Command="{Binding DataContext.DisplaySetlistItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}"
                                                        Width="30" Height="30"
                                                        Background="Transparent" BorderThickness="0"
                                                        Foreground="#959fb9" Cursor="Hand"
                                                        VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="Transparent">
                                                                <TextBlock Text="👁" FontSize="16"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{TemplateBinding Foreground}"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Foreground" Value="#c9a84c"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                                <Grid Grid.Column="1">
                                                    <!-- Song item: tytuł -->
                                                    <TextBlock Text="{Binding Song.Title}"
                                                               TextWrapping="Wrap" VerticalAlignment="Center"
                                                               HorizontalAlignment="Stretch"
                                                               FontSize="20" Padding="10"
                                                               Visibility="{Binding IsImageItem, Converter={StaticResource InverseBoolToVis}}"/>
                                                    <!-- Image item: miniatura + nazwa pliku -->
                                                    <StackPanel Orientation="Horizontal"
                                                                VerticalAlignment="Center"
                                                                Margin="6,0"
                                                                Visibility="{Binding IsImageItem, Converter={StaticResource BoolToVis}}">
                                                        <Image Source="{Binding ImagePath}" Width="48" Height="32"
                                                               Stretch="Uniform" Margin="0,0,8,0" SnapsToDevicePixels="True"/>
                                                        <TextBlock Text="{Binding ImagePath, Converter={StaticResource FileName}}"
                                                                   VerticalAlignment="Center" FontSize="18"
                                                                   Foreground="#9aa3b8" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Grid>
                                                <Button Grid.Column="2" Content="✏"
                                                        Width="30" Height="30"
                                                        Background="Transparent" BorderThickness="0"
                                                        Foreground="#959fb9" FontSize="16" Cursor="Hand"
                                                        Visibility="{Binding IsImageItem, Converter={StaticResource InverseBoolToVis}}"
                                                        IsEnabled="{Binding DataContext.CanOpenInlineEditor, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        Command="{Binding DataContext.OpenInlineEditorCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="Transparent">
                                                                <TextBlock Text="✏"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"
                                                                           FontSize="15"
                                                                           Foreground="{TemplateBinding Foreground}"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Foreground" Value="#c9a84c"/>
                                                                </Trigger>
                                                                <Trigger Property="IsEnabled" Value="False">
                                                                    <Setter Property="Foreground" Value="#3a4460"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                                <Button Grid.Column="3"
                                                        Width="30" Height="30"
                                                        Background="Transparent" BorderThickness="0"
                                                        Foreground="#959fb9" Cursor="Hand"
                                                        ToolTip="Pełny edytor"
                                                        Visibility="{Binding IsImageItem, Converter={StaticResource InverseBoolToVis}}"
                                                        Command="{Binding DataContext.OpenFullEditorFromSetlistCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="Transparent">
                                                            <TextBlock Text="&#xE929;"
                                                                           FontFamily="Segoe MDL2 Assets"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"
                                                                           FontSize="14"
                                                                           Foreground="{TemplateBinding Foreground}"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Foreground" Value="#c9a84c"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                                <Button Grid.Column="4" Content="×"
                                                        Width="30" Height="30"
                                                        Background="Transparent" BorderThickness="0"
                                                        Foreground="#959fb9" FontSize="20" Cursor="Hand"
                                                        Command="{Binding DataContext.RemoveFromSetlistCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="Transparent">
                                                                <TextBlock Text="×"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"
                                                                           FontSize="18"
                                                                           Foreground="{TemplateBinding Foreground}"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Foreground" Value="#d44a4a"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                                                           Text="{Binding Notes}"
                                                           FontSize="10" Foreground="#7080a0"
                                                           Margin="10,0,0,4" TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Notes}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Notes}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                            
                            <Border Grid.Row="2" Background="#161b25" BorderBrush="#2a3347"
                                    BorderThickness="1,1,0,0" Padding="6,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="⏫" FontSize="16"
                                            ToolTip="{DynamicResource Tooltip.ToTop}"
                                            Background="Transparent" BorderThickness="0"
                                            Foreground="#959fb9" Height="36" Cursor="Hand"
                                            Command="{Binding MoveToTopCommand}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}">
                                                    <TextBlock Text="⏫" FontSize="16"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#1e2535"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button Grid.Column="1" Content="🔼" FontSize="16"
                                            ToolTip="{DynamicResource Tooltip.Up}"
                                            Background="Transparent" BorderThickness="0"
                                            Foreground="#959fb9" Height="36" Cursor="Hand"
                                            Command="{Binding MoveUpCommand}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}">
                                                    <TextBlock Text="🔼" FontSize="16"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#1e2535"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button Grid.Column="2" Content="🔽" FontSize="16"
                                            ToolTip="{DynamicResource Tooltip.Down}"
                                            Background="Transparent" BorderThickness="0"
                                            Foreground="#959fb9" Height="36" Cursor="Hand"
                                            Command="{Binding MoveDownCommand}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}">
                                                    <TextBlock Text="🔽" FontSize="16"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#1e2535"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button Grid.Column="3" Content="⏬" FontSize="16"
                                            ToolTip="{DynamicResource Tooltip.ToBottom}"
                                            Background="Transparent" BorderThickness="0"
                                            Foreground="#959fb9" Height="36" Cursor="Hand"
                                            Command="{Binding MoveToBottomCommand}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}">
                                                    <TextBlock Text="⏬" FontSize="16"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#1e2535"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button Grid.Column="4" FontSize="16"
                                            ToolTip="{DynamicResource Setlist.AddImage}"
                                            Background="Transparent" BorderThickness="0"
                                            Foreground="#959fb9" Height="36" Cursor="Hand"
                                            Command="{Binding AddImageToSetlistCommand}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}">
                                                    <TextBlock Text="🖼" FontSize="16"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#1e2535"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>

                            <Border Grid.Row="3" Background="#161b25" BorderBrush="#2a3347"
                                    BorderThickness="1,1,0,0" Padding="8,8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <!-- Pole grupy zestawu -->
                                    <Grid Grid.Row="1" Margin="0,0,0,2">
                                        <ComboBox Style="{StaticResource DarkCombo}"
                                                  ItemsSource="{Binding SetlistGroups}"
                                                  Text="{Binding SetlistGroup, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEditable="True"
                                                  Foreground="#e8eaf0"
                                                  FontSize="16" Height="34"/>
                                        <TextBlock Text="{DynamicResource Placeholder.SetlistGroup}"
                                                   Foreground="#ffffff" FontSize="16"
                                                   Padding="7,3" IsHitTestVisible="False" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SetlistGroup}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <!-- Przycisk zarządzania grupami + Popup -->
                                    <Grid Grid.Row="0" Margin="0,0,0,4">
                                        <Button x:Name="BtnManageGroups"
                                                Content="{DynamicResource Btn.ManageGroups}"
                                                Style="{StaticResource GoldBtn}"
                                                HorizontalAlignment="Stretch"
                                                Padding="8,6" Height="34"
                                                Command="{Binding OpenGroupPopupCommand}"/>
                                        <Popup IsOpen="{Binding IsGroupPopupOpen, Mode=TwoWay}"
                                               PlacementTarget="{Binding ElementName=BtnManageGroups}"
                                               Placement="Bottom"
                                               StaysOpen="False"
                                               AllowsTransparency="True">
                                            <Border Background="#1e2535" BorderBrush="#2a3347" BorderThickness="1"
                                                    Width="300" MaxHeight="400">
                                                <Grid Margin="8">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>
                                                    <!-- Nagłówek: tytuł + dodaj -->
                                                    <Grid Grid.Row="0" Margin="0,0,0,6">
                                                        <TextBlock Text="{DynamicResource Section.Groups}"
                                                                   FontFamily="{StaticResource HeaderFont}"
                                                                   FontSize="16" Foreground="#c9a84c"
                                                                   VerticalAlignment="Center"/>
                                                        <Button Content="{DynamicResource Groups.AddNew}"
                                                                Style="{StaticResource GoldBtn}"
                                                                HorizontalAlignment="Right"
                                                                Padding="6,2" Height="36" FontSize="16"
                                                                Command="{Binding AddNewGroupInlineCommand}"/>
                                                    </Grid>
                                                    <!-- Lista grup -->
                                                    <ListBox Grid.Row="1"
                                                             ItemsSource="{Binding GroupItems}"
                                                             Background="Transparent" BorderThickness="0"
                                                             MaxHeight="340"
                                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                             ItemContainerStyle="{StaticResource DarkListItem}">
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid MinHeight="40">
                                                                    <!-- Normalny widok -->
                                                                    <Grid Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVis}}">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="30"/>
                                                                            <ColumnDefinition Width="30"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0" Text="{Binding OriginalName}"
                                                                                   FontSize="15" VerticalAlignment="Center"
                                                                                   TextTrimming="CharacterEllipsis"/>
                                                                        <Button Grid.Column="1" Content="✎"
                                                                                Style="{StaticResource SmallIconBtn}"
                                                                                Width="30" Height="40"
                                                                                Command="{Binding DataContext.StartEditGroupCommand,
                                                                                    RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                                CommandParameter="{Binding}"/>
                                                                        <Button Grid.Column="2" Content="✕"
                                                                                Style="{StaticResource SmallIconBtn}"
                                                                                Width="30" Height="40" Foreground="#d44a4a"
                                                                                Command="{Binding DataContext.DeleteGroupCommand,
                                                                                    RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                                CommandParameter="{Binding}"/>
                                                                    </Grid>
                                                                    <!-- Tryb edycji -->
                                                                    <Grid Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="32"/>
                                                                            <ColumnDefinition Width="32"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBox Grid.Column="0"
                                                                                 Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                                                                 Style="{StaticResource DarkTextBox}"
                                                                                 FontSize="14" Height="32" Margin="0,4" Padding="4">
                                                                            <TextBox.InputBindings>
                                                                                <KeyBinding Key="Return"
                                                                                            Command="{Binding DataContext.SaveGroupCommand,
                                                                                                RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                                            CommandParameter="{Binding}"/>
                                                                            </TextBox.InputBindings>
                                                                        </TextBox>
                                                                        <Button Grid.Column="1" Content="✓"
                                                                                Style="{StaticResource SmallIconBtn}"
                                                                                Width="32" Height="40" Foreground="#6db76d"
                                                                                Command="{Binding DataContext.SaveGroupCommand,
                                                                                    RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                                CommandParameter="{Binding}"/>
                                                                        <Button Grid.Column="2" Content="✕"
                                                                                Style="{StaticResource SmallIconBtn}"
                                                                                Width="32" Height="40"
                                                                                Command="{Binding DataContext.CancelEditGroupCommand,
                                                                                    RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                                CommandParameter="{Binding}"/>
                                                                    </Grid>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                </Grid>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                    <!-- Pole nazwy zestawu -->
                                    <Grid Grid.Row="2" Margin="0,0,0,6">
                                        <TextBox Style="{StaticResource DarkTextBox}"
                                                 Text="{Binding SetlistName, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="18" Padding="3" Height="34"/>
                                        <TextBlock Text="{DynamicResource Placeholder.SetlistName}"
                                                   Foreground="#555d70" FontSize="18"
                                                   Padding="7,3" IsHitTestVisible="False" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SetlistName}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <!-- Przyciski -->
                                    <Grid Grid.Row="3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="{DynamicResource Btn.SaveSetlist}"
                                                Style="{StaticResource OutlineBtn}" Margin="0,0,7,0"
                                                Command="{Binding SaveSetlistCommand}"/>
                                        <Button Grid.Column="1" Margin="0,0,7,0"
                                                Style="{StaticResource OutlineBtn}"
                                                Command="{Binding TogglePinSetlistCommand}">
                                            <Button.Content>
                                                <TextBlock>
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="{DynamicResource Btn.PinSetlist}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCurrentSetlistPinned}" Value="True">
                                                                    <Setter Property="Text" Value="{DynamicResource Btn.UnpinSetlist}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Button.Content>
                                        </Button>
                                        <Button Grid.Column="2" Content="{DynamicResource Btn.Clear}"
                                                Style="{StaticResource RedBtn}"
                                                Command="{Binding ClearSetlistCommand}"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Panel edycji zwrotek -->
                            <Grid Grid.Row="0" Grid.RowSpan="4" Panel.ZIndex="10"
                                  Background="#1e2535"
                                  Visibility="{Binding IsInlineEditorOpen, Converter={StaticResource BoolToVis}}">

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Nagłówek -->
                                    <Border Grid.Row="0" Background="#161b25" BorderBrush="#2a3347"
                                            BorderThickness="0,0,0,1" Padding="12,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding InlineEditorTitle}"
                                                       FontSize="15" FontWeight="SemiBold"
                                                       Foreground="#e8eaf0"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>
                                            <Button Grid.Column="1" Content="×"
                                                    Background="Transparent" BorderThickness="0"
                                                    Foreground="#959fb9" FontSize="20" Cursor="Hand"
                                                    Command="{Binding CancelInlineEditCommand}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="Transparent" Padding="8,4">
                                                            <TextBlock Text="×" FontSize="20"
                                                                       Foreground="{TemplateBinding Foreground}"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Foreground" Value="#d44a4a"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <!-- Uwagi + Czcionka -->
                                    <Border Grid.Row="1" Padding="12,6" Background="#1e2535"
                                            BorderBrush="#2a3347" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- Uwagi -->
                                            <Grid Grid.Column="0">
                                                <TextBox Text="{Binding InlineEditorNotes, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource DarkTextBox}"
                                                         FontSize="13"/>
                                                <TextBlock Text="Uwagi (np. zwrotki 1,5,8)…"
                                                           Foreground="#556070" IsHitTestVisible="False"
                                                           Margin="7,0,0,0" VerticalAlignment="Center" FontSize="13">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding InlineEditorNotes}" Value="">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                            <!-- Czcionka min -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="Czcionka:" Foreground="#7080a0" FontSize="11"
                                                           VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBox Text="{Binding InlineEditorFontSize, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource DarkTextBox}"
                                                         FontSize="13" Width="50"
                                                         IsEnabled="{Binding InlineEditorFontSizeHard}"
                                                         ToolTip="{DynamicResource Inline.FontSizeTip}"/>
                                                <CheckBox IsChecked="{Binding InlineEditorFontSizeHard}"
                                                          Content="{DynamicResource Inline.FontSizeHard}"
                                                          Foreground="#9aa3b8" FontSize="11"
                                                          VerticalAlignment="Center" Margin="8,0,0,0"
                                                          ToolTip="{DynamicResource Inline.FontSizeHardTip}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Lista zwrotek do edycji -->
                                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding EditableVerses}"
                                                      Margin="8,4">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{Binding Label}"
                                                                       FontSize="11" Foreground="#c9a84c"
                                                                       Margin="0,0,0,3" FontWeight="SemiBold"/>
                                                            <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                                                     AcceptsReturn="True"
                                                                     TextWrapping="Wrap"
                                                                     MinHeight="60"
                                                                     FontSize="14"
                                                                     Padding="8,6"
                                                                     PreviewKeyDown="VerseTextBox_PreviewKeyDown"
                                                                     PreviewMouseLeftButtonDown="VerseTextBox_PreviewMouseLeftButtonDown">
                                                                <TextBox.Style>
                                                                    <Style TargetType="TextBox" BasedOn="{StaticResource DarkTextBox}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Type}" Value="img">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBox.Style>
                                                            </TextBox>
                                                            <!-- Podgląd obrazka (tylko odczyt w inline edytorze) -->
                                                            <TextBlock FontSize="14" FontStyle="Italic" Foreground="#9aa3b8"
                                                                       Padding="8,6">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Type}" Value="img">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                                <Run Text="🖼 " /><Run Text="{Binding ImagePath, Converter={StaticResource FileName}, Mode=OneWay}"/>
                                                            </TextBlock>
                                                            <!-- Tło per zwrotka (tylko dla zwrotek tekstowych) -->
                                                            <Grid Margin="0,4,0,0">
                                                                <Grid.Style>
                                                                    <Style TargetType="Grid">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Type}" Value="img">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Grid.Style>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="Tło:" Foreground="#7080a0" FontSize="11"
                                                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding BackgroundImagePath, Converter={StaticResource FileName}}"
                                                                           Foreground="#9aa3b8" FontSize="11" VerticalAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding BackgroundImagePath}" Value="{x:Null}">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <TextBlock Grid.Column="1" Text="—" Foreground="#556070" FontSize="11"
                                                                           VerticalAlignment="Center">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding BackgroundImagePath}" Value="{x:Null}">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <Button Grid.Column="2" Content="…" Width="26" Height="22" Margin="4,0,0,0"
                                                                        Style="{StaticResource SmallIconBtn}"
                                                                        ToolTip="Wybierz tło zwrotki"
                                                                        Command="{Binding DataContext.PickVerseBackgroundCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}"/>
                                                                <Button Grid.Column="3" Content="×" Width="22" Height="22" Margin="2,0,0,0"
                                                                        ToolTip="Usuń tło zwrotki"
                                                                        Command="{Binding DataContext.ClearVerseBackgroundCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}">
                                                                    <Button.Style>
                                                                        <Style TargetType="Button" BasedOn="{StaticResource SmallIconBtn}">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding BackgroundImagePath}" Value="{x:Null}">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Button.Style>
                                                                </Button>
                                                            </Grid>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="4,0,0,0">
                                                            <Button Content="↑" Width="28" Height="28" Margin="0,0,0,2"
                                                                    Style="{StaticResource SmallIconBtn}"
                                                                    Command="{Binding DataContext.MoveEditableVerseUpCommand,
                                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"/>
                                                            <Button Content="↓" Width="28" Height="28"
                                                                    Style="{StaticResource SmallIconBtn}"
                                                                    Command="{Binding DataContext.MoveEditableVerseDownCommand,
                                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <!-- Przyciski Zapisz / Anuluj -->
                                    <Border Grid.Row="3" Background="#161b25" BorderBrush="#2a3347"
                                            BorderThickness="0,1,0,0" Padding="8,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0"
                                                    Content="{DynamicResource Btn.Save}"
                                                    Style="{StaticResource OutlineBtn}"
                                                    Margin="0,0,7,0"
                                                    Command="{Binding SaveInlineEditCommand}"/>
                                            <Button Grid.Column="1"
                                                    Content="{DynamicResource Btn.CancelSettings}"
                                                    Style="{StaticResource RedBtn}"
                                                    Command="{Binding CancelInlineEditCommand}"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                    </Grid>
                </Grid>


            </Grid>

            <Grid x:Name="PaneCats"     Visibility="Collapsed" Background="#0f1117">
                <TextBlock Text="☰ KATEGORIE — wkrótce" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#959fb9" FontFamily="{StaticResource HeaderFont}" FontSize="16"/>
            </Grid>


            <!-- USTAWIENIA -->

            <Grid x:Name="PaneTemplate" Visibility="Collapsed" Background="#0f1117">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="400"/>
                    <ColumnDefinition Width="400"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="0"/>
                </Grid.ColumnDefinitions>

                <!-- COL 1: Ogólne + Ekran + Tagi -->
                <Border Grid.Row="0" Grid.Column="0" BorderBrush="#2a3347" BorderThickness="0,0,1,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="24,24,24,24">

                            <TextBlock Text="{DynamicResource Settings.SectionGeneral}" FontFamily="{StaticResource HeaderFont}"
                                       FontSize="20" FontWeight="SemiBold" Foreground="#c9a84c" Margin="0,0,0,16"/>

                            <CheckBox IsChecked="{Binding LoadLastSetlistOnStartup}"
                                      Style="{StaticResource DarkCheck}">
                                <TextBlock Text="{DynamicResource Settings.LoadLastSetlist}" Foreground="#e8eaf0" FontSize="16" TextWrapping="Wrap"/>
                            </CheckBox>
                            <CheckBox IsChecked="{Binding RunOnStartup}"
                                      Style="{StaticResource DarkCheck}" Margin="0,10,0,0">
                                <TextBlock Text="{DynamicResource Settings.RunOnStartup}" Foreground="#e8eaf0" FontSize="16" TextWrapping="Wrap"/>
                            </CheckBox>
                            <CheckBox IsChecked="{Binding FontAutoFit}"
                                      Style="{StaticResource DarkCheck}" Margin="0,10,0,0">
                                <TextBlock Text="{DynamicResource Settings.FontAutoFit}" Foreground="#e8eaf0" FontSize="16" TextWrapping="Wrap"/>
                            </CheckBox>

                            <TextBlock Text="{DynamicResource Settings.PsalmCategory}"
                                       Foreground="#959fb9" FontSize="14" TextWrapping="Wrap" Margin="0,16,0,4"/>
                            <ComboBox Style="{StaticResource DarkCombo}"
                                      ItemsSource="{Binding PsalmCategories}"
                                      SelectedItem="{Binding SelectedPsalmCategory}"
                                      FontSize="14" Height="34">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <Border BorderBrush="#2a3347" BorderThickness="0,1,0,0" Margin="0,20,0,20"/>

                            <TextBlock Text="{DynamicResource Settings.SectionDatabase}" FontFamily="{StaticResource HeaderFont}"
                                       FontSize="20" FontWeight="SemiBold" Foreground="#c9a84c" Margin="0,0,0,10"/>
                            <WrapPanel Margin="0,0,0,6">
                                <Button Content="{DynamicResource Settings.BackupDb}" Style="{StaticResource OutlineBtn}"
                                        Padding="10,6" Margin="0,0,6,6"
                                        Command="{Binding BackupDatabaseCommand}"/>
                                <Button Content="{DynamicResource Settings.RestoreDb}" Style="{StaticResource OutlineBtn}"
                                        Padding="10,6" Margin="0,0,6,6"
                                        Command="{Binding RestoreDatabaseCommand}"/>
                                <Button Content="{DynamicResource Settings.ClearDb}" Style="{StaticResource RedBtn}"
                                        Padding="10,6" Margin="0,0,0,6"
                                        Command="{Binding ClearDatabaseCommand}"/>
                            </WrapPanel>
                            <WrapPanel Margin="0,0,0,0">
                                <Button Content="{DynamicResource Settings.ExportZip}" Style="{StaticResource OutlineBtn}"
                                        Padding="10,6" Margin="0,0,6,6"
                                        Command="{Binding ExportZipCommand}"/>
                                <Button Content="{DynamicResource Settings.ImportZip}" Style="{StaticResource OutlineBtn}"
                                        Padding="10,6" Margin="0,0,0,6"
                                        Command="{Binding ImportZipCommand}"/>
                            </WrapPanel>
                            <WrapPanel Margin="0,6,0,0">
                                <Button Content="{DynamicResource Settings.ImportPsalmy}" Style="{StaticResource OutlineBtn}"
                                        Padding="10,6" Margin="0,0,0,6"
                                        Command="{Binding ImportPsalmyCommand}"
                                        IsEnabled="{Binding IsImportingPsalmy, Converter={StaticResource InverseBool}}"/>
                            </WrapPanel>

                            <Border BorderBrush="#2a3347" BorderThickness="0,1,0,0" Margin="0,20,0,20"/>

                            <TextBlock Text="{DynamicResource Settings.Screen}" FontFamily="{StaticResource HeaderFont}"
                                       FontSize="20" FontWeight="SemiBold" Foreground="#c9a84c" Margin="0,0,0,8"/>
                            <TextBlock Text="{DynamicResource Settings.ScreenLabel}"
                                       Foreground="#959fb9" FontSize="16" TextWrapping="Wrap" Margin="0,0,0,16"/>
                            <ListBox ItemsSource="{Binding Screens}"
                                     SelectedItem="{Binding SelectedScreen}"
                                     Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,0,0,8"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd" Background="#1e2535" BorderBrush="#2a3347"
                                                            BorderThickness="1" Padding="14,12" Cursor="Hand">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse x:Name="Dot" Width="10" Height="10"
                                                                     Fill="#2a3347" Margin="0,0,10,0"/>
                                                            <ContentPresenter VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#c9a84c"/>
                                                            <Setter TargetName="Dot" Property="Fill" Value="#c9a84c"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label, Mode=OneWay}" Foreground="#e8eaf0" FontSize="16"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="{DynamicResource Settings.Language}"
                                       Foreground="#959fb9" FontSize="16"
                                       FontFamily="{StaticResource HeaderFont}" FontWeight="SemiBold"
                                       Margin="0,16,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="Polski" Style="{StaticResource DarkRadio}" Margin="0,0,16,0"
                                             IsChecked="{Binding SelectedLanguage, Converter={StaticResource EnumBool}, ConverterParameter=pl}"
                                             Command="{Binding SetLanguageCommand}" CommandParameter="pl"/>
                                <RadioButton Content="English" Style="{StaticResource DarkRadio}" Margin="0,0,16,0"
                                             IsChecked="{Binding SelectedLanguage, Converter={StaticResource EnumBool}, ConverterParameter=en}"
                                             Command="{Binding SetLanguageCommand}" CommandParameter="en"/>
                                <RadioButton Content="Español" Style="{StaticResource DarkRadio}"
                                             IsChecked="{Binding SelectedLanguage, Converter={StaticResource EnumBool}, ConverterParameter=es}"
                                             Command="{Binding SetLanguageCommand}" CommandParameter="es"/>
                            </StackPanel>

                            <Border BorderBrush="#2a3347" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,20,0,0">
                                <Button Content="{DynamicResource Btn.OpenShortcuts}"
                                        Style="{StaticResource GoldBtn}"
                                        Height="50" FontSize="16"
                                        Click="OpenShortcuts_Click"/>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Border>


                <!-- COL 2: Pilot -->
                <Border Grid.Row="0" Grid.Column="1" BorderBrush="#2a3347" BorderThickness="0,0,1,0">
                    <views:RemoteControlTab x:Name="PilotPanel"/>
                </Border>
                <!-- COL 3: Import -->
                <Border x:Name="ImportColumn" Grid.Row="0" Grid.Column="2" BorderBrush="#2a3347" BorderThickness="0,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Kontrolki importu -->
                        <StackPanel Grid.Row="0" Margin="24,24,24,16">

                            <TextBlock Text="{DynamicResource Import.Title}"
                                       FontFamily="{StaticResource HeaderFont}"
                                       FontSize="20" FontWeight="SemiBold"
                                       Foreground="#c9a84c" Margin="0,0,0,16"/>

                            <!-- Format + Plik źródłowy obok siebie -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Format -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{DynamicResource Settings.Format}"
                                               FontFamily="{StaticResource HeaderFont}"
                                               FontSize="14" FontWeight="Light"
                                               Foreground="#c9a84c" Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <RadioButton Content="{DynamicResource Import.OpenLPSqlite}"
                                                     IsChecked="{Binding IsOpenLPSqlite, Mode=OneWay}"
                                                     Command="{Binding SelectFormatCommand}"
                                                     CommandParameter="OpenLPSqlite"
                                                     Foreground="#e8eaf0" FontSize="14"
                                                     Margin="0,0,12,0"/>
                                        <RadioButton Content="{DynamicResource Import.OpenLPXml}"
                                                     IsChecked="{Binding IsOpenLPXml, Mode=OneWay}"
                                                     Command="{Binding SelectFormatCommand}"
                                                     CommandParameter="OpenLPXml"
                                                     Foreground="#e8eaf0" FontSize="14"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Content="OpenSong (folder)"
                                                     IsChecked="{Binding IsOpenSongFolder, Mode=OneWay}"
                                                     Command="{Binding SelectFormatCommand}"
                                                     CommandParameter="OpenSongFolder"
                                                     Foreground="#e8eaf0" FontSize="14"
                                                     Margin="0,0,12,0"/>
                                        <RadioButton Content="OpenSong (xml)"
                                                     IsChecked="{Binding IsOpenSongXml, Mode=OneWay}"
                                                     Command="{Binding SelectFormatCommand}"
                                                     CommandParameter="OpenSongXml"
                                                     Foreground="#e8eaf0" FontSize="14"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Plik źródłowy -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{DynamicResource Import.Source}"
                                               FontFamily="{StaticResource HeaderFont}"
                                               FontSize="14" FontWeight="Light"
                                               Foreground="#c9a84c" Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#1e2535" BorderBrush="#2a3347"
                                                BorderThickness="1,1,0,1" Padding="10,8">
                                            <TextBlock Text="{Binding FilePathLabel}"
                                                       Foreground="#e8eaf0" FontSize="13"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding FilePath}" Value="">
                                                                <Setter Property="Foreground" Value="#959fb9"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <Button Grid.Column="1" Content="{DynamicResource Btn.Browse}"
                                                Style="{StaticResource GoldBtn}"
                                                Padding="14,8"
                                                Command="{Binding BrowseCommand}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="#c9a84c" BorderThickness="1"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#e8c97a"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <!-- Opcje -->
                            <TextBlock Text="{DynamicResource Import.Options}"
                                       FontFamily="{StaticResource HeaderFont}"
                                       FontSize="14" FontWeight="Light"
                                       Foreground="#c9a84c" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#1e2535" BorderBrush="#2a3347"
                                        BorderThickness="1" Padding="14,10">
                                    <StackPanel>
                                        <CheckBox IsChecked="{Binding ImportCategories}"
                                                  Foreground="#e8eaf0" FontSize="15"
                                                  Margin="0,0,0,3">
                                            <TextBlock Text="{DynamicResource Import.ImportCategories}" Foreground="#e8eaf0" FontSize="15"/>
                                        </CheckBox>
                                        <TextBlock Text="{DynamicResource Import.ImportCategoriesTip}"
                                                   Foreground="#959fb9" FontSize="12" Margin="22,0,0,0"
                                                   TextWrapping="Wrap"/>
                                        <StackPanel Margin="22,6,0,0"
                                                    Visibility="{Binding ShowCategorySourceSelector, Converter={StaticResource BoolToVis}}">
                                            <RadioButton Content="{DynamicResource Import.CategorySourceSongBooks}"
                                                         IsChecked="{Binding IsCategorySourceSongBooks, Mode=OneWay}"
                                                         Command="{Binding SelectCategorySourceCommand}"
                                                         CommandParameter="SongBooks"
                                                         Foreground="#e8eaf0" FontSize="13" Margin="0,0,0,2"/>
                                            <RadioButton Content="{DynamicResource Import.CategorySourceTopics}"
                                                         IsChecked="{Binding IsCategorySourceTopics, Mode=OneWay}"
                                                         Command="{Binding SelectCategorySourceCommand}"
                                                         CommandParameter="Topics"
                                                         Foreground="#e8eaf0" FontSize="13"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Background="#1e2535" BorderBrush="#2a3347"
                                        BorderThickness="1" Padding="14,10">
                                    <StackPanel>
                                        <CheckBox IsChecked="{Binding OverwriteExisting}"
                                                  Foreground="#e8eaf0" FontSize="15"
                                                  Margin="0,0,0,3">
                                            <TextBlock Text="{DynamicResource Import.Overwrite}" Foreground="#e8eaf0" FontSize="15"/>
                                        </CheckBox>
                                        <TextBlock Text="{DynamicResource Import.OverwriteTip}"
                                                   Foreground="#959fb9" FontSize="12" Margin="22,0,0,0"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Kategoria domyślna -->
                            <Border Background="#1e2535" BorderBrush="#2a3347"
                                    BorderThickness="1" Padding="14,10" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{DynamicResource Import.FallbackCategory}"
                                                   Foreground="#e8eaf0" FontSize="15"/>
                                        <TextBlock Text="{DynamicResource Import.FallbackCategoryTip}"
                                                   Foreground="#959fb9" FontSize="12"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1"
                                              Style="{StaticResource DarkCombo}"
                                              ItemsSource="{Binding CategoriesForImport}"
                                              SelectedItem="{Binding FallbackCategory}"
                                              DisplayMemberPath="Name"
                                              Height="38" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Import z OSZ (3 kolumny) -->
                            <Border Background="#161b25" BorderBrush="#2a3347" BorderThickness="1"
                                    Padding="14,12" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="ZESTAWY OPENLP (.OSZ)"
                                               FontFamily="{StaticResource HeaderFont}"
                                               FontSize="14" FontWeight="Light"
                                               Foreground="#c9a84c" Margin="0,0,0,10"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource Groups.Target}"
                                                   Foreground="#8899aa" FontSize="15"
                                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <ComboBox Grid.Column="1"
                                                  Style="{StaticResource DarkCombo}"
                                                  ItemsSource="{Binding OszGroups}"
                                                  SelectedItem="{Binding OszSelectedGroup}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Button Grid.Column="2" Content="{DynamicResource Btn.ImportOsz}"
                                                Style="{StaticResource GoldBtn}"
                                                Height="36" Padding="14,0" Margin="8,0,0,0"
                                                Command="{Binding ImportOszCommand}"/>
                                    </Grid>
                                    <TextBlock Text="{Binding OszStatus}"
                                               Foreground="#8899aa" FontSize="14"
                                               Margin="0,8,0,0" TextWrapping="Wrap"
                                               Visibility="{Binding OszStatus, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </Border>

                            <!-- Podgląd -->
                            <Button Content="{DynamicResource Btn.Preview}"
                                    Style="{StaticResource OutlineBtn}"
                                    Height="44" Margin="0,0,0,8"
                                    Command="{Binding PreviewCommand}"/>

                            <!-- Importuj -->
                            <Button Content="{DynamicResource Btn.Import}"
                                    Height="54" FontSize="28" Padding="0"
                                    Command="{Binding ImportCommand}"
                                    IsEnabled="{Binding IsImporting, Converter={StaticResource BoolToVis}}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource GoldBtn}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsImporting}" Value="True">
                                                <Setter Property="Background" Value="#3a4a65"/>
                                                <Setter Property="Foreground" Value="#959fb9"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Border Margin="0,10,0,0"
                                    Visibility="{Binding IsImporting, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding ProgressText}"
                                               Foreground="#9aa3b8" FontSize="11"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,0,0,6"/>
                                    <ProgressBar Value="{Binding ProgressValue}"
                                                 Maximum="{Binding ProgressMax}"
                                                 Height="6" Background="#1e2535"
                                                 Foreground="#c9a84c" BorderThickness="0"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>

                        <!-- Log -->
                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#161b25" BorderBrush="#2a3347"
                                    BorderThickness="0,1,0,1" Padding="24,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{DynamicResource Import.Log}"
                                               FontFamily="{StaticResource HeaderFont}"
                                               FontSize="14" FontWeight="Light"
                                               Foreground="#c9a84c" Margin="0,0,12,0"/>
                                    <TextBlock Text="{Binding LogEntries.Count, StringFormat='({0} wpisów)'}"
                                               Foreground="#959fb9" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Hidden"
                                          Padding="24,12">
                                <ItemsControl ItemsSource="{Binding LogEntries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="18"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Icon}"
                                                           Foreground="{Binding Color}" FontSize="12"
                                                           VerticalAlignment="Top"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Message}"
                                                           Foreground="{Binding Color}" FontSize="12"
                                                           TextWrapping="Wrap" LineHeight="18"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                    </Grid>
                </Border>

                <!-- placeholder dla DataContext (unused) -->
                <Grid x:Name="ImportLogColumn" Grid.Row="0" Grid.Column="3" Visibility="Collapsed"/>

                <!-- Shared Save Bar -->
                <Border Grid.Row="1" Grid.ColumnSpan="4" BorderBrush="#2a3347" BorderThickness="0,1,0,0" Padding="20,14">
                    <Button Content="{DynamicResource Btn.SaveSettings}"
                            Style="{StaticResource GoldBtn}" Height="50" FontSize="30"
                            Click="SaveAllSettings_Click" Padding="0"/>
                </Border>

            </Grid>

            <!-- WYGLĄD -->

            <Grid x:Name="PaneImport" Visibility="Collapsed" Background="#0f1117">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="440"/>
                </Grid.ColumnDefinitions>

                <!-- COL 1: Czcionka -->
                <Border Grid.Row="0" Grid.Column="0" BorderBrush="#2a3347" BorderThickness="0,0,1,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Padding="24,24,24,0">
                        <StackPanel>

                            <TextBlock Text="{DynamicResource Settings.SectionFont}" FontFamily="{StaticResource HeaderFont}"
                                       FontSize="20" FontWeight="SemiBold" Foreground="#c9a84c" Margin="0,0,0,16"/>

                            <TextBlock Text="{Binding FontSizeLabel}" Foreground="#959fb9" FontSize="16"
                                       FontFamily="{StaticResource HeaderFont}" FontWeight="Light"
                                       Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <Slider Grid.Column="0" Style="{StaticResource DarkSlider}"
                                        Minimum="10" Maximum="200" TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        Value="{Binding FontSize}" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Background="#1e2535" BorderBrush="#2a3347"
                                        BorderThickness="1" Padding="6,4">
                                    <TextBox Text="{Binding FontSize, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:F0}'}"
                                             Style="{StaticResource DarkTextBox}"
                                             Background="Transparent" BorderThickness="0"
                                             Foreground="#c9a84c" FontSize="16" FontWeight="Bold"
                                             Padding="0" TextAlignment="Center"
                                             helpers:NumericBox.IsEnabled="True"
                                             helpers:NumericBox.Min="10"
                                             helpers:NumericBox.Max="200"
                                             helpers:NumericBox.Step="1"/>
                                </Border>
                            </Grid>

                            <TextBlock Text="{DynamicResource Settings.FontFamily}" Foreground="#959fb9" FontSize="16"
                                       FontFamily="{StaticResource HeaderFont}" FontWeight="Light"
                                       Margin="0,0,0,8"/>
                            <ComboBox Style="{StaticResource DarkCombo}"
                                      IsEditable="True"
                                      IsTextSearchEnabled="True"
                                      TextSearch.TextPath="Name"
                                      DisplayMemberPath="Name"
                                      Margin="0,0,0,16">
                                <ComboBox.ItemsSource>
                                    <Binding Path="FontsView"/>
                                </ComboBox.ItemsSource>
                                <ComboBox.Text>
                                    <Binding Path="FontFamily" UpdateSourceTrigger="PropertyChanged"/>
                                </ComboBox.Text>
                                <ComboBox.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="#c9a84c"
                                                           FontFamily="{StaticResource HeaderFont}"
                                                           FontSize="13"
                                                           FontWeight="Bold"
                                                           Margin="6,8,6,4"/>
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ComboBox.GroupStyle>
                            </ComboBox>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{DynamicResource Settings.Bold}" Foreground="#959fb9" FontSize="16"
                                               FontFamily="{StaticResource HeaderFont}" FontWeight="Light"
                                               Margin="0,0,0,10"/>
                                    <CheckBox IsChecked="{Binding FontBold}" Style="{StaticResource DarkCheck}">
                                        <TextBlock Text="{DynamicResource Settings.Bold}" Foreground="#e8eaf0" FontSize="16"/>
                                    </CheckBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{DynamicResource Settings.Alignment}" Foreground="#959fb9" FontSize="16"
                                               FontFamily="{StaticResource HeaderFont}" FontWeight="Light"
                                               Margin="0,0,0,10"/>
                                    <StackPanel Orientation="Horizontal">
                                        <ToggleButton Style="{StaticResource AlignBtn}" Margin="0,0,4,0"
                                                      IsChecked="{Binding TextAlign, Converter={StaticResource EnumBool}, ConverterParameter=left}"
                                                      Command="{Binding SetTextAlignCommand}" CommandParameter="left"
                                                      ToolTip="{DynamicResource Tooltip.ToLeft}">
                                            <TextBlock Text="&#x2B05;" FontSize="20" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                                        </ToggleButton>
                                        <ToggleButton Style="{StaticResource AlignBtn}" Margin="0,0,4,0"
                                                      IsChecked="{Binding TextAlign, Converter={StaticResource EnumBool}, ConverterParameter=center}"
                                                      Command="{Binding SetTextAlignCommand}" CommandParameter="center"
                                                      ToolTip="{DynamicResource Settings.AlignCenter}">
                                            <TextBlock Text="&#x2630;" FontSize="20" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                                        </ToggleButton>
                                        <ToggleButton Style="{StaticResource AlignBtn}"
                                                      IsChecked="{Binding TextAlign, Converter={StaticResource EnumBool}, ConverterParameter=right}"
                                                      Command="{Binding SetTextAlignCommand}" CommandParameter="right"
                                                      ToolTip="{DynamicResource Tooltip.ToRight}">
                                            <TextBlock Text="&#x27A1;" FontSize="20" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                                        </ToggleButton>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="{DynamicResource Settings.LineSpacing}" Foreground="#959fb9" FontSize="16"
                                       FontFamily="{StaticResource HeaderFont}" FontWeight="Light"
                                       Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <Slider Grid.Column="0" Style="{StaticResource DarkSlider}"
                                        Minimum="1.3" Maximum="2.5" TickFrequency="0.05"
                                        Value="{Binding LineHeightMultiplier}" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Background="#1e2535" BorderBrush="#2a3347"
                                        BorderThickness="1" Padding="6,4">
                                    <TextBox Text="{Binding LineHeightMultiplier, UpdateSourceTrigger=PropertyChanged, StringFormat='&#xD7;{0:F2}'}"
                                             Style="{StaticResource DarkTextBox}"
                                             Background="Transparent" BorderThickness="0"
                                             Foreground="#9aa3b8" FontSize="16"
                                             Padding="0" TextAlignment="Center"
                                             helpers:NumericBox.IsEnabled="True"
                                             helpers:NumericBox.Min="1.3"
                                             helpers:NumericBox.Max="2.5"
                                             helpers:NumericBox.Step="0.05"
                                             helpers:NumericBox.Decimals="2"/>
                                </Border>
                            </Grid>

                            <TextBlock Text="{DynamicResource Settings.Alignment}" Foreground="#959fb9" FontSize="16"
                                       FontFamily="{StaticResource HeaderFont}" FontWeight="Light"
                                       Margin="0,16,0,12"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <RadioButton Content="{DynamicResource Settings.AlignTop}" Style="{StaticResource DarkRadio}" Margin="0,0,20,0"
                                             IsChecked="{Binding TextPosition, Converter={StaticResource EnumBool}, ConverterParameter=top}"
                                             Command="{Binding SetTextPositionCommand}" CommandParameter="top"/>
                                <RadioButton Content="{DynamicResource Settings.AlignMiddle}" Style="{StaticResource DarkRadio}" Margin="0,0,20,0"
                                             IsChecked="{Binding TextPosition, Converter={StaticResource EnumBool}, ConverterParameter=center}"
                                             Command="{Binding SetTextPositionCommand}" CommandParameter="center"/>
                                <RadioButton Content="{DynamicResource Settings.AlignBottom}" Style="{StaticResource DarkRadio}"
                                             IsChecked="{Binding TextPosition, Converter={StaticResource EnumBool}, ConverterParameter=bottom}"
                                             Command="{Binding SetTextPositionCommand}" CommandParameter="bottom"/>
                            </StackPanel>

                            <TextBlock Text="{DynamicResource Settings.Margins}" Foreground="#959fb9" FontSize="16"
                                       FontFamily="{StaticResource HeaderFont}" FontWeight="Light"
                                       Margin="0,0,0,12"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="{DynamicResource Settings.AlignH}"
                                           Foreground="#959fb9" FontSize="16" Margin="0,0,0,6"/>
                                <Slider Grid.Row="2" Grid.Column="0" Style="{StaticResource DarkSlider}"
                                        Minimum="0" Maximum="300" TickFrequency="5"
                                        IsSnapToTickEnabled="True"
                                        Value="{Binding TextMarginH}" VerticalAlignment="Center"/>
                                <Border Grid.Row="2" Grid.Column="2" Background="#1e2535" BorderBrush="#2a3347"
                                        BorderThickness="1" Padding="6,4">
                                    <TextBox Text="{Binding TextMarginH, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:F0}'}"
                                             Style="{StaticResource DarkTextBox}"
                                             Background="Transparent" BorderThickness="0"
                                             Foreground="#c9a84c" FontSize="13" FontWeight="Bold"
                                             Padding="0" TextAlignment="Center"
                                             helpers:NumericBox.IsEnabled="True"
                                             helpers:NumericBox.Min="0"
                                             helpers:NumericBox.Max="300"
                                             helpers:NumericBox.Step="5"/>
                                </Border>
                            </Grid>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="{DynamicResource Settings.AlignV}"
                                           Foreground="#959fb9" FontSize="16" Margin="0,0,0,6"/>
                                <Slider Grid.Row="2" Grid.Column="0" Style="{StaticResource DarkSlider}"
                                        Minimum="0" Maximum="200" TickFrequency="5"
                                        IsSnapToTickEnabled="True"
                                        Value="{Binding TextMarginV}" VerticalAlignment="Center"/>
                                <Border Grid.Row="2" Grid.Column="2" Background="#1e2535" BorderBrush="#2a3347"
                                        BorderThickness="1" Padding="6,4">
                                    <TextBox Text="{Binding TextMarginV, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:F0}'}"
                                             Style="{StaticResource DarkTextBox}"
                                             Background="Transparent" BorderThickness="0"
                                             Foreground="#c9a84c" FontSize="13" FontWeight="Bold"
                                             Padding="0" TextAlignment="Center"
                                             helpers:NumericBox.IsEnabled="True"
                                             helpers:NumericBox.Min="0"
                                             helpers:NumericBox.Max="200"
                                             helpers:NumericBox.Step="5"/>
                                </Border>
                            </Grid>

                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- COL 2: Kolory -->
                <Border Grid.Row="0" Grid.Column="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Padding="24,24,24,0">
                        <StackPanel>

                            <TextBlock Text="{DynamicResource Settings.SectionColors}" FontFamily="{StaticResource HeaderFont}"
                                       FontSize="20" FontWeight="SemiBold" Foreground="#c9a84c" Margin="0,0,0,16"/>

                            <TextBlock Text="{DynamicResource Settings.TextColor}" Foreground="#959fb9" FontSize="16"
                                       FontFamily="{StaticResource HeaderFont}" FontWeight="Light"
                                       Margin="0,0,0,10"/>
                            <ItemsControl ItemsSource="{Binding TextPresets}" Margin="0,0,0,10">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Width="40" Height="40" Margin="0,0,6,6" ToolTip="{Binding Label, Mode=OneWay}"
                                                Command="{Binding DataContext.SetTextColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding Hex}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{Binding Brush}"
                                                            BorderBrush="#2a3347" BorderThickness="2">
                                                        <Border.Effect>
                                                            <DropShadowEffect ShadowDepth="0" BlurRadius="6" Opacity=".3"/>
                                                        </Border.Effect>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Opacity" Value="0.8"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <TextBlock Text="{DynamicResource Settings.Custom}" Foreground="#959fb9" FontSize="16"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Button Width="32" Height="32" Margin="0,0,10,0" Cursor="Hand"
                                        ToolTip="{DynamicResource Btn.PickColor}" Command="{Binding PickTextColorCommand}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{Binding TextColorSwatch}"
                                                    BorderBrush="#2a3347" BorderThickness="1"/>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <TextBox Text="{Binding TextColor, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource DarkTextBox}" Width="100"
                                         FontFamily="Consolas" FontSize="13"/>
                            </StackPanel>

                            <TextBlock Text="{DynamicResource Settings.Shadow}" Foreground="#959fb9" FontSize="16"
                                       FontFamily="{StaticResource HeaderFont}" FontWeight="Light"
                                       Margin="0,0,0,10"/>
                            <CheckBox IsChecked="{Binding ShadowEnabled}" Style="{StaticResource DarkCheck}"
                                      Margin="0,0,0,12">
                                <TextBlock Text="{DynamicResource Settings.ShadowEnable}" Foreground="#e8eaf0" FontSize="16"/>
                            </CheckBox>
                            <Grid IsEnabled="{Binding ShadowEnabled}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="{DynamicResource Settings.ShadowBlur}" Foreground="#959fb9" FontSize="16" Margin="0,0,0,4"/>
                                    <Slider Style="{StaticResource DarkSlider}" Minimum="0" Maximum="30" Value="{Binding ShadowBlur}"/>
                                    <TextBlock Text="{Binding ShadowBlur, StringFormat='{}{0:F0}'}" Foreground="#9aa3b8" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <TextBlock Text="{DynamicResource Settings.ShadowDepth}" Foreground="#959fb9" FontSize="16" Margin="0,0,0,4"/>
                                    <Slider Style="{StaticResource DarkSlider}" Minimum="0" Maximum="15" Value="{Binding ShadowDepth}"/>
                                    <TextBlock Text="{Binding ShadowDepth, StringFormat='{}{0:F0}'}" Foreground="#9aa3b8" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="0">
                                    <TextBlock Text="{DynamicResource Settings.Opacity}" Foreground="#959fb9" FontSize="16" Margin="0,0,0,4"/>
                                    <Slider Style="{StaticResource DarkSlider}" Minimum="0" Maximum="1" Value="{Binding ShadowOpacity}"/>
                                    <TextBlock Text="{Binding ShadowOpacity, StringFormat='{}{0:P0}'}" Foreground="#9aa3b8" FontSize="11"/>
                                </StackPanel>
                            </Grid>

                            <Border BorderBrush="#2a3347" BorderThickness="0,1,0,0" Margin="0,16,0,16"/>

                            <TextBlock Text="{DynamicResource Settings.BgColor}" Foreground="#959fb9" FontSize="16"
                                       FontFamily="{StaticResource HeaderFont}" FontWeight="Light"
                                       Margin="0,0,0,10"/>
                            <ItemsControl ItemsSource="{Binding BgPresets}" Margin="0,0,0,10">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Width="40" Height="40" Margin="0,0,6,6" ToolTip="{Binding Label, Mode=OneWay}"
                                                Command="{Binding DataContext.SetBgColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding Hex}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{Binding Brush}"
                                                            BorderBrush="#555" BorderThickness="2"/>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Opacity" Value="0.8"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                                <TextBlock Text="{DynamicResource Settings.Custom}" Foreground="#959fb9" FontSize="16"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Button Width="32" Height="32" Margin="0,0,10,0" Cursor="Hand"
                                        ToolTip="{DynamicResource Btn.PickColor}" Command="{Binding PickBgColorCommand}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{Binding BgColorSwatch}"
                                                    BorderBrush="#555" BorderThickness="1"/>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <TextBox Text="{Binding BackgroundColor, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource DarkTextBox}" Width="100"
                                         FontFamily="Consolas" FontSize="13"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,24">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="{DynamicResource Settings.BgGradient}" Foreground="#959fb9" FontSize="16"
                                               FontFamily="{StaticResource HeaderFont}" FontWeight="Light"
                                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <CheckBox IsChecked="{Binding GradientEnabled}"
                                              Foreground="#e8eaf0" FontSize="16"
                                              VerticalAlignment="Center"
                                              Content="{DynamicResource Btn.Enable}"/>
                                </StackPanel>
                                <StackPanel Visibility="{Binding GradientEnabled, Converter={StaticResource BoolToVis}}">
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{DynamicResource Settings.GradientColor1}" Foreground="#959fb9" FontSize="16" Margin="0,0,0,4"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Width="44" Height="44" Margin="0,0,6,0" Cursor="Hand"
                                                        ToolTip="{DynamicResource Btn.PickColor}" Command="{Binding PickGradientColor1Command}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{Binding GradientColor1Swatch}"
                                                                    BorderBrush="#555" BorderThickness="1"/>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                                <TextBox Text="{Binding GradientColor1, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource DarkTextBox}"
                                                         Width="90" FontFamily="Consolas" FontSize="16"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{DynamicResource Settings.GradientColor2}" Foreground="#959fb9" FontSize="16" Margin="0,0,0,4"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Width="44" Height="44" Margin="0,0,6,0" Cursor="Hand"
                                                        ToolTip="{DynamicResource Btn.PickColor}" Command="{Binding PickGradientColor2Command}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{Binding GradientColor2Swatch}"
                                                                    BorderBrush="#555" BorderThickness="1"/>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                                <TextBox Text="{Binding GradientColor2, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource DarkTextBox}"
                                                         Width="90" FontFamily="Consolas" FontSize="16"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Button Content="{DynamicResource Settings.GradientLinear}" Height="30" Padding="14" Margin="0,0,6,0"
                                                Command="{Binding SetGradientTypeCommand}" CommandParameter="linear" FontSize="16">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="#1e2535"/>
                                                    <Setter Property="Foreground" Value="#959fb9"/>
                                                    <Setter Property="BorderBrush" Value="#2a3347"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}"
                                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                                        CornerRadius="4">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding GradientType}" Value="linear">
                                                            <Setter Property="Background" Value="#c9a84c"/>
                                                            <Setter Property="Foreground" Value="#0f1117"/>
                                                            <Setter Property="BorderBrush" Value="#c9a84c"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="{DynamicResource Settings.GradientRadial}" Height="30" Padding="14,0" FontSize="16"
                                                Command="{Binding SetGradientTypeCommand}" CommandParameter="radial">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="#1e2535"/>
                                                    <Setter Property="Foreground" Value="#959fb9"/>
                                                    <Setter Property="BorderBrush" Value="#2a3347"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}"
                                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                                        CornerRadius="4">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding GradientType}" Value="radial">
                                                            <Setter Property="Background" Value="#c9a84c"/>
                                                            <Setter Property="Foreground" Value="#0f1117"/>
                                                            <Setter Property="BorderBrush" Value="#c9a84c"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                    <StackPanel Visibility="{Binding IsLinearGradient, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{DynamicResource Settings.GradientAngle}" Foreground="#959fb9" FontSize="16" Margin="0,0,0,4"/>
                                        <Slider Style="{StaticResource DarkSlider}" Minimum="0" Maximum="360"
                                                Value="{Binding GradientAngle}" TickFrequency="45"/>
                                        <TextBlock Text="{Binding GradientAngle, StringFormat='{}{0:F0}°'}"
                                                   Foreground="#9aa3b8" FontSize="14" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="{DynamicResource Settings.BgImage}" Foreground="#959fb9" FontSize="16"
                                       FontFamily="{StaticResource HeaderFont}" FontWeight="Light"
                                       Margin="0,0,0,10"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#1e2535" BorderBrush="#2a3347"
                                        BorderThickness="1" Padding="10,8">
                                    <TextBlock TextTrimming="CharacterEllipsis" FontSize="16">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text"       Value="{Binding BackgroundImagePath}"/>
                                                <Setter Property="Foreground" Value="#9aa3b8"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding BackgroundImagePath}" Value="{x:Null}">
                                                        <Setter Property="Text"       Value="{DynamicResource Settings.NoImage}"/>
                                                        <Setter Property="Foreground" Value="#959fb9"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <Button Grid.Column="2" Content="{DynamicResource Btn.Browse}" Style="{StaticResource GoldBtn}"
                                        Padding="12,8" Command="{Binding BrowseBackgroundCommand}"/>
                                <Button Grid.Column="4" Content="&#x2715;" Style="{StaticResource RedBtn}"
                                        Padding="10,8" Command="{Binding ClearBackgroundCommand}"/>
                            </Grid>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="{DynamicResource Settings.BgImageOpacity}" Foreground="#959fb9" FontSize="11" Margin="0,0,0,6"/>
                                <Slider Style="{StaticResource DarkSlider}" Minimum="0" Maximum="1"
                                        Value="{Binding BackgroundImageOpacity}"/>
                                <TextBlock Text="{Binding BackgroundImageOpacity, StringFormat='{}{0:P0}'}"
                                           Foreground="#9aa3b8" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- COL 3: Tagi formatowania + Podgląd -->
                <Border Grid.Row="0" Grid.Column="2" BorderBrush="#2a3347" BorderThickness="1,0,0,0"
                        Background="#0a0d14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Tagi formatowania -->
                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="20,20,20,8">

                                <TextBlock Text="{DynamicResource Settings.Tags}" FontFamily="{StaticResource HeaderFont}"
                                           FontSize="20" FontWeight="SemiBold" Foreground="#c9a84c" Margin="0,0,0,12"/>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="42"/>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="36"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{DynamicResource Settings.TagName}" Foreground="#555f7a" FontSize="13"/>
                                    <TextBlock Grid.Column="1" Text="{DynamicResource Settings.TagColorHeader}" Foreground="#555f7a" FontSize="13"/>
                                    <TextBlock Grid.Column="2" Text="B" Foreground="#555f7a" FontSize="13" TextAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="I" Foreground="#555f7a" FontSize="13" TextAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="U" Foreground="#555f7a" FontSize="13" TextAlignment="Center"/>
                                    <TextBlock Grid.Column="5" Text="P" Foreground="#555f7a" FontSize="13" TextAlignment="Center"
                                               ToolTip="{DynamicResource Settings.TagPreviewOnlyTip}"/>
                                    <TextBlock Grid.Column="7" Text="Ctrl+" Foreground="#555f7a" FontSize="13"
                                               ToolTip="{DynamicResource Settings.TagShortcutTip}"/>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding TextTags}" Margin="0,0,0,10">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="36"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="30"/>
                                                    <ColumnDefinition Width="30"/>
                                                    <ColumnDefinition Width="30"/>
                                                    <ColumnDefinition Width="30"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="30"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0"
                                                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource DarkTextBox}"
                                                         FontFamily="Consolas" FontSize="14" Padding="6,4"/>
                                                <Button Grid.Column="2" Width="36" Height="34" Cursor="Hand"
                                                        ToolTip="{DynamicResource Btn.PickColor}"
                                                        Command="{Binding DataContext.PickTagColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border BorderBrush="#555" BorderThickness="1">
                                                                <Border.Background>
                                                                    <SolidColorBrush Color="{Binding Color, Converter={StaticResource HexToColor}, FallbackValue=White}"/>
                                                                </Border.Background>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Opacity" Value="0.8"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                                <CheckBox Grid.Column="4" IsChecked="{Binding Bold}"
                                                          VerticalAlignment="Center" HorizontalAlignment="Center"
                                                          Foreground="#e8eaf0"/>
                                                <CheckBox Grid.Column="5" IsChecked="{Binding Italic}"
                                                          VerticalAlignment="Center" HorizontalAlignment="Center"
                                                          Foreground="#e8eaf0"/>
                                                <CheckBox Grid.Column="6" IsChecked="{Binding Underline}"
                                                          VerticalAlignment="Center" HorizontalAlignment="Center"
                                                          Foreground="#e8eaf0"/>
                                                <CheckBox Grid.Column="7" IsChecked="{Binding PreviewOnly}"
                                                          VerticalAlignment="Center" HorizontalAlignment="Center"
                                                          Foreground="#e8eaf0"
                                                          ToolTip="{DynamicResource Settings.TagPreviewOnlyTip}"/>
                                                <TextBox Grid.Column="9"
                                                         Text="{Binding ShortcutKey, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource DarkTextBox}"
                                                         FontFamily="Consolas" FontSize="14" Padding="4,4"
                                                         TextAlignment="Center"
                                                         ToolTip="{DynamicResource Settings.TagShortcutInput}"
                                                         helpers:KeyCaptureHelper.IsEnabled="True"/>
                                                <Button Grid.Column="11" Content="&#x2715;" Width="30" Height="30"
                                                        Style="{StaticResource RedBtn}"
                                                        Command="{Binding DataContext.RemoveTagCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Padding="0" FontSize="14"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button Content="{DynamicResource Settings.TagAdd}" Style="{StaticResource GoldBtn}"
                                        Command="{Binding AddTagCommand}"
                                        Height="36" Padding="16,0" HorizontalAlignment="Left"
                                        FontSize="14" Margin="0,0,0,16"/>

                                <Border Background="#1e2535" BorderBrush="#2a3347" BorderThickness="1"
                                        Padding="12,10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Settings.TagsSyntax}" Foreground="#9aa3b8"
                                                   FontFamily="Consolas" FontSize="13" Margin="0,0,0,4"/>
                                        <TextBlock Text="{DynamicResource Settings.TagsBuiltin}"
                                                   Foreground="#9aa3b8" FontFamily="Consolas" FontSize="13"/>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>

                        <!-- Podgląd -->
                        <StackPanel Grid.Row="1" Margin="20,8,20,20">
                            <TextBlock Text="{DynamicResource Settings.SectionPreview}" FontFamily="{StaticResource HeaderFont}"
                                       FontSize="20" FontWeight="SemiBold" Foreground="#c9a84c" Margin="0,0,0,12"/>
                            <Border Background="{Binding PreviewProjection.BackgroundBrush}"
                                    BorderBrush="#2a3347" BorderThickness="1"
                                    ClipToBounds="True"
                                    Height="{Binding ActualWidth, RelativeSource={RelativeSource Self},
                                             Converter={StaticResource WidthToHeight}}">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000" ShadowDepth="0" BlurRadius="16" Opacity=".6"/>
                                </Border.Effect>
                                <Viewbox Stretch="Uniform">
                                    <views:ProjectionView
                                        DataContext="{Binding PreviewProjection}"
                                        IsPreviewMode="True"
                                        Width="{Binding DataContext.ProjectionScreenWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Height="{Binding DataContext.ProjectionScreenHeight, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                </Viewbox>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Save Bar -->
                <Border Grid.Row="1" Grid.ColumnSpan="3" BorderBrush="#2a3347" BorderThickness="0,1,0,0" Padding="20,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="{DynamicResource Btn.SaveSettings}"
                                Style="{StaticResource GoldBtn}" Height="50" FontSize="30"
                                Click="SaveWyglad_Click" Padding="0"/>
                        <Button Grid.Column="2" Content="{DynamicResource Btn.ResetSettings}"
                                Style="{StaticResource RedBtn}" Height="42" Padding="10,0"
                                Command="{Binding ResetCommand}"/>
                    </Grid>
                </Border>

            </Grid>

            <!-- TAB: O PROGRAMIE -->
            <Grid x:Name="PaneAbout" Visibility="Collapsed" Background="#0f1117">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="420">

                    <!-- Nazwa -->
                    <TextBlock Text="Cantio" FontFamily="{StaticResource HeaderFont}" FontSize="56"
                               Foreground="#c9a84c" HorizontalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource About.Subtitle}"
                               Foreground="#8a8e9e" FontSize="14" HorizontalAlignment="Center"
                               Margin="0,4,0,28"/>

                    <!-- Wersja + sprawdź aktualizacje -->
                    <Border Background="#181b24" CornerRadius="6" Padding="16,14" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Foreground="#e8eaf0" FontSize="14">
                                    <Run Text="{DynamicResource About.Version}"/>
                                    <Run Text=" "/>
                                    <Run Text="{Binding AppVersion, Mode=OneWay}" FontWeight="Bold" Foreground="#c9a84c"/>
                                </TextBlock>
                                <TextBlock FontSize="12" Margin="0,5,0,0"
                                           Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVis}}">
                                    <Run Text="{DynamicResource About.UpdateAvailable}" Foreground="#f0b040"/>
                                    <Run Text=" "/>
                                    <Run Text="{Binding LatestVersion}" Foreground="#f0b040" FontWeight="Bold"/>
                                </TextBlock>
                                <TextBlock FontSize="12" Foreground="#8a8e9e" Margin="0,5,0,0"
                                           Visibility="{Binding IsCheckingUpdate, Converter={StaticResource BoolToVis}}"
                                           Text="{DynamicResource About.Checking}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource OutlineBtn}"
                                    Content="{DynamicResource About.CheckUpdate}"
                                    Padding="10,6" VerticalAlignment="Center"
                                    Command="{Binding CheckForUpdateCommand}"
                                    IsEnabled="{Binding IsCheckingUpdate, Converter={StaticResource InverseBool}}"/>
                        </Grid>
                    </Border>

                    <!-- Autor -->
                    <Border Background="#181b24" CornerRadius="6" Padding="16,14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource About.Author}"
                                       Foreground="#8a8e9e" FontSize="11" FontWeight="Bold"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="Marek Wojtaszek"
                                       Foreground="#e8eaf0" FontSize="16"/>
                        </StackPanel>
                    </Border>

                    <!-- Strona -->
                    <Button Style="{StaticResource OutlineBtn}" HorizontalAlignment="Stretch"
                            Height="44" Margin="0,0,0,8"
                            Command="{Binding OpenWebsiteCommand}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       VerticalAlignment="Center" Margin="0,2,8,0"/>
                            <TextBlock Text="cantio.app" FontSize="15" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Changelog (tylko gdy dostępna aktualizacja i są release notes) -->
                    <Border Background="#181b24" CornerRadius="6" Padding="14,12" Margin="0,0,0,8"
                            Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource About.Changelog}"
                                       Foreground="#8a8e9e" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                            <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
                                <TextBlock Text="{Binding ReleaseNotes}" TextWrapping="Wrap"
                                           FontSize="12" Foreground="#9aa3b8" LineHeight="18"/>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- Zainstaluj aktualizację (tylko gdy dostępna) -->
                    <Button Style="{StaticResource GoldBtn}" HorizontalAlignment="Stretch"
                            Height="44" Margin="0,0,0,6"
                            Command="{Binding DownloadAndInstallCommand}"
                            IsEnabled="{Binding IsDownloading, Converter={StaticResource InverseBool}}"
                            Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       VerticalAlignment="Center" Margin="0,2,8,0"/>
                            <TextBlock FontSize="15" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{DynamicResource About.InstallUpdate}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDownloading}" Value="True">
                                                <Setter Property="Text" Value="{DynamicResource About.Downloading}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                    <!-- Pasek postępu pobierania -->
                    <ProgressBar Value="{Binding DownloadProgress}" Maximum="100"
                                 Height="6" Margin="0,0,0,8"
                                 Foreground="#c9a84c" Background="#2a3347"
                                 Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}"/>

                </StackPanel>
            </Grid>

        </Grid>
    </Grid>
</Window>
