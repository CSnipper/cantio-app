<Window x:Class="Cantio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:Cantio.Helpers"
        xmlns:views="clr-namespace:Cantio.Views"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Cantio" Height="720" Width="1280"
        MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#0f1117"
        FontFamily="{StaticResource BodyFont}"
        Icon="cantio.ico">

    <Window.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <helpers:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
        <helpers:EnumToBoolConverter x:Key="EnumBool"/>
        <helpers:DoubleToThicknessConverter x:Key="DoubleToThickness"/>
        <helpers:IsEqualConverter x:Key="IsEqual"/>
        <helpers:StripTagsConverter x:Key="StripTags"/>
        <helpers:WidthToHeightConverter x:Key="WidthToHeight"/>
        <FontFamily x:Key="HeaderFont">/Assets/Fonts/#Grenze</FontFamily>
        
        <!-- ── Ciemny ComboBox ────────────────────────────────────────────────── -->
        <ControlTemplate x:Key="DarkComboToggle" TargetType="ToggleButton">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
                <Grid>
                    <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                    <Path Data="M0,0 L4,4 L8,0" x:Name="Arrow"
                          Stroke="#959fb9" StrokeThickness="1.5"
                          HorizontalAlignment="Right" VerticalAlignment="Center"
                          Margin="0,0,12,0"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="#3a4a65"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="#c9a84c"/>
                    <Setter TargetName="Arrow" Property="Stroke" Value="#c9a84c"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="DarkCombo" TargetType="ComboBox">
            <Setter Property="Background" Value="#1e2535"/>
            <Setter Property="Foreground" Value="#e8eaf0"/>
            <Setter Property="BorderBrush" Value="#2a3347"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Template="{StaticResource DarkComboToggle}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Padding="{TemplateBinding Padding}"
                                          Focusable="False" ClickMode="Press"/>
                            <ContentPresenter x:Name="ContentSite"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False"/>
                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=ToggleButton}"
                                   MinWidth="{Binding ActualWidth, ElementName=ToggleButton}"
                                   StaysOpen="False">
                                <Border Background="#1e2535" BorderBrush="#2a3347" BorderThickness="1" Margin="0,2,0,0">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="200">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#e8eaf0"/>
                        <Setter Property="Padding" Value="10,7"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#252d3d"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#2a3347"/>
                                <Setter Property="Foreground" Value="#c9a84c"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Ciemny TextBox ─────────────────────────────────────────────────── -->
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background"      Value="#1e2535"/>
            <Setter Property="Foreground"      Value="#e8eaf0"/>
            <Setter Property="BorderBrush"     Value="#2a3347"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="8,6"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="CaretBrush"      Value="#c9a84c"/>
            <Setter Property="SelectionBrush"  Value="#c9a84c"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                       >
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#c9a84c"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#3a4a65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Ciemny Slider ─────────────────────────────────────────────────── -->
        <Style x:Key="DarkSlider" TargetType="Slider">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*" MinHeight="18"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Track x:Name="PART_Track" Grid.Row="1">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton>
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" Background="#c9a84c"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton>
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" Background="#2a3347"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="14" Height="14"
                                                 Fill="#c9a84c" Stroke="#0f1117" StrokeThickness="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Ciemny CheckBox ───────────────────────────────────────────────── -->
        <Style x:Key="DarkCheck" TargetType="CheckBox">
            <Setter Property="Foreground"  Value="#e8eaf0"/>
            <Setter Property="FontSize"    Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="Box" Width="16" Height="16"
                            Background="#1e2535" BorderBrush="#2a3347" BorderThickness="1"
                            Margin="0,0,8,0">
                                <Path x:Name="Check" Data="M2,8 L6,12 L14,4"
                              Stroke="#c9a84c" StrokeThickness="2"
                              Visibility="Collapsed"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Box"   Property="BorderBrush" Value="#c9a84c"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#3a4a65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Ciemny RadioButton ────────────────────────────────────────────── -->
        <Style x:Key="DarkRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#e8eaf0"/>
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="Box" Width="16" Height="16"
                            Background="#1e2535" BorderBrush="#2a3347" BorderThickness="1"
                            Margin="0,0,8,0">
                                <Ellipse x:Name="Dot" Width="8" Height="8"
                                 Fill="#c9a84c" Visibility="Collapsed"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#c9a84c"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── ToggleButton (wyrównanie tekstu) ──────────────────────────────── -->
        <Style x:Key="AlignBtn" TargetType="ToggleButton">
            <Setter Property="Background"      Value="#1e2535"/>
            <Setter Property="Foreground"      Value="#959fb9"/>
            <Setter Property="BorderBrush"     Value="#2a3347"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width"  Value="36"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                       >
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background"  Value="#2a3347"/>
                                <Setter Property="BorderBrush" Value="#c9a84c"/>
                                <Setter Property="Foreground"  Value="#c9a84c"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#3a4a65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Zakładka ustawień (Czcionka/Kolor/itd.) ───────────────────────── -->
        <Style x:Key="SettingsTab" TargetType="RadioButton">
            <Setter Property="Background"  Value="Transparent"/>
            <Setter Property="Foreground"  Value="#959fb9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"     Value="8,4"/>
            <Setter Property="FontFamily"  Value="{StaticResource HeaderFont}"/>
            <Setter Property="FontSize"    Value="20"/>
            <Setter Property="FontWeight"  Value="Light"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                        BorderBrush="Transparent" BorderThickness="0,0,0,2"
                        Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#c9a84c"/>
                                <Setter Property="Foreground" Value="#c9a84c"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#9aa3b8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>



        <!-- ── SCROLLBAR ── -->
        <Style x:Key="SlimScrollViewer" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Hidden"/>
        </Style>

        <!-- ── TAB BUTTON ── -->
        <Style x:Key="TabBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1,0,0,1"/>
            <Setter Property="BorderBrush" Value="#9aa3b8"/>
            <Setter Property="Foreground" Value="#959fb9"/>
            <Setter Property="FontFamily" Value="{StaticResource HeaderFont}"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="Regular"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#08ffffff"/>
                                <Setter Property="Foreground" Value="#9aa3b8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TabBtnActive" TargetType="Button" BasedOn="{StaticResource TabBtn}">
            <Setter Property="BorderBrush" Value="#c9a84c"/>
            <Setter Property="Foreground" Value="#c9a84c"/>
            <Setter Property="Background" Value="#0Dc9a84c"/>
            <Setter Property="BorderThickness" Value="1,0,0,3"/>
        </Style>

        <!-- ── OUTLINE BUTTON ── -->
        <Style x:Key="OutlineBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#9aa3b8"/>
            <Setter Property="BorderBrush" Value="#2a3347"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="{StaticResource HeaderFont}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="16,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#c9a84c"/>
                                <Setter Property="Foreground" Value="#c9a84c"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── RED BUTTON ── -->
        <Style x:Key="RedBtn" TargetType="Button" BasedOn="{StaticResource OutlineBtn}">
            <Setter Property="Foreground" Value="#d44a4a"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#18d44a4a"/>
                                <Setter Property="BorderBrush" Value="#d44a4a"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── GOLD BUTTON ── -->
        <Style x:Key="GoldBtn" TargetType="Button">
            <Setter Property="Background" Value="#c9a84c"/>
            <Setter Property="Foreground" Value="#0f1117"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="{StaticResource HeaderFont}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#e8c97a"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── PIN BUTTON ── -->
        <Style x:Key="PinBtn" TargetType="ToggleButton">
            <Setter Property="Background" Value="#1e2535"/>
            <Setter Property="Foreground" Value="#9aa3b8"/>
            <Setter Property="BorderBrush" Value="#2a3347"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="{StaticResource HeaderFont}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#c9a84c"/>
                                <Setter Property="Foreground" Value="#c9a84c"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="#1a2540"/>
                                <Setter Property="BorderBrush" Value="#c9a84c"/>
                                <Setter Property="Foreground" Value="#e8c97a"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── NAV BUTTON ── -->
        <Style x:Key="NavBtn" TargetType="Button">
            <Setter Property="Background" Value="#1e2535"/>
            <Setter Property="Foreground" Value="#e8eaf0"/>
            <Setter Property="BorderBrush" Value="#2a3347"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                       >
                            <TextBlock Text="{TemplateBinding Content}"
                               FontSize="{TemplateBinding FontSize}"
                               Foreground="{TemplateBinding Foreground}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#252d3d"/>
                                <Setter Property="BorderBrush" Value="#4a7fd4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── SEARCH BOX ── -->
        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="Background" Value="#1e2535"/>
            <Setter Property="Foreground" Value="#e8eaf0"/>
            <Setter Property="CaretBrush" Value="#c9a84c"/>
            <Setter Property="BorderBrush" Value="#2a3347"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="32,8,10,8"/>
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#4a7fd4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── SHARED LIST ITEM ── -->
        <Style x:Key="DarkListItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="#9aa3b8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="3,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1e2535"/>
                                <Setter Property="Foreground" Value="#e8eaf0"/>
                                <Setter Property="BorderBrush" Value="#2a3347"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#1a2540"/>
                                <Setter Property="BorderBrush" Value="#c9a84c"/>
                                <Setter Property="Foreground" Value="#e8eaf0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkListItemGold" TargetType="ListBoxItem" BasedOn="{StaticResource DarkListItem}">
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="#e8c97a"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══════════ TOP BAR ══════════ -->
        <Border Grid.Row="0" Background="#161b25" BorderBrush="#2a3347" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                    <Image Source="cantio.ico" Width="32" Height="32" Margin="0,0,10,0"/>
                    <TextBlock Text="Cantio"
                               FontFamily="{StaticResource HeaderFont}"
                               FontSize="40" FontWeight="Bold" Foreground="#c9a84c"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" x:Name="TabBar" HorizontalAlignment="center">
                    <Button x:Name="TabShow"     Content="{DynamicResource Tab.Show}" Style="{StaticResource TabBtnActive}" Height="56" Click="TabShow_Click"/>
                    <Button x:Name="TabSongs"    Content="{DynamicResource Tab.Songs}"       Style="{StaticResource TabBtn}"       Height="56" Click="TabSongs_Click"/>
                    <Button x:Name="TabSets"     Content="{DynamicResource Tab.Sets}"      Style="{StaticResource TabBtn}"       Height="56" Click="TabSets_Click"/>
                    <Button x:Name="TabTemplate" Content="{DynamicResource Tab.Settings}"     Style="{StaticResource TabBtn}"       Height="56" Click="TabTemplate_Click"/>
                    <Button x:Name="TabImport"     Content="{DynamicResource Tab.Import}"   Style="{StaticResource TabBtn}"       Height="56" Click="TabImport_Click" BorderThickness="1,0,1,1"/>
                </StackPanel>

                <Border Grid.Column="2" Margin="0,0,16,0"
                        Background="#0D4ad47a" BorderBrush="#334ad47a" BorderThickness="1"
                        Padding="12,5"
                        Visibility="Visible">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="#4ad47a" Margin="0,0,8,0">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#4ad47a" ShadowDepth="0" BlurRadius="6"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <TextBlock Text="{DynamicResource Live.Label}" Foreground="#4ad47a"
                                   FontFamily="{StaticResource HeaderFont}" FontSize="11" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ══════════ CONTENT ══════════ -->
        <Grid Grid.Row="1">

            <!-- ── TAB: WYŚWIETLANIE ── -->
            <Grid x:Name="PaneShow" Visibility="Visible">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="400"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="380"/>
                    </Grid.ColumnDefinitions>

                    <!-- Col 0: ZWROTKI (slides list, full height) -->
                    <Grid Grid.Column="0" Background="#0f1117">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Nagłówek: ZWROTKI + tytuł pieśni -->
                        <Border Grid.Row="0" Background="#161b25" BorderBrush="#2a3347"
                                BorderThickness="0,0,1,1" Padding="14,11">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{DynamicResource Section.Verses}"
                                           FontFamily="{StaticResource HeaderFont}"
                                           FontSize="20" FontWeight="Light"
                                           Foreground="#c9a84c" Margin="0,0,16,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding SelectedSong.Title}"
                                           Foreground="#e8eaf0" FontSize="20" FontWeight="Light"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <!-- Lista slajdów -->
                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding SlideList}"
                                 SelectedIndex="{Binding CurrentSlideIndex}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ItemContainerStyle="{StaticResource DarkListItem}"
                                 KeyboardNavigation.DirectionalNavigation="None"
                                 Focusable="False"
                                 helpers:ListBoxAutoScrollBehavior.IsEnabled="True">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid MinHeight="64">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#1e2535"
                                                BorderBrush="#2a3347" BorderThickness="0,0,1,0">
                                            <TextBlock Text="{Binding Label}"
                                                       FontFamily="{StaticResource BodyFont}"
                                                       FontSize="20"
                                                       Foreground="#c9a84c"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Text, Converter={StaticResource StripTags}}"
                                                   FontSize="20" LineHeight="24"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"
                                                   Margin="14,12,12,12"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <!-- Row 2: Kontrolki — LIVE | Tytuł+POKAŻ | ◀ | ▶ -->
                        <Border Grid.Row="2" Background="#161b25" BorderBrush="#2a3347" BorderThickness="0,1,0,0" Padding="0,0,5,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="5"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="5"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Tytuł pieśni + licznik slajdów / POKAŻ-WYGAŚ button -->
                                <Grid Grid.Column="1" Margin="0,8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <!-- LIVE badge — dimmed when screen is blanked -->
                                    <Border Grid.Column="0" Margin="0,0,0,5" Padding="15,5"
                                            Background="#d44a4a22" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Opacity" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ScreenBlanked}" Value="True">
                                                        <Setter Property="Opacity" Value="0.25"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="7" Height="7" Fill="#d44a4a" Margin="0,0,5,0"
                                                    VerticalAlignment="Center"/>
                                            <TextBlock Text="LIVE" FontSize="30" FontWeight="Bold"
                                                    Foreground="#d44a4a"/>
                                        </StackPanel>
                                    </Border>
                                    <!-- POKAŻ / WYGAŚ -->
                                    <Button Grid.Row="1" Command="{Binding ToggleBlankCommand}" Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#252d3d"/>
                                                <Setter Property="Foreground" Value="#9aa3b8"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="FontFamily" Value="{StaticResource HeaderFont}"/>
                                                <Setter Property="FontSize" Value="30"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#2a3347"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ScreenBlanked}" Value="True">
                                                        <Setter Property="Background" Value="#1e2535"/>
                                                        <Setter Property="Foreground" Value="#c9a84c"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <TextBlock VerticalAlignment="Center" TextAlignment="Center" Padding="6">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{DynamicResource Btn.Blank}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ScreenBlanked}" Value="True">
                                                            <Setter Property="Text" Value="{DynamicResource Btn.ShowText}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Button>
                                </Grid>

                                <!-- ◀ Poprzedni slajd -->
                                <Button Grid.Column="3" Content="◀"
                                        Style="{StaticResource NavBtn}"
                                        FontSize="40" Width="108" Height="108"
                                        Command="{Binding PrevSlideCommand}"/>

                                <!-- ▶ Następny slajd -->
                                <Button Grid.Column="5" Content="▶"
                                        Style="{StaticResource NavBtn}"
                                        FontSize="40" Width="108" Height="108"
                                        Command="{Binding NextSlideCommand}"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Col 1: ŚRODKOWA (Kat+Pieśni top, podgląd middle, kontrolki bottom) -->
                    <Grid Grid.Column="1" Background="#0f1117">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>      <!-- Row 0: Kategorie + Pieśni -->
                            <RowDefinition Height="Auto"/>   <!-- Row 1: Podgląd 16:9 -->
                        </Grid.RowDefinitions>

                        <!-- Row 0: Kategorie (left) + Pieśni (right) -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <!-- KATEGORIE -->
                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="#161b25" BorderBrush="#2a3347"
                                        BorderThickness="0,0,1,1" Padding="10,3">
                                    <TextBlock Text="{DynamicResource Section.Categories}"
                                               FontFamily="{StaticResource HeaderFont}"
                                               FontSize="20" FontWeight="Light" Foreground="#c9a84c"/>
                                </Border>
                                <Border Grid.Row="1" BorderBrush="#2a3347" BorderThickness="0,0,1,0">
                                    <ListBox ItemsSource="{Binding Categories}"
                                             SelectedItem="{Binding SelectedCategory}"
                                             Background="Transparent" BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                             ItemContainerStyle="{StaticResource DarkListItemGold}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Grid.Column="0" Text="{Binding DisplayName}"
                                                           TextTrimming="CharacterEllipsis" Padding="5,10,0,10"
                                                           FontSize="18"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </Grid>

                            <!-- PIEŚNI -->
                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="#161b25" BorderBrush="#2a3347"
                                        BorderThickness="0,0,1,1" Padding="10,3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource Section.Songs}"
                                                   FontFamily="{StaticResource HeaderFont}"
                                                   FontSize="20" FontWeight="Light" Foreground="#c9a84c"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedCategory.Name}" Foreground="#9aa3b8"
                                                   FontSize="14" Margin="10,7" VerticalAlignment="Center"
                                                   HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Border>
                                <Border Grid.Row="1" Background="#161b25">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="🔍" Foreground="#959fb9" FontSize="20"
                                                   IsHitTestVisible="False" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBox Grid.Column="1" x:Name="SearchBoxShow"
                                                 Style="{StaticResource SearchBox}"
                                                 Padding="4"
                                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                 PreviewKeyDown="SearchBoxShow_PreviewKeyDown"/>
                                        <TextBlock Grid.Column="1" Text="{DynamicResource Placeholder.SearchSongs}" Foreground="#959fb9" FontSize="16"
                                                   IsHitTestVisible="False" VerticalAlignment="Center" Margin="8,0,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsFocused, ElementName=SearchBoxShow}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                                <Border Grid.Row="2" BorderBrush="#2a3347" BorderThickness="0,0,1,0">
                                    <ListBox x:Name="SongListShow"
                                             ItemsSource="{Binding Songs}"
                                             SelectedItem="{Binding SelectedSong}"
                                             Background="Transparent" BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ItemContainerStyle="{StaticResource DarkListItem}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="36"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="38"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Number, StringFormat='{}{0:D3}'}"
                                                               Foreground="#959fb9"
                                                               FontFamily="{StaticResource BodyFont}"
                                                               FontSize="12" VerticalAlignment="Center" Margin="11,12,0,12"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Title}"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                               Margin="0,12,0,12" TextWrapping="Wrap" FontSize="18"/>
                                                    <Button Grid.Column="2" Content="+"
                                                            Width="40" Height="40"
                                                            Background="#343f58" BorderBrush="#2a3347"
                                                            BorderThickness="0" Foreground="#959fb9"
                                                            Cursor="Hand"
                                                            Command="{Binding DataContext.AddToSetlistCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                            CommandParameter="{Binding}" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}"
                                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                                        BorderThickness="{TemplateBinding BorderThickness}">
                                                                    <TextBlock Text="+"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"
                                                                               Margin="0,0,0,4"
                                                                               FontSize="30" FontWeight="Light"
                                                                               Foreground="{TemplateBinding Foreground}"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="#c9a84c"/>
                                                                        <Setter Property="BorderBrush" Value="#c9a84c"/>
                                                                        <Setter Property="Foreground" Value="#0f1117"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- Row 1: Podgląd 16:9 -->
                        <Border Grid.Row="1"
                                Background="{Binding Projection.BackgroundBrush}"
                                BorderBrush="#2a3347" BorderThickness="0,1,0,1"
                                ClipToBounds="True"
                                Height="{Binding ActualWidth, RelativeSource={RelativeSource Self},
                                         Converter={StaticResource WidthToHeight}}">
                            <Border.Effect>
                                <DropShadowEffect Color="#000" ShadowDepth="0" BlurRadius="16" Opacity=".6"/>
                            </Border.Effect>
                            <Viewbox Stretch="Uniform">
                                <views:ProjectionView DataContext="{Binding Projection}"
                                                      Width="{Binding DataContext.ProjectionScreenWidth,
                                                              RelativeSource={RelativeSource AncestorType={x:Type Viewbox}}}"
                                                      Height="{Binding DataContext.ProjectionScreenHeight,
                                                               RelativeSource={RelativeSource AncestorType={x:Type Viewbox}}}"/>
                            </Viewbox>
                        </Border>
                    </Grid>

                    <!-- Col 2: ZESTAW -->
                    <Grid Grid.Column="2" Background="#0f1117" ClipToBounds="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="#161b25" BorderBrush="#2a3347"
                                    BorderThickness="1,0,0,1" Padding="12,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{DynamicResource Section.CurrentSet}"
                                               FontFamily="{StaticResource HeaderFont}"
                                               FontSize="20" FontWeight="Light"
                                               Foreground="#c9a84c" Margin="0,0,10,0"
                                               VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" Background="#252d3d" Padding="8,2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SetlistItems.Count}" Foreground="#9aa3b8" FontSize="10"/>
                                    </Border>
                                    <Button Grid.Column="3" x:Name="BtnOpenSetlist"
                                            Content="{DynamicResource Btn.OpenSet}"
                                            Command="{Binding OpenSetlistSearchCommand}"
                                            Background="#252d3d" BorderThickness="0"
                                            Foreground="#9aa3b8" FontSize="13" Cursor="Hand"
                                            Padding="10,5" VerticalAlignment="Center">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#c9a84c"/>
                                                        <Setter Property="Foreground" Value="#0f1117"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Popup wyszukiwania zestawów -->
                            <Popup Grid.Row="0"
                                   IsOpen="{Binding IsSetlistSearchOpen, Mode=TwoWay}"
                                   PlacementTarget="{Binding ElementName=BtnOpenSetlist}"
                                   Placement="Bottom"
                                   StaysOpen="False"
                                   AllowsTransparency="True">
                                <Border Background="#1e2535" BorderBrush="#2a3347" BorderThickness="1"
                                        Width="340" MaxHeight="400">
                                    <Grid Margin="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBox Grid.Row="0"
                                                 Style="{StaticResource DarkTextBox}"
                                                 Text="{Binding SetlistSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="15" Padding="8,6" Margin="0,0,0,6"/>
                                        <ListBox Grid.Row="1"
                                                 ItemsSource="{Binding FilteredSetlists}"
                                                 Background="Transparent" BorderThickness="0"
                                                 MaxHeight="340"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ItemContainerStyle="{StaticResource DarkListItem}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="4,4,4,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontSize="15" Foreground="#e8eaf0"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:dd.MM.yyyy}'}"
                                                                       FontSize="11" Foreground="#959fb9"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Content="{DynamicResource Btn.Open}"
                                                                Margin="0,0,4,0" Padding="8,4"
                                                                Background="#252d3d" BorderThickness="0"
                                                                Foreground="#9aa3b8" FontSize="12" Cursor="Hand"
                                                                Command="{Binding DataContext.LoadSetlistFromSearchCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                CommandParameter="{Binding}">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Background" Value="#c9a84c"/>
                                                                            <Setter Property="Foreground" Value="#0f1117"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                        <Button Grid.Column="2" Content="{DynamicResource Btn.Append}"
                                                                Padding="8,4"
                                                                Background="#252d3d" BorderThickness="0"
                                                                Foreground="#9aa3b8" FontSize="12" Cursor="Hand"
                                                                Command="{Binding DataContext.AppendSetlistFromSearchCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                CommandParameter="{Binding}">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Background" Value="#3a6ea8"/>
                                                                            <Setter Property="Foreground" Value="#ffffff"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </Border>
                            </Popup>

                            <Border Grid.Row="1" BorderBrush="#2a3347" BorderThickness="1,0,0,0">
                                <ListBox ItemsSource="{Binding SetlistItems}"
                                         SelectedItem="{Binding SelectedSetlistItem}"
                                         Background="Transparent" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ItemContainerStyle="{StaticResource DarkListItemGold}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid AllowDrop="True"
                                                  MouseMove="SetlistItem_MouseMove"
                                                  Drop="SetlistItem_Drop">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="30"/>
                                                    <ColumnDefinition Width="22"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="34"/>
                                                    <ColumnDefinition Width="30"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Grid.Column="0" Width="6" Height="6" Fill="#c9a84c"
                                                         VerticalAlignment="Center"
                                                         Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}}">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect Color="#c9a84c" ShadowDepth="0" BlurRadius="6"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                                <TextBlock Grid.Column="1" Text="⠿" Foreground="#959fb9"
                                                           FontSize="20" VerticalAlignment="Center" Padding="5,5,3,3"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Position}"
                                                           FontSize="20" Foreground="#959fb9" 
                                                            Padding="0,4,0,4" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Song.Title}"
                                                           TextWrapping="Wrap" VerticalAlignment="Center" 
                                                           HorizontalAlignment="Stretch"
                                                           FontSize="20" Padding="10"/>
                                                <Button Grid.Column="4" Content="✏"
                                                        Width="30" Height="30"
                                                        Background="Transparent" BorderThickness="0"
                                                        Foreground="#959fb9" FontSize="16" Cursor="Hand"
                                                        IsEnabled="{Binding DataContext.CanOpenInlineEditor, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        Command="{Binding DataContext.OpenInlineEditorCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="Transparent">
                                                                <TextBlock Text="✏"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"
                                                                           FontSize="15"
                                                                           Foreground="{TemplateBinding Foreground}"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Foreground" Value="#c9a84c"/>
                                                                </Trigger>
                                                                <Trigger Property="IsEnabled" Value="False">
                                                                    <Setter Property="Foreground" Value="#3a4460"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                                <Button Grid.Column="5" Content="×"
                                                        Width="30" Height="30"
                                                        Background="Transparent" BorderThickness="0"
                                                        Foreground="#959fb9" FontSize="20" Cursor="Hand"
                                                        Command="{Binding DataContext.RemoveFromSetlistCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="Transparent">
                                                                <TextBlock Text="×"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"
                                                                           FontSize="18"
                                                                           Foreground="{TemplateBinding Foreground}"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Foreground" Value="#d44a4a"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                            
                            <Border Grid.Row="2" Background="#161b25" BorderBrush="#2a3347"
                                    BorderThickness="1,1,0,0" Padding="6,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="⏫" FontSize="16"
                                            ToolTip="{DynamicResource Tooltip.ToTop}"
                                            Background="Transparent" BorderThickness="0"
                                            Foreground="#959fb9" Height="36" Cursor="Hand"
                                            Command="{Binding MoveToTopCommand}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}">
                                                    <TextBlock Text="⏫" FontSize="16"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#1e2535"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button Grid.Column="1" Content="🔼" FontSize="16"
                                            ToolTip="{DynamicResource Tooltip.Up}"
                                            Background="Transparent" BorderThickness="0"
                                            Foreground="#959fb9" Height="36" Cursor="Hand"
                                            Command="{Binding MoveUpCommand}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}">
                                                    <TextBlock Text="🔼" FontSize="16"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#1e2535"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button Grid.Column="2" Content="🔽" FontSize="16"
                                            ToolTip="{DynamicResource Tooltip.Down}"
                                            Background="Transparent" BorderThickness="0"
                                            Foreground="#959fb9" Height="36" Cursor="Hand"
                                            Command="{Binding MoveDownCommand}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}">
                                                    <TextBlock Text="🔽" FontSize="16"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#1e2535"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button Grid.Column="3" Content="⏬" FontSize="16"
                                            ToolTip="{DynamicResource Tooltip.ToBottom}"
                                            Background="Transparent" BorderThickness="0"
                                            Foreground="#959fb9" Height="36" Cursor="Hand"
                                            Command="{Binding MoveToBottomCommand}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}">
                                                    <TextBlock Text="⏬" FontSize="16"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#1e2535"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>

                            <Border Grid.Row="3" Background="#161b25" BorderBrush="#2a3347"
                                    BorderThickness="1,1,0,0" Padding="8,8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <!-- Pole grupy zestawu -->
                                    <Grid Grid.Row="0" Margin="0,0,0,6">
                                        <ComboBox Style="{StaticResource DarkCombo}"
                                                  ItemsSource="{Binding SetlistGroups}"
                                                  Text="{Binding SetlistGroup, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEditable="True"
                                                  Foreground="#e8eaf0"
                                                  FontSize="16" Height="34"/>
                                        <TextBlock Text="{DynamicResource Placeholder.SetlistGroup}"
                                                   Foreground="#ffffff" FontSize="16"
                                                   Padding="7,3" IsHitTestVisible="False" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SetlistGroup}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <!-- Pole nazwy zestawu -->
                                    <Grid Grid.Row="1" Margin="0,0,0,6">
                                        <TextBox Style="{StaticResource DarkTextBox}"
                                                 Text="{Binding SetlistName, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="18" Padding="3" Height="34"/>
                                        <TextBlock Text="{DynamicResource Placeholder.SetlistName}"
                                                   Foreground="#555d70" FontSize="18"
                                                   Padding="7,3" IsHitTestVisible="False" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SetlistName}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <!-- Przyciski -->
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="{DynamicResource Btn.SaveSetlist}"
                                                Style="{StaticResource OutlineBtn}" Margin="0,0,7,0"
                                                Command="{Binding SaveSetlistCommand}"/>
                                        <Button Grid.Column="1" Content="{DynamicResource Btn.Clear}"
                                                Style="{StaticResource RedBtn}"
                                                Command="{Binding ClearSetlistCommand}"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Przypięte zestawy — ostatni wiersz -->
                            <Border Grid.Row="4" BorderBrush="#2a3347" BorderThickness="0,1,0,0" Padding="8">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Section.Pinned}"
                                               FontFamily="{StaticResource HeaderFont}"
                                               FontSize="16" Foreground="#FFFFFF"
                                               Margin="0,0,0,5"/>
                                    <ItemsControl ItemsSource="{Binding PinnedSetlists}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="2"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <ToggleButton Content="{Binding Name}"
                                                              Style="{StaticResource PinBtn}"
                                                              Margin="0,0,4,4"
                                                              Command="{Binding DataContext.LoadPinnedSetlistCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                              CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Panel edycji zwrotek -->
                            <Grid Grid.Row="0" Grid.RowSpan="5" Panel.ZIndex="10"
                                  Background="#1e2535"
                                  Visibility="{Binding IsInlineEditorOpen, Converter={StaticResource BoolToVis}}">

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Nagłówek -->
                                    <Border Grid.Row="0" Background="#161b25" BorderBrush="#2a3347"
                                            BorderThickness="0,0,0,1" Padding="12,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding InlineEditorTitle}"
                                                       FontSize="15" FontWeight="SemiBold"
                                                       Foreground="#e8eaf0"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>
                                            <Button Grid.Column="1" Content="×"
                                                    Background="Transparent" BorderThickness="0"
                                                    Foreground="#959fb9" FontSize="20" Cursor="Hand"
                                                    Command="{Binding CancelInlineEditCommand}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="Transparent" Padding="8,4">
                                                            <TextBlock Text="×" FontSize="20"
                                                                       Foreground="{TemplateBinding Foreground}"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Foreground" Value="#d44a4a"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <!-- Lista zwrotek do edycji -->
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding EditableVerses}"
                                                      Margin="8,4">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,6">
                                                        <TextBlock Text="{Binding Label}"
                                                                   FontSize="11" Foreground="#c9a84c"
                                                                   Margin="0,0,0,3" FontWeight="SemiBold"/>
                                                        <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                                                 Style="{StaticResource DarkTextBox}"
                                                                 AcceptsReturn="True"
                                                                 TextWrapping="Wrap"
                                                                 MinHeight="60"
                                                                 FontSize="14"
                                                                 Padding="8,6"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <!-- Przyciski Zapisz / Anuluj -->
                                    <Border Grid.Row="2" Background="#161b25" BorderBrush="#2a3347"
                                            BorderThickness="0,1,0,0" Padding="8,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0"
                                                    Content="{DynamicResource Btn.Save}"
                                                    Style="{StaticResource OutlineBtn}"
                                                    Margin="0,0,7,0"
                                                    Command="{Binding SaveInlineEditCommand}"/>
                                            <Button Grid.Column="1"
                                                    Content="{DynamicResource Btn.CancelSettings}"
                                                    Style="{StaticResource RedBtn}"
                                                    Command="{Binding CancelInlineEditCommand}"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                    </Grid>
                </Grid>


            </Grid>

            <!-- EDYCJA -->
            <Grid x:Name="PaneSongs" Visibility="Collapsed" Background="#0f1117">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ═══════════════════════════════════════
                     LEWA: lista pieśni
                ═══════════════════════════════════════ -->

                <Grid Grid.Column="0" Background="#0f1117">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>   <!-- nagłówek KATEGORIE -->
                        <RowDefinition Height="Auto"/>   <!-- lista kategorii -->
                        <RowDefinition Height="Auto"/>   <!-- wiersz: dodaj nową kategorię -->
                        <RowDefinition Height="Auto"/>   <!-- nagłówek PIEŚNI -->
                        <RowDefinition Height="Auto"/>   <!-- szukaj -->
                        <RowDefinition Height="*"/>      <!-- lista pieśni -->
                    </Grid.RowDefinitions>

                    <!-- NAGŁÓWEK: KATEGORIE + Dodaj nową -->
                    <Border Grid.Row="0" Background="#161b25" BorderBrush="#2a3347"
                            BorderThickness="0,0,1,1" Padding="14,11">
                        <TextBlock Text="{DynamicResource Section.Categories}"
                                   FontFamily="{StaticResource HeaderFont}"
                                   FontSize="20" FontWeight="Light" Foreground="#c9a84c"/>
                    </Border>

                    <!-- POLE: nowa nazwa kategorii (widoczne zawsze — uproszczone UX) -->
                    <Border Grid.Row="2" Background="#0f1117" BorderBrush="#2a3347"
                            BorderThickness="0,0,1,1" Padding="8,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     Text="{Binding NewCategoryName, UpdateSourceTrigger=PropertyChanged}"
                                     Background="#1e2535" Foreground="#e8eaf0"
                                     BorderBrush="#2a3347" BorderThickness="1"
                                     FontSize="16" Padding="8,6" CaretBrush="#c9a84c">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding AddCategoryCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                            <TextBlock Grid.Column="0"
                                       Text="{DynamicResource Placeholder.NewCategory}" Foreground="#4a5a7a" FontSize="16"
                                       IsHitTestVisible="False" VerticalAlignment="Center" Margin="10,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding NewCategoryName}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Button Grid.Column="2" Content="{DynamicResource Btn.AddCategory}"
                                    Style="{StaticResource OutlineBtn}" Padding="10,5"
                                    Command="{Binding AddCategoryCommand}"/>
                        </Grid>
                    </Border>
                   <!-- LISTA KATEGORII -->
                    <Border Grid.Row="1" BorderBrush="#2a3347" BorderThickness="0,0,1,0">
                        <ListBox ItemsSource="{Binding CategoryItems}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 MaxHeight="200"
                                 ItemContainerStyle="{StaticResource DarkListItemGold}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <!-- tryb normalny -->
                                    <Grid>
                                        <Grid Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVis}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="36"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="30"/>
                                                <ColumnDefinition Width="30"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- numer -->
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Number}"
                                                       Foreground="#4a5a7a"
                                                       FontFamily="{StaticResource HeaderFont}"
                                                       FontSize="14"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,10,0,10"/>

                                            <!-- nazwa -->
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Name}"
                                                       Foreground="#e8eaf0" FontSize="16"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,10,4,10"/>

                                            <!-- dyskietka (zapis/edycja) -->
                                            <Button Grid.Column="2" VerticalAlignment="Center"
                                                    Cursor="Hand"
                                                    Command="{Binding DataContext.StartEditCategoryCommand,
                                                        RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="Transparent" Padding="4">
                                                            <TextBlock Text="✎" FontSize="18">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="#3a4a65"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsMouseOver,
                                                                                RelativeSource={RelativeSource AncestorType=Button}}"
                                                                                Value="True">
                                                                                <Setter Property="Foreground" Value="#c9a84c"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <!-- X (usuń) -->
                                            <Button Grid.Column="3" VerticalAlignment="Center"
                                                    Cursor="Hand"
                                                    Command="{Binding DataContext.DeleteCategoryCommand,
                                                        RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="Transparent" Padding="4">
                                                            <TextBlock Text="✕" FontSize="16">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="#3a4a65"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsMouseOver,
                                                                                RelativeSource={RelativeSource AncestorType=Button}}"
                                                                                Value="True">
                                                                                <Setter Property="Foreground" Value="#d44a4a"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>

                                        <!-- tryb edycji inline -->
                                        <Grid Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="36"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="30"/>
                                                <ColumnDefinition Width="30"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- numer (edytowalny) -->
                                            <TextBox Grid.Column="0"
                                                     Text="{Binding EditNumber, UpdateSourceTrigger=PropertyChanged}"
                                                     helpers:NumericBox.IsEnabled="True"
                                                     helpers:NumericBox.Min="1"
                                                     helpers:NumericBox.Max="9999"
                                                     Background="#1e2535" Foreground="#c9a84c"
                                                     BorderBrush="#c9a84c" BorderThickness="1"
                                                     FontFamily="{StaticResource HeaderFont}"
                                                     FontSize="12" Padding="2,4"
                                                     CaretBrush="#c9a84c"
                                                     TextAlignment="Center"
                                                     VerticalAlignment="Center"
                                                     Margin="0,4,4,4"/>

                                            <!-- TextBox edycji -->
                                            <TextBox Grid.Column="1"
                                                     Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="#1e2535" Foreground="#e8eaf0"
                                                     BorderBrush="#c9a84c" BorderThickness="1"
                                                     FontSize="16" Padding="6,4"
                                                     CaretBrush="#c9a84c"
                                                     VerticalAlignment="Center"
                                                     Margin="0,4,4,4"/>

                                            <!-- 💾 zapisz -->
                                            <Button Grid.Column="2" VerticalAlignment="Center"
                                                    Cursor="Hand"
                                                    Command="{Binding DataContext.SaveCategoryCommand,
                                                        RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="Transparent" Padding="4">
                                                            <TextBlock Text="💾" FontSize="13">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="#c9a84c"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsMouseOver,
                                                                                RelativeSource={RelativeSource AncestorType=Button}}"
                                                                                Value="True">
                                                                                <Setter Property="Foreground" Value="#e8c97a"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <!-- ✕ anuluj -->
                                            <Button Grid.Column="3" VerticalAlignment="Center"
                                                    Cursor="Hand"
                                                    Command="{Binding DataContext.CancelEditCategoryCommand,
                                                        RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="Transparent" Padding="4">
                                                            <TextBlock Text="✕" FontSize="11">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="#6a7a8a"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsMouseOver,
                                                                                RelativeSource={RelativeSource AncestorType=Button}}"
                                                                                Value="True">
                                                                                <Setter Property="Foreground" Value="#d44a4a"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <!-- NAGŁÓWEK: PIEŚNI + Dodaj nową -->
                    <Border Grid.Row="3" Background="#161b25" BorderBrush="#2a3347"
                            BorderThickness="0,1,1,1" Padding="14,0,8,0" Height="44">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource Section.Songs}"
                                       FontFamily="{StaticResource HeaderFont}"
                                       FontSize="20" FontWeight="Light" Foreground="#c9a84c"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="{DynamicResource Btn.NewSong}"
                                    Style="{StaticResource GoldBtn}" Padding="10,5"
                                    Command="{Binding NewSongCommand}"/>
                        </Grid>
                    </Border>

                    <!-- ══════════════════════════════════════
                         SZUKAJ
                    ══════════════════════════════════════ -->
                    <Border Grid.Row="4" Background="#161b25" BorderBrush="#2a3347"
                            BorderThickness="0,0,1,1" Padding="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🔍" Foreground="#959fb9" FontSize="18"
                                       IsHitTestVisible="False" VerticalAlignment="Center"
                                       HorizontalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="SearchBoxSongs"
                                     Style="{StaticResource SearchBox}"
                                     Padding="3" FontSize="20"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     PreviewKeyDown="SearchBoxSongs_PreviewKeyDown"/>
                            <TextBlock Grid.Column="1" Text="{DynamicResource Placeholder.SearchSongs}" Foreground="#959fb9" FontSize="20"
                                       IsHitTestVisible="False" VerticalAlignment="Center" Margin="8,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SearchText}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsFocused, ElementName=SearchBoxSongs}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- LISTA PIEŚNI -->
                    <Border Grid.Row="5" BorderBrush="#2a3347" BorderThickness="0,0,1,0">
                        <ListBox x:Name="SongListSongs"
                                 ItemsSource="{Binding FilteredSongs}"
                                 SelectedItem="{Binding SelectedSongInList}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ItemContainerStyle="{StaticResource DarkListItem}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Number, StringFormat='{}{0:D3}'}"
                                                   Foreground="#959fb9"
                                                   FontFamily="{StaticResource HeaderFont}"
                                                   FontSize="10" VerticalAlignment="Center"
                                                   Margin="11,12,0,12"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                                    Margin="4,3,8,3">
                                            <TextBlock Text="{Binding Title}"
                                                       TextTrimming="CharacterEllipsis"
                                                       FontSize="18" Foreground="#e8eaf0"/>
                                            <TextBlock Text="{Binding Category.Name}"
                                                       FontSize="14" Foreground="#959fb9"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>


                <!-- PRAWA: edytor -->
                <Grid Grid.Column="1">

                    <!-- Edytor — zawsze widoczny, treść zależy od IsEditing -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- INFORMACJE -->
                        <Border Grid.Row="0" Background="#161b25" BorderBrush="#2a3347"
                    BorderThickness="0,0,0,1" Padding="20,14"
                    Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="200"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Field.Title}"
                               Foreground="#959fb9" FontSize="10"
                               FontFamily="{StaticResource HeaderFont}" FontWeight="SemiBold"
                               Margin="0,0,0,5"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="{DynamicResource Field.Number}"
                               Foreground="#959fb9" FontSize="10"
                               FontFamily="{StaticResource HeaderFont}" FontWeight="SemiBold"
                               Margin="0,0,0,5"/>
                                <TextBlock Grid.Row="0" Grid.Column="4" Text="{DynamicResource Field.Category}"
                               Foreground="#959fb9" FontSize="10"
                               FontFamily="{StaticResource HeaderFont}" FontWeight="SemiBold"
                               Margin="0,0,0,5"/>

                                <TextBox Grid.Row="2" Grid.Column="0"
                             Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource DarkTextBox}" FontSize="15"/>
                                <TextBox Grid.Row="2" Grid.Column="2"
                             Text="{Binding EditNumber, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource DarkTextBox}"
                             helpers:NumericBox.IsEnabled="True"
                             helpers:NumericBox.Min="0"
                             helpers:NumericBox.Max="9999"
                             TextAlignment="Center"/>
                                <ComboBox Grid.Row="2" Grid.Column="4"
                              Style="{StaticResource DarkCombo}"
                              ItemsSource="{Binding Categories}"
                              SelectedItem="{Binding EditCategory}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                        </Border>

                        <!-- ZWROTKI + KOLEJNOŚĆ -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>

                            <!-- ZWROTKI -->
                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="#161b25" BorderBrush="#2a3347"
                            BorderThickness="0,0,0,1" Padding="14,10">
                                    <TextBlock Text="{DynamicResource Section.Verses}"
                                   FontFamily="{StaticResource HeaderFont}"
                                   FontSize="20" FontWeight="Light" Foreground="#c9a84c"/>
                                </Border>

                                <Border Grid.Row="1" Background="#161b25" BorderBrush="#2a3347"
                            BorderThickness="0,0,0,1" Padding="10,8"
                            Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{DynamicResource VerseType.AddLabel}" Foreground="#959fb9" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <Button Content="{DynamicResource VerseType.Verse}" Style="{StaticResource OutlineBtn}"
                                    Padding="10,5" Margin="0,0,6,0"
                                    Command="{Binding AddVerseCommand}" CommandParameter="v"/>
                                        <Button Content="{DynamicResource VerseType.Chorus}" Style="{StaticResource OutlineBtn}"
                                    Padding="10,5" Margin="0,0,6,0"
                                    Command="{Binding AddVerseCommand}" CommandParameter="c"/>
                                        <Button Content="{DynamicResource VerseType.Bridge}" Style="{StaticResource OutlineBtn}"
                                    Padding="10,5" Margin="0,0,16,0"
                                    Command="{Binding AddVerseCommand}" CommandParameter="b"/>
                                        <Button Content="{DynamicResource VerseType.EditAll}" Style="{StaticResource OutlineBtn}"
                                    Padding="10,5"
                                    Command="{Binding OpenPasteTextDialogCommand}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Placeholder gdy brak pieśni — w kolumnie zwrotek -->
                                <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Panel.ZIndex="1">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEditing}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="♪" FontSize="48" Foreground="#2a3347"
                                   HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                    <TextBlock Text="{DynamicResource Msg.SelectSong}"
                                   Foreground="#959fb9" FontSize="14"
                                   FontFamily="{StaticResource HeaderFont}"/>
                                </StackPanel>

                                <!-- Lista zwrotek + TextBox do edycji -->
                                <Grid Grid.Row="2"
                          Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Miniaturki zwrotek -->
                                    <Border Grid.Column="0" BorderBrush="#2a3347" BorderThickness="0,0,1,0">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Hidden">
                                            <ItemsControl ItemsSource="{Binding Verses}" Margin="6,6,6,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,0,0,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="18"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Button Grid.Column="0"
                                                        Command="{Binding DataContext.SelectVerseCommand,
                                                            RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Height="40" Cursor="Hand">
                                                                <Button.Style>
                                                                    <Style TargetType="Button">
                                                                        <Setter Property="Background" Value="#1e2535"/>
                                                                        <Setter Property="BorderBrush" Value="#2a3347"/>
                                                                        <Setter Property="BorderThickness" Value="1"/>
                                                                        <Setter Property="Template">
                                                                            <Setter.Value>
                                                                                <ControlTemplate TargetType="Button">
                                                                                    <Border Background="{TemplateBinding Background}"
                                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                               >
                                                                                        <TextBlock Text="{Binding Label, Mode=OneWay}"
                                                                                       FontFamily="{StaticResource HeaderFont}"
                                                                                       FontSize="14" FontWeight="Bold"
                                                                                       HorizontalAlignment="Center"
                                                                                       VerticalAlignment="Center">
                                                                                            <TextBlock.Style>
                                                                                                <Style TargetType="TextBlock">
                                                                                                    <Setter Property="Foreground" Value="#9aa3b8"/>
                                                                                                    <Style.Triggers>
                                                                                                        <DataTrigger Binding="{Binding Type}" Value="c">
                                                                                                            <Setter Property="Foreground" Value="#c9a84c"/>
                                                                                                        </DataTrigger>
                                                                                                        <DataTrigger Binding="{Binding Type}" Value="b">
                                                                                                            <Setter Property="Foreground" Value="#4a9fd4"/>
                                                                                                        </DataTrigger>
                                                                                                    </Style.Triggers>
                                                                                                </Style>
                                                                                            </TextBlock.Style>
                                                                                        </TextBlock>
                                                                                    </Border>
                                                                                </ControlTemplate>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Value="True">
                                                                                <DataTrigger.Binding>
                                                                                    <MultiBinding Converter="{StaticResource IsEqual}">
                                                                                        <Binding Path="DataContext.SelectedVerse"
                                                                                RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                                                                        <Binding/>
                                                                                    </MultiBinding>
                                                                                </DataTrigger.Binding>
                                                                                <Setter Property="BorderBrush" Value="#c9a84c"/>
                                                                                <Setter Property="Background"  Value="#1a2540"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                            </Button>
                                                            <Button Grid.Column="1" Content="×"
                                                        Background="Transparent" BorderThickness="0"
                                                        Foreground="#959fb9" FontSize="14"
                                                        Cursor="Hand" VerticalAlignment="Center"
                                                        Command="{Binding DataContext.RemoveVerseCommand,
                                                            RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border Background="Transparent">
                                                                            <TextBlock Text="×" FontSize="14"
                                                                           Foreground="{TemplateBinding Foreground}"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter Property="Foreground" Value="#d44a4a"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                            </Button>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>

                                    <!-- TextBox edycji tekstu zwrotki -->
                                    <Grid Grid.Column="1">
                                        <TextBox Text="{Binding SelectedVerseText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource DarkTextBox}"
                                     AcceptsReturn="True" AcceptsTab="False"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     FontSize="14" FontFamily="Consolas"
                                     Background="#0f1117"
                                     BorderThickness="0"
                                     Padding="16"
                                     PreviewKeyDown="VerseTextBox_PreviewKeyDown"/>
                                        <TextBlock Text="{DynamicResource Msg.SelectVerse}"
                                       Foreground="#959fb9" FontSize="13"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Top" HorizontalAlignment="Left"
                                       Margin="16">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedVerse}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Grid>
                            </Grid>

                            <!-- Separator -->
                            <Border Grid.Column="1" Background="#2a3347"/>

                            <!-- KOLEJNOŚĆ WYKONANIA -->
                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="1"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="#161b25" BorderBrush="#2a3347"
                            BorderThickness="0,0,0,1" Padding="14,10">
                                    <TextBlock Text="{DynamicResource Section.Setlist}"
                                   FontFamily="{StaticResource HeaderFont}"
                                   FontSize="20" FontWeight="Light" Foreground="#c9a84c"/>
                                </Border>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Hidden" Padding="12,8">
                                    <ItemsControl ItemsSource="{Binding PlayOrder}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,4" AllowDrop="True"
                                                      MouseMove="PlayOrderItem_MouseMove"
                                                      Drop="PlayOrderItem_Drop">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="28"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Background="#1e2535"
                                                BorderBrush="#2a3347" BorderThickness="1"
                                                Padding="12,8">
                                                        <TextBlock VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#9aa3b8"/>
                                                                    <Setter Property="FontSize" Value="13"/>
                                                                </Style>
                                                            </TextBlock.Style>
                                                <Run Text="{Binding Label, Mode=OneWay}"
                                                     FontFamily="{StaticResource HeaderFont}"
                                                     FontWeight="Bold"/>
                                                <Run Text=" — "/>
                                                <Run Text="{Binding Type, Mode=OneWay}"
                                                     Foreground="#959fb9" FontSize="11"/>
                                                        </TextBlock>
                                                    </Border>
                                                    <Button Grid.Column="1" Content="×"
                                                Background="Transparent" BorderThickness="0"
                                                Foreground="#959fb9" FontSize="16"
                                                Cursor="Hand" VerticalAlignment="Center"
                                                HorizontalAlignment="Center"
                                                Command="{Binding DataContext.RemoveFromPlayOrderCommand,
                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="Transparent">
                                                                    <TextBlock Text="×" FontSize="16"
                                                                   Foreground="{TemplateBinding Foreground}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Foreground" Value="#d44a4a"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <Border Grid.Row="2" Background="#2a3347"/>

                                <Border Grid.Row="3" Background="#161b25" BorderBrush="#2a3347"
                            BorderThickness="0,1,0,0" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Btn.AddToOrder}"
                                       Foreground="#959fb9" FontSize="10"
                                       FontFamily="{StaticResource HeaderFont}"
                                       FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <ItemsControl ItemsSource="{Binding Verses}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Margin="0,0,6,6" Padding="12,7" Cursor="Hand"
                                                Command="{Binding DataContext.AddToPlayOrderCommand,
                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Background" Value="#1e2535"/>
                                                                <Setter Property="BorderBrush" Value="#2a3347"/>
                                                                <Setter Property="BorderThickness" Value="1"/>
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border Background="{TemplateBinding Background}"
                                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                                        Padding="{TemplateBinding Padding}">
                                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                      VerticalAlignment="Center"/>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter Property="Background" Value="#252d3d"/>
                                                                                    <Setter Property="BorderBrush" Value="#c9a84c"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Type}" Value="c">
                                                                        <Setter Property="BorderBrush" Value="#4a5a30"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Type}" Value="b">
                                                                        <Setter Property="BorderBrush" Value="#1a3a5a"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <TextBlock FontFamily="{StaticResource HeaderFont}"
                                                       FontSize="13" FontWeight="Bold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#9aa3b8"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Type}" Value="c">
                                                                            <Setter Property="Foreground" Value="#c9a84c"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Type}" Value="b">
                                                                            <Setter Property="Foreground" Value="#4a9fd4"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                <Run Text="{Binding Label, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- PRZYCISKI -->
                        <Border Grid.Row="2" Background="#161b25" BorderBrush="#2a3347"
                    BorderThickness="0,1,0,0" Padding="20,12"
                    Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="{DynamicResource Btn.SaveSong}"
                            Style="{StaticResource GoldBtn}" Height="50" FontSize="28" Padding="0"
                            Command="{Binding SaveSongCommand}"/>
                                <Button Grid.Column="2" Content="{DynamicResource Btn.CancelSettings}"
                            Style="{StaticResource OutlineBtn}" Height="50" Padding="20,0"
                            Command="{Binding CancelEditCommand}"/>
                                <Button Grid.Column="4" Content="{DynamicResource Btn.Delete}"
                            Style="{StaticResource RedBtn}" Height="50" Padding="20,0"
                            Command="{Binding DeleteSongCommand}"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <Grid x:Name="PaneCats"     Visibility="Collapsed" Background="#0f1117">
                <TextBlock Text="☰ KATEGORIE — wkrótce" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#959fb9" FontFamily="{StaticResource HeaderFont}" FontSize="16"/>
            </Grid>
            <Grid x:Name="PaneSets" Visibility="Collapsed" Background="#0f1117">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- PASEK PRZYPIĘTYCH ZESTAWÓW -->
                <Border Grid.Row="0" Grid.ColumnSpan="2"
                        Background="#161b25" BorderBrush="#2a3347" BorderThickness="0,0,0,1"
                        Padding="12,8"
                        Visibility="{Binding HasPinnedSetlists, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding PinnedSetlists}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.SelectSetlistCommand,
                                            RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Cursor="Hand" Margin="0,0,8,0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="#c9a84c" BorderThickness="1"
                                                    CornerRadius="4" Padding="14,7">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="📌" FontSize="11" Margin="0,0,6,0"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Name}"
                                                               FontFamily="{StaticResource BodyFont}"
                                                               FontSize="13" Foreground="#e8eaf0"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#1e2535"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="False">
                                                    <Setter Property="Background" Value="#0f1117"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- LEWA: grupy + zestawy -->
                <Grid Grid.Row="1" Grid.Column="0" Background="#0f1117">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- nagłówek -->
                        <RowDefinition Height="Auto"/>  <!-- grupy -->
                        <RowDefinition Height="*"/>     <!-- lista zestawów -->
                    </Grid.RowDefinitions>

                    <!-- Nagłówek -->
                    <Border Grid.Row="0" Background="#161b25" BorderBrush="#2a3347"
                            BorderThickness="0,0,1,1" Padding="14,11">
                        <TextBlock Text="{DynamicResource Section.Groups}"
                                   FontFamily="{StaticResource HeaderFont}"
                                   FontSize="20" FontWeight="SemiBold" Foreground="#c9a84c"/>
                    </Border>

                    <!-- Grupy -->
                    <Border Grid.Row="1" Background="#161b25" BorderBrush="#2a3347"
                            BorderThickness="0,0,1,1" Padding="8,8">
                        <StackPanel>

                            <!-- Wszystkie -->
                            <Button Command="{Binding SelectAllGroupsCommand}"
                                    Cursor="Hand" Margin="0,0,0,2">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            Padding="8,6">
                                                        <TextBlock Text="{DynamicResource Section.AllSets}"
                                                                   FontFamily="{StaticResource BodyFont}"
                                                                   FontSize="18" FontWeight="SemiBold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#959fb9"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding SelectedGroup}" Value="{x:Null}">
                                                                            <Setter Property="Foreground" Value="#c9a84c"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#1e2535"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- Lista grup -->
                            <ItemsControl ItemsSource="{Binding Groups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.SelectGroupCommand,
                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Cursor="Hand" Margin="0,0,0,2">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}"
                                                                        Padding="8,6">
                                                                    <TextBlock Text="{Binding}"
                                                                               FontFamily="{StaticResource HeaderFont}"
                                                                               FontSize="20" FontWeight="Regular">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Foreground" Value="#959fb9"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Value="True">
                                                                                        <DataTrigger.Binding>
                                                                                            <MultiBinding Converter="{StaticResource IsEqual}">
                                                                                                <Binding Path="DataContext.SelectedGroup"
                                                                                                         RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                                                                                <Binding/>
                                                                                            </MultiBinding>
                                                                                        </DataTrigger.Binding>
                                                                                        <Setter Property="Foreground" Value="#c9a84c"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="#1e2535"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            
                            <!-- Separator -->
                            <Border BorderBrush="#2a3347" BorderThickness="0,1,0,0" Margin="0,0,0,8"/>

                            <!-- Dodaj nową grupę -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="36"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <TextBox Text="{Binding NewGroupName, UpdateSourceTrigger=PropertyChanged}"
                                             Background="#0f1117" Foreground="#e8eaf0" CaretBrush="#e8eaf0"
                                             BorderBrush="#2a3347" BorderThickness="1"
                                             FontSize="16" Padding="6"
                                             Height="34">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Return" Command="{Binding AddGroupCommand}"/>
                                        </TextBox.InputBindings>
                                    </TextBox>
                                    <TextBlock Text="{DynamicResource Groups.AddNew}"
                                               Foreground="#555d70" FontSize="16"
                                               Padding="8,6" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding NewGroupName}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <Button Grid.Column="2"
                                        Content="+"
                                        Background="#c9a84c" BorderThickness="0"
                                        Foreground="#0f1117" FontSize="20" FontWeight="Bold"
                                        Width="36" Height="34"
                                        Command="{Binding AddGroupCommand }"
                                        Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}">
                                                <TextBlock Text="+" FontSize="20" FontWeight="Bold"
                                                           Foreground="#0f1117"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#e0bc6a"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Lista zestawów -->
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#161b25" BorderBrush="#2a3347"
                                BorderThickness="0,0,1,1" Padding="14,8">
                            <TextBlock Text="{DynamicResource Section.AllSets}"
                                       FontFamily="{StaticResource HeaderFont}"
                                       FontSize="20" FontWeight="Light" Foreground="#c9a84c"/>
                        </Border>
                        <Border Grid.Row="1" BorderBrush="#2a3347" BorderThickness="0,0,1,0">
                        <ListBox ItemsSource="{Binding FilteredSetlists}"
                                 SelectedItem="{Binding SelectedSetlist}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ItemContainerStyle="{StaticResource DarkListItem}">
                            <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid VerticalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="11,0,8,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="20" Foreground="#e8eaf0"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                                    <TextBlock Text="{Binding Group}"
                                                               FontSize="16" Foreground="#959fb9"
                                                               Margin="0,0,8,0"/>
                                                    <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:dd.MM.yyyy}'}"
                                                               FontSize="12" Foreground="#3a4a65"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="📌"
                                                       FontSize="16" VerticalAlignment="Center"
                                                       Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}"/>
                                            <Button Grid.Column="2"
                                                    Background="Transparent" BorderThickness="0"
                                                    Foreground="#959fb9" FontSize="16"
                                                    Cursor="Hand" VerticalAlignment="Top"
                                                    HorizontalAlignment="Center"
                                                    Margin="0,0,0,10"
                                                    Command="{Binding DataContext.DeleteSetlistCommand,
                                                        RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="Transparent"
                                                                Width="40" Height="40">
                                                            <TextBlock Text="×" FontSize="40"
                                                                       Foreground="{TemplateBinding Foreground}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Foreground" Value="#d44a4a"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                        </ListBox>
                        </Border>
                    </Grid>
                </Grid>

                <!-- PRAWA: zawartość zestawu -->
                <Grid Grid.Row="1" Grid.Column="1">

                    <!-- Placeholder -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSetlistSelected}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="☑" FontSize="48" Foreground="#2a3347"
                                   HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock Text="{DynamicResource Msg.SelectSetlist}"
                                   Foreground="#959fb9" FontSize="14"
                                   FontFamily="{StaticResource HeaderFont}"/>
                    </StackPanel>

                    <!-- Zawartość zestawu -->
                    <Grid Visibility="{Binding IsSetlistSelected, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Nagłówek zestawu -->
                        <Border Grid.Row="0" Background="#161b25" BorderBrush="#2a3347"
                                BorderThickness="0,0,0,1" Padding="20,13">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding SelectedSetlist.Name}"
                                               FontSize="16" FontWeight="SemiBold" Foreground="#e8eaf0"/>
                                    <ComboBox ItemsSource="{Binding GroupsWithEmpty}"
                                              SelectedItem="{Binding EditingSetlistGroup}"
                                              Style="{StaticResource DarkCombo}"
                                              Height="28" FontSize="12" Margin="0,4,0,0"
                                              MaxWidth="220" HorizontalAlignment="Left">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock>
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="{Binding}"/>
                                                            <Setter Property="Foreground" Value="#e8eaf0"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding}" Value="">
                                                                    <Setter Property="Text" Value="Wybierz grupę"/>
                                                                    <Setter Property="Foreground" Value="#555d70"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="{DynamicResource Btn.LoadToDisplay}"
                                            Style="{StaticResource GoldBtn}" Padding="12,7" Margin="0,0,8,0"
                                            Command="{Binding LoadForDisplayCommand}"/>
                                    <Button Padding="12,7" Margin="0,0,8,0"
                                            Command="{Binding TogglePinCommand}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource OutlineBtn}">
                                                <Setter Property="Content" Value="{DynamicResource Btn.PinSetlist}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedSetlist.IsPinned}" Value="True">
                                                        <Setter Property="Content" Value="{DynamicResource Btn.UnpinSetlist}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="{DynamicResource Btn.DeleteSetlist}"
                                            Style="{StaticResource RedBtn}" Padding="12,7"
                                            Command="{Binding DeleteSetlistCommand}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Lista pieśni -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Hidden">
                            <ItemsControl ItemsSource="{Binding Items}" Margin="20,12,20,12"
                                          x:Name="SetlistItemsControl"
                                          AllowDrop="True">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#1e2535" BorderBrush="#2a3347"
                                                BorderThickness="1"
                                                Margin="0,0,0,6" Padding="0"
                                                AllowDrop="True"
                                                MouseMove="SetlistEditorItem_MouseMove"
                                                Drop="SetlistEditorItem_Drop">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40"/>
                                                    <ColumnDefinition Width="36"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="36"/>
                                                    <ColumnDefinition Width="36"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Uchwyt drag&drop -->
                                                <TextBlock Grid.Column="0" Text="⠿"
                                                           Foreground="#3a4a65" FontSize="20"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Cursor="SizeAll"/>

                                                <!-- Numer -->
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Position}"
                                                           FontSize="20" Foreground="#959fb9"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Center"/>

                                                <!-- Tytuł -->
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding Song.Title}"
                                                           FontSize="20" Foreground="#e8eaf0"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,12"/>

                                                <!-- Klonuj -->
                                                <Button Grid.Column="3"
                                                        ToolTip="{DynamicResource Btn.Clone}"
                                                        Background="Transparent" BorderThickness="0"
                                                        Foreground="#959fb9" FontSize="20"
                                                        Cursor="Hand" VerticalAlignment="Center"
                                                        HorizontalAlignment="Center"
                                                        Command="{Binding DataContext.CloneItemCommand,
                                                            RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="Transparent" Padding="4">
                                                                <TextBlock Text="⧉" FontSize="20"
                                                                           Foreground="{TemplateBinding Foreground}"
                                                                           HorizontalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Foreground" Value="#c9a84c"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>

                                                <!-- Usuń -->
                                                <Button Grid.Column="4"
                                                        Background="Transparent" BorderThickness="0"
                                                        Foreground="#959fb9" FontSize="20"
                                                        Cursor="Hand" VerticalAlignment="Center"
                                                        HorizontalAlignment="Center"
                                                        Command="{Binding DataContext.RemoveItemCommand,
                                                            RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="Transparent" Padding="4">
                                                                <TextBlock Text="×" FontSize="20"
                                                                           Foreground="{TemplateBinding Foreground}"
                                                                           HorizontalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Foreground" Value="#d44a4a"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Przyciski -->
                        <Border Grid.Row="2" Background="#161b25" BorderBrush="#2a3347"
                                BorderThickness="0,1,0,0" Padding="20,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="{DynamicResource Btn.SaveOrder}"
                                        Style="{StaticResource GoldBtn}" Height="50" FontSize="30"
                                        Command="{Binding SaveItemsCommand}" Padding="0"/>
                                <TextBlock Grid.Column="2"
                                           Text="{DynamicResource Msg.UnsavedChanges}"
                                           Foreground="#c9a84c" FontSize="11"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>


            <!-- USTAWIENIA -->

            <Grid x:Name="PaneTemplate" Visibility="Collapsed" Background="#0f1117">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="450"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEWA: zakładki ustawień -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- tab bar -->
                        <RowDefinition Height="*"/>
                        <!-- treść zakładki -->
                        <RowDefinition Height="Auto"/>
                        <!-- przyciski -->
                    </Grid.RowDefinitions>

                    <!-- Tab bar -->
                    <Border Grid.Row="0" BorderBrush="#2a3347" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="{DynamicResource Settings.Main}"    Style="{StaticResource SettingsTab}"
                             GroupName="SzablonTabs" IsChecked="True" x:Name="TabGlowne"/>
                            <RadioButton Content="{DynamicResource Settings.Screen}"   Style="{StaticResource SettingsTab}"
                             GroupName="SzablonTabs" x:Name="TabEkran"/>
                            <RadioButton Content="{DynamicResource Settings.Font}"     Style="{StaticResource SettingsTab}"
                             GroupName="SzablonTabs" x:Name="TabCzcionka"/>
                            <RadioButton Content="{DynamicResource Settings.Colors}"   Style="{StaticResource SettingsTab}"
                             GroupName="SzablonTabs" x:Name="TabKolory"/>
                            <RadioButton Content="{DynamicResource Settings.Format}"   Style="{StaticResource SettingsTab}"
                             GroupName="SzablonTabs" x:Name="TabPozycja"/>
                            <RadioButton Content="{DynamicResource Settings.Shortcuts}" Style="{StaticResource SettingsTab}"
                             GroupName="SzablonTabs" x:Name="TabSkroty"/>
                            <!-- TabTlo usunięty — tło scalone z Kolory -->
                            <RadioButton x:Name="TabTlo" Visibility="Collapsed" GroupName="SzablonTabs"/>
                        </StackPanel>
                    </Border>

                    <!-- Treść zakładek -->
                    <Grid Grid.Row="1">

                        <!-- ── GŁÓWNE ── -->
                        <StackPanel Margin="20,16,20,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=TabGlowne}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <TextBlock Text="{DynamicResource Settings.Main}"
                                       Foreground="#959fb9" FontSize="16"
                                       FontFamily="{StaticResource HeaderFont}" FontWeight="SemiBold"
                                       Margin="0,0,0,16"/>

                            <CheckBox IsChecked="{Binding LoadLastSetlistOnStartup}"
                                      Style="{StaticResource DarkCheck}">
                                <TextBlock Text="{DynamicResource Settings.LoadLastSetlist}" Foreground="#e8eaf0" FontSize="16" TextWrapping="Wrap"/>
                            </CheckBox>
                            <CheckBox IsChecked="{Binding FontAutoFit}"
                                      Style="{StaticResource DarkCheck}" Margin="0,10,0,0">
                                <TextBlock Text="{DynamicResource Settings.FontAutoFit}" Foreground="#e8eaf0" FontSize="16" TextWrapping="Wrap"/>
                            </CheckBox>
                        </StackPanel>

                        <!-- ── CZCIONKA ── -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Hidden"
                          Padding="20,16,20,0">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=TabCzcionka}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>
                            <StackPanel>

                                <!-- Rozmiar stały -->
                                <TextBlock Text="{Binding FontSizeLabel}" Foreground="#959fb9" FontSize="16"
                                           FontFamily="{StaticResource HeaderFont}" FontWeight="Light"
                                           Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider Grid.Column="0" Style="{StaticResource DarkSlider}"
                                            Minimum="10" Maximum="200" TickFrequency="1"
                                            IsSnapToTickEnabled="True"
                                            Value="{Binding FontSize}" VerticalAlignment="Center"/>
                                    <Border Grid.Column="2" Background="#1e2535" BorderBrush="#2a3347"
                                            BorderThickness="1" Padding="6,4">
                                        <TextBox Text="{Binding FontSize, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:F0}'}"
                                                 Style="{StaticResource DarkTextBox}"
                                                 Background="Transparent" BorderThickness="0"
                                                 Foreground="#c9a84c" FontSize="16" FontWeight="Bold"
                                                 Padding="0" TextAlignment="Center"
                                                 helpers:NumericBox.IsEnabled="True"
                                                 helpers:NumericBox.Min="10"
                                                 helpers:NumericBox.Max="200"
                                                 helpers:NumericBox.Step="1"/>
                                    </Border>
                                </Grid>


                                <!-- Rodzina -->
                                <TextBlock Text="{DynamicResource Settings.FontFamily}" Foreground="#959fb9" FontSize="16"
                               FontFamily="{StaticResource HeaderFont}" FontWeight="Light"
                               Margin="0,0,0,8"/>
                                <ComboBox Style="{StaticResource DarkCombo}"
                                          IsEditable="True"
                                          IsTextSearchEnabled="True"
                                          ItemsSource="{Binding SystemFonts}"
                                          Margin="0,0,0,16">
                                    <ComboBox.Text>
                                        <Binding Path="FontFamily" UpdateSourceTrigger="PropertyChanged"/>
                                    </ComboBox.Text>
                                </ComboBox>

                                <!-- Styl + wyrównanie -->
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{DynamicResource Settings.Bold}" Foreground="#959fb9" FontSize="16"
                                       FontFamily="{StaticResource HeaderFont}" FontWeight="Light"
                                       Margin="0,0,0,10"/>
                                        <CheckBox IsChecked="{Binding FontBold}" Style="{StaticResource DarkCheck}">
                                            <TextBlock Text="{DynamicResource Settings.Bold}" Foreground="#e8eaf0" FontSize="16"/>
                                        </CheckBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{DynamicResource Settings.Alignment}" Foreground="#959fb9" FontSize="16"
                                       FontFamily="{StaticResource HeaderFont}" FontWeight="Light"
                                       Margin="0,0,0,10"/>
                                        <StackPanel Orientation="Horizontal">
                                            <ToggleButton Style="{StaticResource AlignBtn}" Margin="0,0,4,0"
                                              IsChecked="{Binding TextAlign, Converter={StaticResource EnumBool}, ConverterParameter=left}"
                                              Command="{Binding SetTextAlignCommand}" CommandParameter="left"
                                              ToolTip="{DynamicResource Tooltip.ToLeft}">
                                                <TextBlock Text="⬅" FontSize="20" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                                            </ToggleButton>
                                            <ToggleButton Style="{StaticResource AlignBtn}" Margin="0,0,4,0"
                                              IsChecked="{Binding TextAlign, Converter={StaticResource EnumBool}, ConverterParameter=center}"
                                              Command="{Binding SetTextAlignCommand}" CommandParameter="center"
                                              ToolTip="{DynamicResource Settings.AlignCenter}">
                                                <TextBlock Text="☰" FontSize="20" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                                            </ToggleButton>
                                            <ToggleButton Style="{StaticResource AlignBtn}"
                                              IsChecked="{Binding TextAlign, Converter={StaticResource EnumBool}, ConverterParameter=right}"
                                              Command="{Binding SetTextAlignCommand}" CommandParameter="right"
                                              ToolTip="{DynamicResource Tooltip.ToRight}">
                                                <TextBlock Text="➡" FontSize="20" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                                            </ToggleButton>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <!-- Odstęp linii -->
                                <TextBlock Text="{DynamicResource Settings.LineSpacing}" Foreground="#959fb9" FontSize="16"
                                           FontFamily="{StaticResource HeaderFont}" FontWeight="Light"
                                           Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider Grid.Column="0" Style="{StaticResource DarkSlider}"
                                            Minimum="1.3" Maximum="2.5" TickFrequency="0.05"
                                            Value="{Binding LineHeightMultiplier}" VerticalAlignment="Center"/>
                                    <Border Grid.Column="2" Background="#1e2535" BorderBrush="#2a3347"
                                            BorderThickness="1" Padding="6,4">
                                        <TextBox Text="{Binding LineHeightMultiplier, UpdateSourceTrigger=PropertyChanged, StringFormat='×{0:F2}'}"
                                                 Style="{StaticResource DarkTextBox}"
                                                 Background="Transparent" BorderThickness="0"
                                                 Foreground="#9aa3b8" FontSize="16"
                                                 Padding="0" TextAlignment="Center"
                                                 helpers:NumericBox.IsEnabled="True"
                                                 helpers:NumericBox.Min="1.3"
                                                 helpers:NumericBox.Max="2.5"
                                                 helpers:NumericBox.Step="0.05"
                                                 helpers:NumericBox.Decimals="2"/>
                                    </Border>
                                </Grid>

                             <TextBlock Text="{DynamicResource Settings.Alignment}" Foreground="#959fb9" FontSize="16"
                                        FontFamily="{StaticResource HeaderFont}" FontWeight="Light"
                                        Margin="0,16,0,12"/>
                             <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                 <RadioButton Content="{DynamicResource Settings.AlignTop}"   Style="{StaticResource DarkRadio}" Margin="0,0,20,0"
                                              IsChecked="{Binding TextPosition, Converter={StaticResource EnumBool}, ConverterParameter=top}"
                                              Command="{Binding SetTextPositionCommand}" CommandParameter="top"/>
                                 <RadioButton Content="{DynamicResource Settings.AlignMiddle}" Style="{StaticResource DarkRadio}" Margin="0,0,20,0"
                                              IsChecked="{Binding TextPosition, Converter={StaticResource EnumBool}, ConverterParameter=center}"
                                              Command="{Binding SetTextPositionCommand}" CommandParameter="center"/>
                                 <RadioButton Content="{DynamicResource Settings.AlignBottom}"    Style="{StaticResource DarkRadio}"
                                              IsChecked="{Binding TextPosition, Converter={StaticResource EnumBool}, ConverterParameter=bottom}"
                                              Command="{Binding SetTextPositionCommand}" CommandParameter="bottom"/>
                             </StackPanel>
                            <TextBlock Text="{DynamicResource Settings.Margins}" Foreground="#959fb9" FontSize="16"
                                        FontFamily="{StaticResource HeaderFont}" FontWeight="Light"
                                        Margin="0,16,0,12"/>

                            <!-- Margines poziomy -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="{DynamicResource Settings.AlignH}"
                                            Foreground="#959fb9" FontSize="16" Margin="0,0,0,6"/>
                                <Slider Grid.Row="2" Grid.Column="0" Style="{StaticResource DarkSlider}"
                                        Minimum="0" Maximum="300" TickFrequency="5"
                                        IsSnapToTickEnabled="True"
                                        Value="{Binding TextMarginH}" VerticalAlignment="Center"/>
                                <Border Grid.Row="2" Grid.Column="2" Background="#1e2535" BorderBrush="#2a3347"
                                        BorderThickness="1" Padding="6,4">
                                    <TextBox Text="{Binding TextMarginH, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:F0}'}"
                                                Style="{StaticResource DarkTextBox}"
                                                Background="Transparent" BorderThickness="0"
                                                Foreground="#c9a84c" FontSize="13" FontWeight="Bold"
                                                Padding="0" TextAlignment="Center"
                                                helpers:NumericBox.IsEnabled="True"
                                                helpers:NumericBox.Min="0"
                                                helpers:NumericBox.Max="300"
                                                helpers:NumericBox.Step="5"/>
                                </Border>
                            </Grid>

                            <!-- Margines pionowy -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="{DynamicResource Settings.AlignV}"
                                            Foreground="#959fb9" FontSize="16" Margin="0,0,0,6"/>
                                <Slider Grid.Row="2" Grid.Column="0" Style="{StaticResource DarkSlider}"
                                        Minimum="0" Maximum="200" TickFrequency="5"
                                        IsSnapToTickEnabled="True"
                                        Value="{Binding TextMarginV}" VerticalAlignment="Center"/>
                                <Border Grid.Row="2" Grid.Column="2" Background="#1e2535" BorderBrush="#2a3347"
                                        BorderThickness="1" Padding="6,4">
                                    <TextBox Text="{Binding TextMarginV, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:F0}'}"
                                                Style="{StaticResource DarkTextBox}"
                                                Background="Transparent" BorderThickness="0"
                                                Foreground="#c9a84c" FontSize="13" FontWeight="Bold"
                                                Padding="0" TextAlignment="Center"
                                                helpers:NumericBox.IsEnabled="True"
                                                helpers:NumericBox.Min="0"
                                                helpers:NumericBox.Max="200"
                                                helpers:NumericBox.Step="5"/>
                                </Border>
                            </Grid>

                           </StackPanel>
                        </ScrollViewer>

                        <!-- ── KOLORY + TŁO ── -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Hidden"
                                      Padding="20,16,20,0">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=TabKolory}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>
                            <StackPanel>

                            <!-- Kolor tekstu -->
                            <TextBlock Text="{DynamicResource Settings.TextColor}" Foreground="#959fb9" FontSize="16"
                           FontFamily="{StaticResource HeaderFont}" FontWeight="Light"
                           Margin="0,0,0,10"/>
                            <ItemsControl ItemsSource="{Binding TextPresets}" Margin="0,0,0,10">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Width="40" Height="40" Margin="0,0,6,6" ToolTip="{Binding Label, Mode=OneWay}"
                                    Command="{Binding DataContext.SetTextColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding Hex}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{Binding Brush}"
                                                BorderBrush="#2a3347" BorderThickness="2">
                                                        <Border.Effect>
                                                            <DropShadowEffect ShadowDepth="0" BlurRadius="6" Opacity=".3"/>
                                                        </Border.Effect>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Opacity" Value="0.8"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <TextBlock Text="Własny:" Foreground="#959fb9" FontSize="16"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Button Width="32" Height="32" Margin="0,0,10,0" Cursor="Hand"
                                        ToolTip="{DynamicResource Btn.PickColor}" Command="{Binding PickTextColorCommand}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{Binding TextColorSwatch}"
                                                    BorderBrush="#2a3347" BorderThickness="1"/>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <TextBox Text="{Binding TextColor, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource DarkTextBox}" Width="100"
                             FontFamily="Consolas" FontSize="13"/>
                            </StackPanel>

                            <!-- Cień -->
                            <TextBlock Text="{DynamicResource Settings.Shadow}" Foreground="#959fb9" FontSize="16"
                           FontFamily="{StaticResource HeaderFont}" FontWeight="Light"
                           Margin="0,0,0,10"/>
                            <CheckBox IsChecked="{Binding ShadowEnabled}" Style="{StaticResource DarkCheck}"
                          Margin="0,0,0,12">
                                <TextBlock Text="{DynamicResource Settings.ShadowEnable}" Foreground="#e8eaf0" FontSize="16"/>
                            </CheckBox>
                            <Grid IsEnabled="{Binding ShadowEnabled}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="{DynamicResource Settings.ShadowBlur}" Foreground="#959fb9" FontSize="16" Margin="0,0,0,4"/>
                                    <Slider Style="{StaticResource DarkSlider}" Minimum="0" Maximum="30" Value="{Binding ShadowBlur}"/>
                                    <TextBlock Text="{Binding ShadowBlur, StringFormat='{}{0:F0}'}" Foreground="#9aa3b8" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <TextBlock Text="{DynamicResource Settings.ShadowDepth}" Foreground="#959fb9" FontSize="16" Margin="0,0,0,4"/>
                                    <Slider Style="{StaticResource DarkSlider}" Minimum="0" Maximum="15" Value="{Binding ShadowDepth}"/>
                                    <TextBlock Text="{Binding ShadowDepth, StringFormat='{}{0:F0}'}" Foreground="#9aa3b8" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="0">
                                    <TextBlock Text="{DynamicResource Settings.Opacity}" Foreground="#959fb9" FontSize="16" Margin="0,0,0,4"/>
                                    <Slider Style="{StaticResource DarkSlider}" Minimum="0" Maximum="1" Value="{Binding ShadowOpacity}"/>
                                    <TextBlock Text="{Binding ShadowOpacity, StringFormat='{}{0:P0}'}" Foreground="#9aa3b8" FontSize="11"/>
                                </StackPanel>
                            </Grid>
                            <!-- separator -->
                            <Border BorderBrush="#2a3347" BorderThickness="0,1,0,0" Margin="0,16,0,16"/>

                            <TextBlock Text="{DynamicResource Settings.BgColor}" Foreground="#959fb9" FontSize="16"
                           FontFamily="{StaticResource HeaderFont}" FontWeight="Light"
                           Margin="0,0,0,10"/>
                            <ItemsControl ItemsSource="{Binding BgPresets}" Margin="0,0,0,10">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Width="40" Height="40" Margin="0,0,6,6" ToolTip="{Binding Label, Mode=OneWay}"
                                    Command="{Binding DataContext.SetBgColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding Hex}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{Binding Brush}"
                                                BorderBrush="#555" BorderThickness="2"/>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Opacity" Value="0.8"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                                <TextBlock Text="Własny:" Foreground="#959fb9" FontSize="16"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Button Width="32" Height="32" Margin="0,0,10,0" Cursor="Hand"
                                        ToolTip="{DynamicResource Btn.PickColor}" Command="{Binding PickBgColorCommand}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{Binding BgColorSwatch}"
                                                    BorderBrush="#555" BorderThickness="1"/>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <TextBox Text="{Binding BackgroundColor, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource DarkTextBox}" Width="100"
                             FontFamily="Consolas" FontSize="13"/>
                            </StackPanel>

                            <!-- ── GRADIENT ── -->
                            <StackPanel Margin="0,0,0,24">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="{DynamicResource Settings.BgGradient}" Foreground="#959fb9" FontSize="16"
                                           FontFamily="{StaticResource HeaderFont}" FontWeight="Light"
                                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <CheckBox IsChecked="{Binding GradientEnabled}"
                                              Foreground="#e8eaf0" FontSize="16"
                                              VerticalAlignment="Center"
                                              Content="{DynamicResource Btn.Enable}"/>
                                </StackPanel>
                                <StackPanel Visibility="{Binding GradientEnabled, Converter={StaticResource BoolToVis}}">
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{DynamicResource Settings.GradientColor1}" Foreground="#959fb9" FontSize="16" Margin="0,0,0,4"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Width="44" Height="44" Margin="0,0,6,0" Cursor="Hand"
                                                        ToolTip="{DynamicResource Btn.PickColor}" Command="{Binding PickGradientColor1Command}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{Binding GradientColor1Swatch}"
                                                                    BorderBrush="#555" BorderThickness="1"/>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                                <TextBox Text="{Binding GradientColor1, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource DarkTextBox}"
                                                         Width="90" FontFamily="Consolas" FontSize="16"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{DynamicResource Settings.GradientColor2}" Foreground="#959fb9" FontSize="16" Margin="0,0,0,4"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Width="44" Height="44" Margin="0,0,6,0" Cursor="Hand"
                                                        ToolTip="{DynamicResource Btn.PickColor}" Command="{Binding PickGradientColor2Command}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{Binding GradientColor2Swatch}"
                                                                    BorderBrush="#555" BorderThickness="1"/>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                                <TextBox Text="{Binding GradientColor2, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource DarkTextBox}"
                                                         Width="90" FontFamily="Consolas" FontSize="16"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                    <!-- Typ gradientu -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Button Content="{DynamicResource Settings.GradientLinear}" Height="30" Padding="14" Margin="0,0,6,0"
                                                Command="{Binding SetGradientTypeCommand}" CommandParameter="linear" FontSize="16">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="#1e2535"/>
                                                    <Setter Property="Foreground" Value="#959fb9"/>
                                                    <Setter Property="BorderBrush" Value="#2a3347"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}"
                                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                                        CornerRadius="4">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding GradientType}" Value="linear">
                                                            <Setter Property="Background" Value="#c9a84c"/>
                                                            <Setter Property="Foreground" Value="#0f1117"/>
                                                            <Setter Property="BorderBrush" Value="#c9a84c"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="{DynamicResource Settings.GradientRadial}" Height="30" Padding="14,0" FontSize="16"
                                                Command="{Binding SetGradientTypeCommand}" CommandParameter="radial">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="#1e2535"/>
                                                    <Setter Property="Foreground" Value="#959fb9"/>
                                                    <Setter Property="BorderBrush" Value="#2a3347"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}"
                                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                                        CornerRadius="4">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding GradientType}" Value="radial">
                                                            <Setter Property="Background" Value="#c9a84c"/>
                                                            <Setter Property="Foreground" Value="#0f1117"/>
                                                            <Setter Property="BorderBrush" Value="#c9a84c"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                    <!-- Kąt — tylko dla liniowego -->
                                    <StackPanel Visibility="{Binding IsLinearGradient, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{DynamicResource Settings.GradientAngle}" Foreground="#959fb9" FontSize="16" Margin="0,0,0,4"/>
                                        <Slider Style="{StaticResource DarkSlider}" Minimum="0" Maximum="360"
                                                Value="{Binding GradientAngle}" TickFrequency="45"/>
                                        <TextBlock Text="{Binding GradientAngle, StringFormat='{}{0:F0}°'}"
                                                   Foreground="#9aa3b8" FontSize="14" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="{DynamicResource Settings.BgImage}" Foreground="#959fb9" FontSize="16"
                           FontFamily="{StaticResource HeaderFont}" FontWeight="Light"
                           Margin="0,0,0,10"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#1e2535" BorderBrush="#2a3347"
                            BorderThickness="1" Padding="10,8">
                                    <TextBlock TextTrimming="CharacterEllipsis" FontSize="16">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text"       Value="{Binding BackgroundImagePath}"/>
                                                <Setter Property="Foreground" Value="#9aa3b8"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding BackgroundImagePath}" Value="{x:Null}">
                                                        <Setter Property="Text"       Value="{DynamicResource Settings.NoImage}"/>
                                                        <Setter Property="Foreground" Value="#959fb9"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <Button Grid.Column="2" Content="{DynamicResource Btn.Browse}" Style="{StaticResource GoldBtn}"
                            Padding="12,8" Command="{Binding BrowseBackgroundCommand}"/>
                                <Button Grid.Column="4" Content="✕" Style="{StaticResource RedBtn}"
                            Padding="10,8" Command="{Binding ClearBackgroundCommand}"/>
                            </Grid>
                            <StackPanel Visibility="{Binding BackgroundImagePath, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{DynamicResource Settings.BgImageOpacity}" Foreground="#959fb9" FontSize="11" Margin="0,0,0,6"/>
                                <Slider Style="{StaticResource DarkSlider}" Minimum="0" Maximum="1"
                            Value="{Binding BackgroundImageOpacity}"/>
                                <TextBlock Text="{Binding BackgroundImageOpacity, StringFormat='{}{0:P0}'}"
                               Foreground="#9aa3b8" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ── FORMAT ── -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Hidden"
                                      Padding="20,16,20,0">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=TabPozycja}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>
                            <StackPanel>

                                <TextBlock Text="{DynamicResource Settings.Tags}" Foreground="#959fb9" FontSize="16"
                                           FontFamily="{StaticResource HeaderFont}" FontWeight="Light"
                                           Margin="0,0,0,12"/>

                                <!-- Nagłówek kolumn -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="42"/>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="36"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{DynamicResource Settings.TagName}" Foreground="#555f7a" FontSize="13"/>
                                    <TextBlock Grid.Column="1" Text="{DynamicResource Settings.TagColorHeader}" Foreground="#555f7a" FontSize="13"/>
                                    <TextBlock Grid.Column="2" Text="B" Foreground="#555f7a" FontSize="13" TextAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="I" Foreground="#555f7a" FontSize="13" TextAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="U" Foreground="#555f7a" FontSize="13" TextAlignment="Center"/>
                                    <TextBlock Grid.Column="6" Text="Ctrl+" Foreground="#555f7a" FontSize="13"
                                               ToolTip="{DynamicResource Settings.TagShortcutTip}"/>
                                </Grid>

                                <!-- Lista tagów -->
                                <ItemsControl ItemsSource="{Binding TextTags}" Margin="0,0,0,10">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="36"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="30"/>
                                                    <ColumnDefinition Width="30"/>
                                                    <ColumnDefinition Width="30"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="50"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="30"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- Nazwa tagu -->
                                                <TextBox Grid.Column="0"
                                                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource DarkTextBox}"
                                                         FontFamily="Consolas" FontSize="14" Padding="6,4"/>
                                                <!-- Kolor — swatch -->
                                                <Button Grid.Column="2" Width="36" Height="34" Cursor="Hand"
                                                        ToolTip="{DynamicResource Btn.PickColor}"
                                                        Command="{Binding DataContext.PickTagColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border BorderBrush="#555" BorderThickness="1">
                                                                <Border.Background>
                                                                    <SolidColorBrush Color="{Binding Color, Converter={StaticResource HexToColor}, FallbackValue=White}"/>
                                                                </Border.Background>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Opacity" Value="0.8"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                                <!-- Bold -->
                                                <CheckBox Grid.Column="4" IsChecked="{Binding Bold}"
                                                          VerticalAlignment="Center" HorizontalAlignment="Center"
                                                          Foreground="#e8eaf0"/>
                                                <!-- Italic -->
                                                <CheckBox Grid.Column="5" IsChecked="{Binding Italic}"
                                                          VerticalAlignment="Center" HorizontalAlignment="Center"
                                                          Foreground="#e8eaf0"/>
                                                <!-- Underline -->
                                                <CheckBox Grid.Column="6" IsChecked="{Binding Underline}"
                                                          VerticalAlignment="Center" HorizontalAlignment="Center"
                                                          Foreground="#e8eaf0"/>
                                                <!-- Skrót klawiszowy -->
                                                <TextBox Grid.Column="8"
                                                         Text="{Binding ShortcutKey, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource DarkTextBox}"
                                                         FontFamily="Consolas" FontSize="14" Padding="4,4"
                                                         TextAlignment="Center"
                                                         ToolTip="{DynamicResource Settings.TagShortcutInput}"
                                                         helpers:KeyCaptureHelper.IsEnabled="True"/>
                                                <!-- Usuń -->
                                                <Button Grid.Column="10" Content="✕" Width="30" Height="30"
                                                        Style="{StaticResource RedBtn}"
                                                        Command="{Binding DataContext.RemoveTagCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Padding="0" FontSize="14"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Dodaj tag -->
                                <Button Content="{DynamicResource Settings.TagAdd}" Style="{StaticResource GoldBtn}"
                                        Command="{Binding AddTagCommand}"
                                        Height="36" Padding="16,0" HorizontalAlignment="Left"
                                        FontSize="14" Margin="0,0,0,20"/>

                                <!-- Podpowiedź składni -->
                                <Border Background="#1e2535" BorderBrush="#2a3347" BorderThickness="1"
                                        Padding="12,10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Settings.TagsSyntax}" Foreground="#9aa3b8"
                                                   FontFamily="Consolas" FontSize="13" Margin="0,0,0,4"/>
                                        <TextBlock Text="{DynamicResource Settings.TagsBuiltin}"
                                                   Foreground="#9aa3b8" FontFamily="Consolas" FontSize="13"/>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>

                        <!-- ── EKRAN ── -->
                        <StackPanel Margin="20,16,20,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=TabEkran}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <TextBlock Text="{DynamicResource Settings.Screen}" Foreground="#959fb9" FontSize="16"
                           FontFamily="{StaticResource HeaderFont}" FontWeight="SemiBold"
                           Margin="0,0,0,10"/>
                            <TextBlock Text="{DynamicResource Settings.ScreenLabel}"
                           Foreground="#959fb9" FontSize="16" TextWrapping="Wrap" Margin="0,0,0,16"/>
                            <ListBox ItemsSource="{Binding Screens}"
                                     SelectedItem="{Binding SelectedScreen}"
                                     Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,0,0,8"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd" Background="#1e2535" BorderBrush="#2a3347"
                                                            BorderThickness="1" Padding="14,12" Cursor="Hand">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse x:Name="Dot" Width="10" Height="10"
                                                                     Fill="#2a3347" Margin="0,0,10,0"/>
                                                            <ContentPresenter VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#c9a84c"/>
                                                            <Setter TargetName="Dot" Property="Fill" Value="#c9a84c"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label, Mode=OneWay}" Foreground="#e8eaf0" FontSize="16"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Język -->
                            <TextBlock Text="{DynamicResource Settings.Language}"
                                       Foreground="#959fb9" FontSize="16"
                                       FontFamily="{StaticResource HeaderFont}" FontWeight="SemiBold"
                                       Margin="0,20,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="Polski" Style="{StaticResource DarkRadio}" Margin="0,0,16,0"
                                             IsChecked="{Binding SelectedLanguage, Converter={StaticResource EnumBool}, ConverterParameter=pl}"
                                             Command="{Binding SetLanguageCommand}" CommandParameter="pl"/>
                                <RadioButton Content="English" Style="{StaticResource DarkRadio}" Margin="0,0,16,0"
                                             IsChecked="{Binding SelectedLanguage, Converter={StaticResource EnumBool}, ConverterParameter=en}"
                                             Command="{Binding SetLanguageCommand}" CommandParameter="en"/>
                                <RadioButton Content="Español" Style="{StaticResource DarkRadio}"
                                             IsChecked="{Binding SelectedLanguage, Converter={StaticResource EnumBool}, ConverterParameter=es}"
                                             Command="{Binding SetLanguageCommand}" CommandParameter="es"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- ── SKRÓTY ── -->
                        <StackPanel x:Name="PaneShortcutsContent" Margin="20,16,20,16">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=TabSkroty}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <StackPanel.Resources>
                                <Style x:Key="ShortcutLabel" TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#e8eaf0"/>
                                    <Setter Property="FontSize" Value="16"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                                <Style x:Key="ShortcutCapture" TargetType="TextBox"
                                       BasedOn="{StaticResource DarkTextBox}">
                                    <Setter Property="Width" Value="160"/>
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="TextAlignment" Value="Center"/>
                                    <Setter Property="FontSize" Value="15"/>
                                    <Setter Property="Padding" Value="8,6"/>
                                    <Setter Property="helpers:KeyCaptureHelper.IsEnabled" Value="True"/>
                                </Style>
                            </StackPanel.Resources>

                            <!-- Nawigacja -->
                            <TextBlock Text="{DynamicResource Shortcuts.Navigation}" Foreground="#959fb9" FontSize="13"
                                       Margin="0,0,0,10" FontFamily="{StaticResource BodyFont}"/>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="{DynamicResource Shortcuts.SlideNext}" Style="{StaticResource ShortcutLabel}"/>
                                <TextBox Text="{Binding SlideNext, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ShortcutCapture}"/>
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="{DynamicResource Shortcuts.SlidePrev}" Style="{StaticResource ShortcutLabel}"/>
                                <TextBox Text="{Binding SlidePrev, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ShortcutCapture}"/>
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="{DynamicResource Shortcuts.SongNext}" Style="{StaticResource ShortcutLabel}"/>
                                <TextBox Text="{Binding SongNext, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ShortcutCapture}"/>
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="{DynamicResource Shortcuts.SongPrev}" Style="{StaticResource ShortcutLabel}"/>
                                <TextBox Text="{Binding SongPrev, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ShortcutCapture}"/>
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="{DynamicResource Shortcuts.Blank}" Style="{StaticResource ShortcutLabel}"/>
                                <TextBox Text="{Binding Blank, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ShortcutCapture}"/>
                            </Grid>

                            <!-- Zakładki -->
                            <TextBlock Text="{DynamicResource Shortcuts.Tabs}" Foreground="#959fb9" FontSize="13"
                                       Margin="0,16,0,10" FontFamily="{StaticResource BodyFont}"/>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="{DynamicResource Shortcuts.TabShow}" Style="{StaticResource ShortcutLabel}"/>
                                <TextBox Text="{Binding TabShow, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ShortcutCapture}"/>
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="{DynamicResource Shortcuts.TabSongs}" Style="{StaticResource ShortcutLabel}"/>
                                <TextBox Text="{Binding TabSongs, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ShortcutCapture}"/>
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="{DynamicResource Shortcuts.TabSets}" Style="{StaticResource ShortcutLabel}"/>
                                <TextBox Text="{Binding TabSets, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ShortcutCapture}"/>
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="{DynamicResource Shortcuts.TabTemplate}" Style="{StaticResource ShortcutLabel}"/>
                                <TextBox Text="{Binding TabTemplate, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ShortcutCapture}"/>
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="{DynamicResource Shortcuts.TabImport}" Style="{StaticResource ShortcutLabel}"/>
                                <TextBox Text="{Binding TabImport, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ShortcutCapture}"/>
                            </Grid>

                            <!-- Wyszukiwarka -->
                            <TextBlock Text="{DynamicResource Shortcuts.Search}" Foreground="#959fb9" FontSize="13"
                                       Margin="0,16,0,10" FontFamily="{StaticResource BodyFont}"/>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="{DynamicResource Shortcuts.SearchOpen}" Style="{StaticResource ShortcutLabel}"/>
                                <TextBox Text="{Binding SearchOpen, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ShortcutCapture}"/>
                            </Grid>

                            <!-- Przyciski -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                                <Button Content="{DynamicResource Btn.ResetShortcuts}"
                                        Command="{Binding ResetCommand}"
                                        Style="{StaticResource OutlineBtn}"
                                        Height="44" Padding="16,0" Margin="0,0,10,0"/>
                                <Button Content="{DynamicResource Btn.SaveShortcuts}"
                                        Command="{Binding SaveCommand}"
                                        Style="{StaticResource GoldBtn}"
                                        Height="44" Padding="20,0"/>
                            </StackPanel>

                        </StackPanel>

                    </Grid>

                    <!-- Przyciski Zapisz/Reset -->
                    <Border Grid.Row="2" BorderBrush="#2a3347" BorderThickness="0,1,0,0" Padding="5,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="{DynamicResource Btn.SaveSettings}"
                        Style="{StaticResource GoldBtn}" Height="50" FontSize="30"
                        Command="{Binding SaveCommand}" Padding="0"/>
                            <Button Grid.Column="2" Content="{DynamicResource Btn.ResetSettings}"
                        Style="{StaticResource RedBtn}" Height="42" Padding="10,0"
                        Command="{Binding ResetCommand}"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ════════════════════════════════════════════════════════════════
                         PRAWA: podgląd 16:9
                    ════════════════════════════════════════════════════════════════ -->
                <Grid Grid.Column="1" Background="#0a0d14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#161b25" BorderBrush="#2a3347"
                BorderThickness="1,0,0,1" Padding="20,13">
                        <TextBlock Text="{DynamicResource Section.ScreenPreview}" FontFamily="{StaticResource HeaderFont}"
                       FontSize="20" FontWeight="Light" Foreground="#c9a84c"/>
                    </Border>

                    <Viewbox Grid.Row="1" Stretch="Uniform" Margin="32">
                        <Border Width="960" Height="540" ClipToBounds="True">
                            <Grid>
                                <Border Background="{Binding PreviewBackgroundBrush}"/>
                                <Image Source="{Binding BackgroundImagePath}"
                           Stretch="UniformToFill"
                           Opacity="{Binding BackgroundImageOpacity}"/>
                                <Border VerticalAlignment="{Binding PreviewVerticalAlignment}"
                            Padding="{Binding TextMarginH, Converter={StaticResource DoubleToThickness}}">
                                    <TextBlock Text="{Binding PreviewText}"
                                   FontFamily="{Binding PreviewFontFamily}"
                                   FontSize="{Binding PreviewFontSize}"
                                   FontWeight="{Binding PreviewFontWeight}"
                                   Foreground="{Binding PreviewTextBrush}"
                                   TextAlignment="{Binding PreviewTextAlignment}"
                                   LineHeight="{Binding PreviewLineHeight}"
                                   TextWrapping="Wrap">
                                        <TextBlock.Effect>
                                            <DropShadowEffect Color="Black"
                                                  ShadowDepth="{Binding ShadowDepth}"
                                                  BlurRadius="{Binding ShadowBlur}"
                                                  Opacity="{Binding ShadowOpacity}"/>
                                        </TextBlock.Effect>
                                    </TextBlock>
                                </Border>
                            </Grid>
                        </Border>
                    </Viewbox>
                </Grid>

            </Grid>


            <!-- IMPORT -->
            <Grid x:Name="PaneImport" Visibility="Collapsed" Background="#0f1117">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="420"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: opcje importu -->
                <Border Grid.Column="0" BorderBrush="#2a3347" BorderThickness="0,0,1,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Hidden">
                        <StackPanel Margin="28,28,28,28">

                            <!-- Nagłówek -->
                            <TextBlock Text="{DynamicResource Import.Title}"
                           FontFamily="{StaticResource HeaderFont}"
                           FontSize="18" FontWeight="Regular"
                           Foreground="#c9a84c" Margin="0,0,0,4"/>
                            <TextBlock Text="{DynamicResource Import.Title}"
                           Foreground="#959fb9" FontSize="16" Margin="0,0,0,20"/>

                            <!-- Format -->
                            <TextBlock Text="{DynamicResource Settings.Format}"
                                       FontFamily="{StaticResource HeaderFont}"
                                       FontSize="20" FontWeight="Light"
                                       Foreground="#c9a84c" Margin="0,0,0,8"/>
                            <StackPanel Margin="0,0,0,24">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <RadioButton Content="OpenLP (sqlite)"
                                                 IsChecked="{Binding IsOpenLPSqlite, Mode=OneWay}"
                                                 Command="{Binding SelectFormatCommand}"
                                                 CommandParameter="OpenLPSqlite"
                                                 Foreground="#e8eaf0" FontSize="16"
                                                 Margin="0,0,20,0"/>
                                    <RadioButton Content="OpenLP (xml)"
                                                 IsChecked="{Binding IsOpenLPXml, Mode=OneWay}"
                                                 Command="{Binding SelectFormatCommand}"
                                                 CommandParameter="OpenLPXml"
                                                 Foreground="#e8eaf0" FontSize="16"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Content="OpenSong (folder)"
                                                 IsChecked="{Binding IsOpenSongFolder, Mode=OneWay}"
                                                 Command="{Binding SelectFormatCommand}"
                                                 CommandParameter="OpenSongFolder"
                                                 Foreground="#e8eaf0" FontSize="16"
                                                 Margin="0,0,20,0"/>
                                    <RadioButton Content="OpenSong (xml)"
                                                 IsChecked="{Binding IsOpenSongXml, Mode=OneWay}"
                                                 Command="{Binding SelectFormatCommand}"
                                                 CommandParameter="OpenSongXml"
                                                 Foreground="#e8eaf0" FontSize="16"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Plik źródłowy -->
                            <TextBlock Text="{DynamicResource Import.Source}"
                           FontFamily="{StaticResource HeaderFont}"
                           FontSize="20" FontWeight="Light"
                           Foreground="#c9a84c" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#1e2535" BorderBrush="#2a3347"
                            BorderThickness="1,1,0,1" Padding="12,10">
                                    <TextBlock Text="{Binding FilePath}"
                                   Foreground="#e8eaf0" FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding FilePath}" Value="">
                                                        <Setter Property="Text" Value="Nie wybrano pliku..."/>
                                                        <Setter Property="Foreground" Value="#959fb9"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <Button Grid.Column="1" Content="{DynamicResource Btn.Browse}"
                            Style="{StaticResource GoldBtn}"
                            Padding="16,10"
                            Command="{Binding BrowseCommand}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                        BorderBrush="#c9a84c" BorderThickness="1"
                                        Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#e8c97a"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>

                            <!-- Opcje -->
                            <TextBlock Text="{DynamicResource Settings.GradientOptions}"
                           FontFamily="{StaticResource HeaderFont}"
                           FontSize="20" FontWeight="Light"
                           Foreground="#c9a84c" Margin="0,0,0,12"/>

                            <Border Background="#1e2535" BorderBrush="#2a3347" BorderThickness="1"
                        Padding="16,12" Margin="0,0,0,8">
                                <StackPanel>
                                    <CheckBox IsChecked="{Binding ImportCategories}"
                                  Foreground="#e8eaf0" FontSize="16"
                                  Margin="0,0,0,4">
                                        <TextBlock Text="{DynamicResource Import.ImportCategories}" Foreground="#e8eaf0" FontSize="16"/>
                                    </CheckBox>
                                    <TextBlock Text="{DynamicResource Import.ImportCategoriesTip}"
                                   Foreground="#959fb9" FontSize="14" Margin="22,0,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#1e2535" BorderBrush="#2a3347" BorderThickness="1"
                        Padding="16,12" Margin="0,0,0,28">
                                <StackPanel>
                                    <CheckBox IsChecked="{Binding OverwriteExisting}"
                                  Foreground="#e8eaf0" FontSize="16"
                                  Margin="0,0,0,4">
                                        <TextBlock Text="{DynamicResource Import.Overwrite}" Foreground="#e8eaf0" FontSize="16"/>
                                    </CheckBox>
                                    <TextBlock Text="{DynamicResource Import.OverwriteTip}"
                                   Foreground="#959fb9" FontSize="14" Margin="22,0,0,0"/>
                                </StackPanel>
                            </Border>
                            
                            <!-- Sekcja importu zestawów .osz — wkleić do PaneImport.xaml -->
                            <Border Background="#161b25" BorderBrush="#2a3347" BorderThickness="1"
                                    Padding="10" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="ZESTAWY OPENLP (.OSZ)"
                                               FontFamily="{StaticResource HeaderFont}"
                                               FontSize="18" FontWeight="Light"
                                               Foreground="#c9a84c" Margin="0,0,0,14"/>

                                    <!-- Dropdown grupy -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource Groups.Target}"
                                                   Foreground="#8899aa" FontSize="16"
                                                   VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="1"
                                                  Style="{StaticResource DarkCombo}"
                                                  ItemsSource="{Binding OszGroups}"
                                                  SelectedItem="{Binding OszSelectedGroup}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>

                                    <!-- Przycisk -->
                                    <Button Content="{DynamicResource Btn.ImportOsz}"
                                            Style="{StaticResource GoldBtn}"
                                            Height="50" FontSize="20"
                                            Command="{Binding ImportOszCommand}"/>

                                    <!-- Status -->
                                    <TextBlock Text="{Binding OszStatus}"
                                               Foreground="#8899aa" FontSize="16"
                                               Margin="0,10,0,0" TextWrapping="Wrap"
                                               Visibility="{Binding OszStatus, 
                                                   Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </Border>


                            <!-- Przyciski -->
                            <Button Content="{DynamicResource Btn.Preview}"
                        Style="{StaticResource OutlineBtn}"
                        Height="40" Margin="0,0,0,10"
                        Command="{Binding PreviewCommand}"/>

                            <Button Content="{DynamicResource Btn.Import}"
                        Height="50" FontSize="30" Padding="0"
                        Command="{Binding ImportCommand}"
                        IsEnabled="{Binding IsImporting, Converter={StaticResource BoolToVis}}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource GoldBtn}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsImporting}" Value="True">
                                                <Setter Property="Background" Value="#3a4a65"/>
                                                <Setter Property="Foreground" Value="#959fb9"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- Pasek postępu -->
                            <Border Margin="0,16,0,0"
                        Visibility="{Binding IsImporting, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding ProgressText}"
                                   Foreground="#9aa3b8" FontSize="11"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,0,6"/>
                                    <ProgressBar Value="{Binding ProgressValue}"
                                     Maximum="{Binding ProgressMax}"
                                     Height="6"
                                     Background="#1e2535"
                                     Foreground="#c9a84c"
                                     BorderThickness="0"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- RIGHT: log -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#161b25" BorderBrush="#2a3347"
                BorderThickness="0,0,0,1" Padding="20,13">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource Import.Log}"
                           FontFamily="{StaticResource HeaderFont}"
                           FontSize="20" FontWeight="Light"
                           Foreground="#c9a84c" Margin="0,0,16,0"/>
                            <TextBlock Text="{Binding LogEntries.Count, StringFormat='({0} wpisów)'}"
                           Foreground="#959fb9" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Hidden"
                      Padding="20,12">
                        <ItemsControl ItemsSource="{Binding LogEntries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="18"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Icon}"
                                       Foreground="{Binding Color}" FontSize="12"
                                       VerticalAlignment="Top"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Message}"
                                       Foreground="{Binding Color}" FontSize="12"
                                       TextWrapping="Wrap" LineHeight="18"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>