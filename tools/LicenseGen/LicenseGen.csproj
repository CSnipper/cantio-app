<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Cantio.LicenseGen</RootNamespace>
    <AssemblyName>LicenseGen</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <!-- Format klucza (treść + base32) bierzemy z rdzenia, a nie z kopii tutaj: dwie
       niezależne implementacje rozjechałyby się przy pierwszej zmianie, a wyszłoby to
       dopiero u użytkownika, któremu klucz nagle przestałby przechodzić. -->
  <ItemGroup>
    <ProjectReference Include="..\..\Cantio.Core\Cantio.Core.csproj" />
  </ItemGroup>

</Project>
