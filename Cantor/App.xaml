<Application x:Class="Cantor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Cantor"
             xmlns:helpers="clr-namespace:Cantor.Helpers">
    <Application.Resources>
        <helpers:DoubleToThicknessConverter x:Key="DoubleToThickness"/>
        <helpers:BoolToVisibilityConverter  x:Key="BoolToVis"/>
        <helpers:EnumToBoolConverter        x:Key="EnumBool"/>
        <helpers:IsEqualConverter x:Key="IsEqual"/>

        <FontFamily x:Key="CinzelFont">pack://application:,,,/Assets/Fonts/#Cinzel</FontFamily>

        <!-- Slim scrollbar globalnie -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="4"/>
            <Setter Property="MinWidth" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Track Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Opacity="0" IsEnabled="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Opacity="0" IsEnabled="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Rectangle Fill="#3a4a65" RadiusX="2" RadiusY="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>